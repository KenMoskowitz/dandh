---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const title = "Gas Furnace Installation & Repair in Tucson | D&H Air Conditioning";
const description = "Gas furnace installation and repair in Tucson, AZ. Daikin DM96HS 96% AFUE two-stage furnaces. Expert service from D&H's NATE-certified technicians. Call (520) 408-2665.";
const canonical = "https://dandhac.com/products/gas-furnaces/";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dandhac.com/" },
    { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://dandhac.com/products/" },
    { "@type": "ListItem", "position": 3, "name": "Gas Furnaces", "item": canonical }
  ]
};

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Daikin DM96HS Gas Furnace",
  "brand": { "@type": "Brand", "name": "Daikin" },
  "description": "Daikin DM96HS two-stage, multi-speed gas furnace with 96% AFUE efficiency, stainless steel heat exchanger, and silicon nitride igniter.",
  "offers": {
    "@type": "Offer",
    "seller": { "@type": "HVACBusiness", "name": "D&H Air Conditioning & Heating & Plumbing", "telephone": "(520) 408-2665" },
    "areaServed": { "@type": "City", "name": "Tucson", "addressRegion": "AZ" }
  }
};

const whenItMakesSense = [
  {
    title: "Colder elevations",
    description: "Tucson-area communities above 2,500 feet — Catalina, SaddleBrooke, Catalina Foothills — see winter temperatures that make a gas furnace's fast, powerful heat generation particularly valuable."
  },
  {
    title: "Homes with existing gas service",
    description: "If you already have a gas line, a gas furnace is often the most cost-effective heating solution. Natural gas is typically cheaper per BTU than electricity in Arizona, making operating costs favorable."
  },
  {
    title: "Paired with central AC",
    description: "The classic combination: a central AC system for summer and a gas furnace for winter. Our split-system installations pair Daikin AC with the DM96HS furnace using a shared air handler for whole-home coverage."
  },
  {
    title: "Supplemental heat in colder years",
    description: "Some homeowners choose a heat pump paired with a gas furnace as a dual-fuel system — the heat pump handles mild winter days efficiently, while the furnace kicks in on the coldest nights when gas heating is more economical."
  },
];

const faqItems = [
  {
    question: "Do Tucson homes really need a gas furnace?",
    answer: "It depends on the home. Central Tucson rarely sees temperatures cold enough to stress even an older heating system. But Tucson winters are colder than most newcomers expect — freezing temperatures occur most years, and homes at higher elevations (Catalina, SaddleBrooke, Catalina Foothills) can see extended cold snaps in the 20s. For those areas, a properly sized gas furnace provides reliable, fast warmth that a heat pump alone may not match on the coldest nights."
  },
  {
    question: "What is AFUE and why does 96% matter?",
    answer: "AFUE stands for Annual Fuel Utilization Efficiency — it measures how much of the gas you burn is converted to usable heat. A 96% AFUE furnace like the Daikin DM96HS converts 96 cents of every dollar of gas into heat; only 4 cents escapes through the flue. An older 80% AFUE furnace wastes 20 cents of every dollar. The efficiency difference directly translates to lower gas bills every month the furnace runs."
  },
  {
    question: "What is a two-stage furnace and why is it better?",
    answer: "A single-stage furnace runs at 100% capacity every time it turns on — like a light switch. A two-stage furnace (like the Daikin DM96HS) runs at lower output most of the time (first stage), only stepping up to full power on the coldest days. First-stage operation is quieter, more efficient, and creates less temperature swing. Your home stays more consistently comfortable, and the furnace runs longer cycles at lower capacity — which is better for both comfort and longevity."
  },
  {
    question: "How long does a gas furnace installation take?",
    answer: "A furnace replacement on an existing system is typically a one-day job. Our crew removes the old unit, installs the new furnace, connects it to existing ductwork and gas lines, and verifies full operation before leaving. For new construction or first-time installations requiring new ductwork, timing varies. Call (520) 408-2665 for a specific timeline estimate for your project."
  }
];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={[breadcrumbSchema, productSchema]}>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-[var(--color-navy)] to-[var(--color-navy-dark)] hero-pattern py-16 md:py-24 relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-1.5 text-xs text-blue-400 mb-6">
        <a href="/" class="hover:text-blue-200 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/products/" class="hover:text-blue-200 transition-colors">Products</a>
        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-blue-100">Gas Furnaces</span>
      </nav>
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 bg-blue-800/50 text-blue-200 text-xs font-semibold px-3 py-1.5 rounded-full mb-5">
          Daikin Comfort Pro Dealer · 96% AFUE Available
        </div>
        <h1 class="font-display font-extrabold text-4xl md:text-5xl text-white leading-tight mb-5">
          Gas Furnaces for Tucson Homes —<br class="hidden md:block" /> Reliable Heat When You Need It
        </h1>
        <p class="text-blue-200 text-lg md:text-xl leading-relaxed mb-8">
          Tucson winters are milder than most — but they're colder than people expect. When the temperature drops, a properly sized gas furnace delivers fast, powerful heat that keeps your family comfortable all season.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-base px-6 py-4 rounded-xl transition-colors shadow-lg cta-pulse">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
            Get a Free Estimate
          </a>
          <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white hover:bg-white hover:text-[var(--color-navy)] font-bold text-base px-6 py-4 rounded-xl transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call (520) 408-2665
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- When It Makes Sense -->
  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-display font-extrabold text-3xl text-[var(--color-charcoal)] mb-3">When a gas furnace makes sense in Tucson</h2>
        <p class="text-[var(--color-muted)] max-w-2xl mx-auto">While Tucson's winters are short, they're not trivial — especially at higher elevations or in homes that need fast, powerful heat when temperatures drop.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-5">
        {whenItMakesSense.map(item => (
          <div class="bg-[var(--color-cloud)] rounded-2xl p-6 border border-[var(--color-border)]">
            <h3 class="font-display font-bold text-[var(--color-charcoal)] text-lg mb-2">{item.title}</h3>
            <p class="text-[var(--color-muted)] text-sm leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Daikin DM96HS Spotlight -->
  <section class="py-16 bg-[var(--color-cloud)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-[var(--color-navy)] rounded-3xl p-8 md:p-12 text-white">
        <div class="grid md:grid-cols-2 gap-10 items-start">
          <div>
            <div class="inline-flex items-center gap-2 bg-white/10 text-blue-200 text-xs font-semibold px-3 py-1.5 rounded-full mb-4">
              D&H's Recommended Furnace
            </div>
            <h2 class="font-display font-extrabold text-3xl mb-4">Daikin DM96HS</h2>
            <p class="text-blue-200 leading-relaxed mb-4">
              The DM96HS is Daikin's two-stage, multi-speed gas furnace — the system D&H most often recommends for Tucson-area homes that need reliable winter heating. At 96% AFUE, it converts nearly all the natural gas it consumes into usable heat, making it one of the most efficient furnaces available.
            </p>
            <p class="text-blue-200 leading-relaxed">
              The two-stage operation means the DM96HS runs quietly at reduced capacity most of the time, only stepping up to full power on the coldest days. This produces more even temperatures, lower noise levels, and longer equipment life than a single-stage furnace.
            </p>
          </div>
          <div>
            <h3 class="font-display font-bold text-xl mb-5">DM96HS key features</h3>
            <ul class="space-y-4">
              {[
                { feature: "96% AFUE efficiency", detail: "One of the highest-efficiency gas furnaces on the market — converts 96% of fuel to heat" },
                { feature: "Two-stage operation", detail: "Runs at lower capacity most of the time for quiet, even comfort; full power available when needed" },
                { feature: "Multi-speed blower", detail: "Variable airflow delivers balanced comfort to every room without hot and cold spots" },
                { feature: "Stainless steel heat exchanger", detail: "Resists corrosion and cracking — the most durable heat exchanger material available" },
                { feature: "Silicon nitride igniter", detail: "More reliable and longer-lasting than older hot-surface igniters; resists thermal shock" },
                { feature: "Self-diagnostic control board", detail: "Built-in diagnostics that flag fault codes to help technicians identify issues faster" },
              ].map(item => (
                <li class="border-b border-blue-800 pb-3 last:border-0 last:pb-0">
                  <p class="font-semibold text-white text-sm">{item.feature}</p>
                  <p class="text-blue-300 text-xs mt-1 leading-relaxed">{item.detail}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <TrustBadges />

  <!-- FAQ -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-extrabold text-3xl text-[var(--color-charcoal)] mb-8 text-center">Gas Furnace FAQs</h2>
      <FAQAccordion items={faqItems} id="faq-gas-furnaces" />
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-[var(--color-orange)] py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-extrabold text-3xl text-white mb-4">Talk to D&H about your heating options</h2>
      <p class="text-orange-100 mb-7">Not sure if a gas furnace, heat pump, or dual-fuel system is right for your home? We'll walk you through the options — honestly, clearly, and with no pressure. Call (520) 408-2665.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 bg-white text-[var(--color-orange)] hover:bg-orange-50 font-bold text-lg px-8 py-4 rounded-xl transition-colors shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          (520) 408-2665
        </a>
        <a href="/contact" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white hover:bg-white hover:text-[var(--color-orange)] font-bold text-lg px-8 py-4 rounded-xl transition-colors">
          Get a Free Estimate Online
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
