  <div class="border-t border-blue-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-blue-300">
      <p>© {year} D&amp;H Air Conditioning & Heating & Plumbing. All rights reserved. Family-owned since 1959.</p>
      <div class="flex gap-4">
        <a href="/contact" class="hover:text-white transition-colors">Terms &amp; Conditions</a>
        <a href="/contact" class="hover:text-white transition-colors">Privacy Policy</a>
        <!-- PLACEHOLDER: Add BBB seal image when available -->
      </div>
    </div>
  </div>

  <!-- Bottom padding for mobile sticky bar -->
  <div class="h-16 md:h-0"></div>
</footer>
