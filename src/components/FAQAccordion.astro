---
interface FAQItem {
  question: string;
  answer: string;
}
interface Props {
  items: FAQItem[];
  id?: string;
}
const { items, id = 'faq' } = Astro.props;
---

<div class="space-y-2.5" id={id}>
  {items.map((item) => (
    <div
      x-data="{ open: false }"
      class="border-2 rounded-xl overflow-hidden bg-white transition-all duration-200"
      :class="open ? 'border-[var(--color-sky)] shadow-md shadow-sky-100/40' : 'border-[var(--color-border)] hover:border-sky-200'"
    >
      <button
        @click="open = !open"
        class="w-full flex items-center justify-between gap-4 px-5 py-4 text-left group"
        :aria-expanded="open"
      >
        <span
          class="font-display font-semibold text-[var(--color-charcoal)] group-hover:text-[var(--color-navy)] text-base leading-snug transition-colors"
          :class="open ? 'text-[var(--color-navy)]' : ''"
        >
          {item.question}
        </span>
        <span
          class="shrink-0 w-7 h-7 rounded-full flex items-center justify-center transition-all duration-200"
          :class="open ? 'bg-[var(--color-sky)] text-white' : 'bg-[var(--color-cloud)] text-[var(--color-muted)]'"
        >
          <svg
            :class="open ? 'rotate-45' : ''"
            class="transition-transform duration-200"
            xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
          >
            <path d="M5 12h14"/><path d="M12 5v14"/>
          </svg>
        </span>
      </button>
      <div
        x-show="open"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 -translate-y-1"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        style="display:none"
      >
        <div class="px-5 pb-5 border-t border-[var(--color-border)]">
          <p class="text-[var(--color-muted)] leading-relaxed pt-4 text-sm">{item.answer}</p>
        </div>
      </div>
    </div>
  ))}
</div>
