---
interface Props {
  city: string;
  href: string;
  distance?: string;
}
const { city, href, distance } = Astro.props;
---

<a
  href={href}
  class="group flex items-center justify-between gap-2 bg-white hover:bg-[var(--color-navy)] border-2 border-[var(--color-border)] hover:border-[var(--color-navy)] rounded-xl px-4 py-3.5 transition-all duration-200 card-lift"
>
  <div class="flex items-center gap-2.5">
    <svg class="text-[var(--color-sky)] group-hover:text-blue-300 transition-colors shrink-0" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
    <span class="font-semibold text-sm text-[var(--color-charcoal)] group-hover:text-white transition-colors">{city}</span>
  </div>
  <div class="flex items-center gap-2">
    {distance && <span class="text-xs text-[var(--color-muted)] group-hover:text-blue-300 transition-colors font-medium">{distance}</span>}
    <svg class="text-[var(--color-border)] group-hover:text-blue-400 transition-colors" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
  </div>
</a>
