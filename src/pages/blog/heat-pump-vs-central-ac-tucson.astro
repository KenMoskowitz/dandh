---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustBadges from '../../components/TrustBadges.astro';

const title = "Heat Pump vs. Central AC in Tucson: Which Is Right for You? | D&H";
const description = "Heat pump or traditional central AC? An honest comparison for Tucson's desert climate — efficiency, cost, and which system makes sense for your home.";
const canonical = "https://dandhac.com/blog/heat-pump-vs-central-ac-tucson";
const publishDate = "February 10, 2025";
const readTime = "7 min read";
const category = "Buying Guide";

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Heat Pump vs. Central AC in Tucson: Which Is Right for You?",
  "author": { "@type": "Organization", "name": "D&H Air Conditioning & Heating & Plumbing" },
  "publisher": { "@type": "Organization", "name": "D&H Air Conditioning", "url": "https://dandhac.com" },
  "datePublished": "2025-02-10",
  "mainEntityOfPage": canonical
};
---

<BaseLayout title={title} description={description} canonical={canonical} schema={articleSchema}>

  <section class="bg-gradient-to-br from-[var(--color-navy)] to-[var(--color-navy-dark)] hero-pattern relative overflow-hidden">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-20 relative">
      <nav class="flex items-center gap-1.5 text-xs text-blue-400 mb-6">
        <a href="/" class="hover:text-blue-200 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/blog" class="hover:text-blue-200 transition-colors">Blog</a>
        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-blue-200">Buying Guide</span>
      </nav>
      <div class="flex items-center gap-3 mb-5">
        <span class="bg-blue-500/20 text-blue-300 text-xs font-bold px-3 py-1 rounded-full">{category}</span>
        <span class="text-blue-300 text-xs">{publishDate}</span>
        <span class="text-blue-400 text-xs">· {readTime}</span>
      </div>
      <h1 class="font-display font-extrabold text-3xl md:text-4xl lg:text-5xl text-white leading-[1.1] mb-5">
        Heat Pump vs. Central AC in Tucson: An Honest Comparison
      </h1>
      <p class="text-blue-200 text-lg leading-relaxed">
        We install both — so we have no reason to steer you wrong. Here's a straight comparison for the Sonoran Desert climate.
      </p>
    </div>
  </section>

  <article class="py-14 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

      <p class="text-lg leading-relaxed text-[var(--color-muted)] mb-10">
        The short answer: both work great in Tucson. But they work differently, cost differently, and make sense for different homes. Let's break it down honestly.
      </p>

      <!-- Comparison table -->
      <div class="overflow-hidden rounded-2xl border border-[var(--color-border)] shadow-sm mb-12">
        <div class="grid grid-cols-3 bg-[var(--color-navy)] text-white text-sm font-bold">
          <div class="p-4">Factor</div>
          <div class="p-4 border-l border-blue-800 text-center">Central AC</div>
          <div class="p-4 border-l border-blue-800 text-center text-orange-300">Heat Pump</div>
        </div>
        {[
          ['Cooling efficiency', 'SEER up to ~21', 'SEER up to 26+'],
          ['Heating', 'Separate furnace needed', 'Included — one system'],
          ['Installation cost', 'Lower (cooling only)', 'Higher (replaces both)'],
          ['Operating cost', 'Standard', '25–40% less for heating'],
          ['IRA tax credit', 'Up to $600', 'Up to $2,000'],
          ['Best for', 'Homes with existing gas heat', 'Homes replacing both systems'],
        ].map(([factor, central, hp], i) => (
          <div class={`grid grid-cols-3 border-b border-[var(--color-border)] text-sm ${i % 2 === 0 ? 'bg-white' : 'bg-[var(--color-cloud)]'}`}>
            <div class="p-4 font-semibold text-[var(--color-charcoal)]">{factor}</div>
            <div class="p-4 border-l border-[var(--color-border)] text-center text-[var(--color-muted)]">{central}</div>
            <div class="p-4 border-l border-[var(--color-border)] text-center font-semibold text-[var(--color-navy)]">{hp}</div>
          </div>
        ))}
      </div>

      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mt-10 mb-4">Why heat pumps are gaining ground in Tucson</h2>
      <p class="text-[var(--color-muted)] leading-relaxed mb-5">
        Modern heat pumps have dramatically improved. Today's models operate efficiently in temperatures well below freezing — which is far colder than anything Tucson sees. They're essentially reversible air conditioners: in summer they pump heat out of your home; in winter they extract heat from outside air and bring it in.
      </p>
      <p class="text-[var(--color-muted)] leading-relaxed mb-5">
        For Tucson specifically, the math often favors heat pumps because our winters are mild. The heating cycle rarely operates in conditions where efficiency drops off, and you're replacing both your AC and your furnace with a single, well-maintained system.
      </p>
      <p class="text-[var(--color-muted)] leading-relaxed mb-8">
        Add the IRA tax credit (up to $2,000 for qualifying heat pumps vs. $600 for AC), and the economics often tip toward the heat pump for homeowners replacing aging systems.
      </p>

      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mt-10 mb-4">When central AC still makes sense</h2>
      <p class="text-[var(--color-muted)] leading-relaxed mb-5">
        If you have a newer, efficient gas furnace and you're only replacing the cooling system, there's no reason to pull out the furnace. A high-efficiency central AC with your existing furnace may be the more economical choice. Central AC also has lower installation costs and longer field history in extreme desert heat.
      </p>

      <div class="bg-[var(--color-cloud)] border border-[var(--color-border)] rounded-2xl p-6 my-10">
        <h3 class="font-display font-bold text-lg text-[var(--color-charcoal)] mb-3">Our honest recommendation</h3>
        <p class="text-[var(--color-muted)] text-sm leading-relaxed">
          There's no universal right answer. If you're replacing both heating and cooling at the same time, a heat pump usually wins on lifetime cost in Tucson's climate. If you're cooling-only and already have efficient gas heat, central AC is often simpler and cheaper to install. We'll help you run the numbers for your specific home — free, no pressure.
        </p>
        <a href="/contact" class="inline-flex items-center gap-2 mt-4 text-[var(--color-navy)] font-bold text-sm hover:text-[var(--color-orange)] transition-colors">
          Get a free system consultation →
        </a>
      </div>

    </div>
  </article>

  <TrustBadges />

  <section class="bg-[var(--color-navy)] py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-extrabold text-3xl text-white mb-4">Not sure which system is right for your home?</h2>
      <p class="text-blue-200 text-lg mb-8">We'll walk you through the options — honestly, without upselling.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-lg px-8 py-4 rounded-xl transition-colors shadow-lg">
          Get a Free Estimate
        </a>
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white hover:bg-white hover:text-[var(--color-navy)] font-bold text-lg px-8 py-4 rounded-xl transition-colors">
          (520) 408-2665
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
