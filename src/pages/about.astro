---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBadges from '../components/TrustBadges.astro';

const title = "About D&H Air Conditioning — Tucson's HVAC Family Since 1959";
const description = "D&H Air Conditioning has been Tucson's most trusted HVAC company for 65+ years — three generations of honest work, fair prices, and community commitment since 1959.";
const canonical = "https://dandhac.com/about";

const schema = {
  "@context": "https://schema.org",
  "@type": "HVACBusiness",
  "name": "D&H Air Conditioning & Heating & Plumbing",
  "url": "https://dandhac.com",
  "telephone": "(520) 408-2665",
  "foundingDate": "1959",
  "founder": [
    { "@type": "Person", "name": "Arthur Duhamel" },
    { "@type": "Person", "name": "Harry Hawk" }
  ],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "3990 S Evans Blvd",
    "addressLocality": "Tucson",
    "addressRegion": "AZ",
    "postalCode": "85714",
    "addressCountry": "US"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "reviewCount": "4000"
  }
};

const timeline = [
  { year: "1959", event: "D&H founded by Arthur Duhamel & Harry Hawk in Tucson, AZ. Two men, two trucks, one commitment to doing it right." },
  { year: "1970s", event: "Company expands service area across greater Tucson as the city grows and demand for reliable cooling climbs every summer." },
  { year: "1980s", event: "D&H technicians earn their first NATE certifications — setting a standard for technical excellence years ahead of the competition." },
  { year: "1990s", event: "New headquarters established at 3990 S Evans Blvd, Tucson — our home base for three decades and counting." },
  { year: "2000s", event: "Pearl Certification partnership formed, establishing D&H as a leader in energy-efficient home comfort solutions." },
  { year: "2010s", event: "Second location opens at 7070 N Oracle Rd, expanding our reach to serve all of Tucson's growing north side." },
  { year: "2024", event: "Angi Super Service Award earned. Over 4,000 Google reviews averaging 4.8 stars — the voice of Tucson speaking for itself." },
];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema}>

  <!-- ======= HERO ======= -->
  <section class="bg-[var(--color-cloud)] py-20 md:py-28">
    <div class="container mx-auto px-4 text-center">
      <div class="inline-block bg-[var(--color-navy)] text-white text-sm font-bold px-4 py-2 rounded-full mb-6">
        Family-Owned Since 1959
      </div>
      <h1 class="font-display font-800 text-4xl md:text-5xl lg:text-6xl text-[var(--color-charcoal)] mb-6 leading-tight max-w-4xl mx-auto">
        The Family That's Kept<br class="hidden md:block" />
        <span class="text-[var(--color-navy)]">Tucson Cool Since 1959</span>
      </h1>
      <p class="text-[var(--color-muted)] text-lg md:text-xl max-w-2xl mx-auto leading-relaxed">
        From a two-man operation in 1959 to Tucson's most trusted HVAC company — three generations of commitment to honest work and the people of this city.
      </p>
    </div>
  </section>

  <!-- ======= FOUNDING STORY ======= -->
  <section class="bg-white py-16 md:py-24">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="grid md:grid-cols-2 gap-12 items-center mb-16">
          <div>
            <h2 class="font-display font-800 text-2xl md:text-3xl text-[var(--color-charcoal)] mb-6">
              How It All Started
            </h2>
            <p class="text-[var(--color-muted)] text-base leading-relaxed mb-4">
              In January 1959, Arthur Duhamel and Harry Hawk started an air conditioning company in Tucson, Arizona. They took the first letters of their last names — D and H — and built something that would outlast them both.
            </p>
            <p class="text-[var(--color-muted)] text-base leading-relaxed mb-4">
              Back then, Tucson was a different city. Air conditioning wasn't universal. But Arthur and Harry believed that every family in the Sonoran Desert deserved to be cool and comfortable — and they made it their life's work to deliver that.
            </p>
            <p class="text-[var(--color-muted)] text-base leading-relaxed">
              They charged fair prices. They stood behind their work. They answered the phone. Those weren't marketing slogans — they were just how you ran a business if you had any self-respect. That foundation is still intact today.
            </p>
          </div>
          <div class="rounded-2xl overflow-hidden bg-[var(--color-cloud)] aspect-[4/3] flex items-center justify-center">
            <!-- PLACEHOLDER: Insert founder photo of Arthur Duhamel and Harry Hawk, circa 1959 -->
            <div class="text-center p-8">
              <div class="w-16 h-16 rounded-full bg-[var(--color-border)] mx-auto mb-4 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--color-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              </div>
              <p class="text-[var(--color-muted)] text-sm">Founder photo — Arthur Duhamel &amp; Harry Hawk, 1959</p>
            </div>
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div class="order-2 md:order-1 rounded-2xl overflow-hidden bg-[var(--color-cloud)] aspect-[4/3] flex items-center justify-center">
            <!-- PLACEHOLDER: Insert photo of Brett Wright, current owner and Arthur Duhamel's grandson -->
            <div class="text-center p-8">
              <div class="w-16 h-16 rounded-full bg-[var(--color-border)] mx-auto mb-4 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--color-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              </div>
              <p class="text-[var(--color-muted)] text-sm">Photo — Brett Wright, Owner</p>
            </div>
          </div>
          <div class="order-1 md:order-2">
            <h2 class="font-display font-800 text-2xl md:text-3xl text-[var(--color-charcoal)] mb-6">
              Three Generations Later
            </h2>
            <p class="text-[var(--color-muted)] text-base leading-relaxed mb-4">
              Today, Arthur's grandson Brett Wright leads D&H. The name on the truck is different, but the values are identical: honest work, fair prices, and standing behind every job.
            </p>
            <p class="text-[var(--color-muted)] text-base leading-relaxed mb-4">
              Brett grew up in this business. He's fixed AC units in Tucson summers when you can fry an egg on the sidewalk. He's answered emergency calls at midnight. He's hired and trained the technicians who now carry the D&H name into your home.
            </p>
            <p class="text-[var(--color-muted)] text-base leading-relaxed">
              Running D&H isn't just a career for Brett — it's a responsibility. A responsibility to the memory of Arthur and Harry, to the team members who've built their lives here, and to the thousands of Tucson families who trust D&H every day.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ======= TIMELINE ======= -->
  <section class="bg-[var(--color-cloud)] py-16 md:py-24">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="font-display font-800 text-3xl md:text-4xl text-[var(--color-charcoal)] mb-4">
          65 Years of Tucson History
        </h2>
        <p class="text-[var(--color-muted)] text-lg max-w-xl mx-auto">
          From two men with a pickup truck to Tucson's most-reviewed HVAC company.
        </p>
      </div>

      <div class="max-w-3xl mx-auto">
        <div class="relative">
          <!-- Vertical line -->
          <div class="absolute left-8 md:left-1/2 top-0 bottom-0 w-0.5 bg-[var(--color-border)] -translate-x-1/2 hidden sm:block"></div>

          <div class="space-y-8">
            {timeline.map((item, i) => (
              <div class={`flex gap-6 md:gap-0 items-start reveal ${i % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
                <!-- Text block -->
                <div class={`sm:w-5/12 ${i % 2 === 0 ? 'md:text-right md:pr-10' : 'md:text-left md:pl-10'}`}>
                  <div class="bg-white rounded-xl p-5 shadow-sm border border-[var(--color-border)]">
                    <p class="font-display font-800 text-[var(--color-navy)] text-lg mb-2">{item.year}</p>
                    <p class="text-[var(--color-muted)] text-sm leading-relaxed">{item.event}</p>
                  </div>
                </div>

                <!-- Dot -->
                <div class="hidden sm:flex w-2/12 justify-center items-start pt-5 shrink-0">
                  <div class="w-4 h-4 rounded-full bg-[var(--color-orange)] border-4 border-white shadow-md"></div>
                </div>

                <!-- Empty side -->
                <div class="hidden sm:block w-5/12"></div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ======= COMMUNITY ======= -->
  <section class="bg-white py-16 md:py-24">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="font-display font-800 text-3xl md:text-4xl text-[var(--color-charcoal)] mb-4">
            D&H in the Community
          </h2>
          <p class="text-[var(--color-muted)] text-lg max-w-2xl mx-auto">
            We've been part of this city for 65 years. That means more than fixing air conditioners — it means showing up for the people and causes that make Tucson what it is.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
          {[
            { name: "Humane Society of Southern Arizona", desc: "Supporting animal welfare in our community — because compassion belongs everywhere." },
            { name: "MADD Walk for Awareness", desc: "Walking alongside families affected by drunk driving to raise awareness and prevent future tragedies." },
            { name: "Sweat for Pets", desc: "Tucson's favorite charity event that benefits local animal rescue. Of course D&H shows up — it's a summer event." },
            { name: "Walk for MS", desc: "Standing with those fighting multiple sclerosis and the researchers working to find a cure." },
            { name: "Tucson Police Foundation", desc: "Supporting the officers who keep Tucson safe, because community partnership goes both ways." },
            { name: "Local School Sponsorships", desc: "Investing in the next generation of Tucsonans through education, events, and direct school support." },
          ].map(item => (
            <div class="bg-[var(--color-cloud)] rounded-xl p-6 border border-[var(--color-border)]">
              <div class="flex items-start gap-3 mb-3">
                <div class="w-8 h-8 rounded-full bg-[var(--color-navy)] flex items-center justify-center shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                </div>
                <h3 class="font-semibold text-[var(--color-charcoal)] text-sm">{item.name}</h3>
              </div>
              <p class="text-[var(--color-muted)] text-sm leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>

        <!-- PLACEHOLDER: Insert community event photos — charity walks, school events, Sweat for Pets, etc. -->
        <div class="bg-[var(--color-cloud)] rounded-2xl p-8 text-center border-2 border-dashed border-[var(--color-border)]">
          <p class="text-[var(--color-muted)] text-sm">Community event photos — replace with real images from D&H community involvement</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======= VALUES ======= -->
  <section class="bg-[var(--color-navy)] py-16 md:py-20">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="font-display font-800 text-3xl md:text-4xl text-white mb-4">
          What We Stand For
        </h2>
        <p class="text-blue-200 text-lg max-w-xl mx-auto">
          These aren't values we added to a website. They're how D&H has operated since day one.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">

        <div class="bg-blue-900/50 border border-blue-800 rounded-2xl p-8 text-center">
          <div class="w-14 h-14 rounded-full bg-[var(--color-sky)] flex items-center justify-center mx-auto mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3 class="font-display font-700 text-white text-xl mb-3">NATE-Certified Excellence</h3>
          <p class="text-blue-200 text-sm leading-relaxed">
            Every D&H technician holds NATE certification — the industry's highest standard. We don't cut corners on training because we can't afford to cut corners on your comfort.
          </p>
        </div>

        <div class="bg-blue-900/50 border border-blue-800 rounded-2xl p-8 text-center">
          <div class="w-14 h-14 rounded-full bg-[var(--color-orange)] flex items-center justify-center mx-auto mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </div>
          <h3 class="font-display font-700 text-white text-xl mb-3">Continuous Training</h3>
          <p class="text-blue-200 text-sm leading-relaxed">
            HVAC technology changes fast. We invested in a dedicated training facility so our technicians stay current on new systems, refrigerants, and diagnostics — every year, not just at hire.
          </p>
        </div>

        <div class="bg-blue-900/50 border border-blue-800 rounded-2xl p-8 text-center">
          <div class="w-14 h-14 rounded-full bg-[var(--color-success)] flex items-center justify-center mx-auto mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <h3 class="font-display font-700 text-white text-xl mb-3">Post-Visit Follow-Up</h3>
          <p class="text-blue-200 text-sm leading-relaxed">
            We call after every job. Not to sell you something — to make sure the work held up and you're happy. That's how Arthur and Harry would have done it. That's how we do it now.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ======= TRUST BADGES ======= -->
  <TrustBadges />

  <!-- ======= CTA ======= -->
  <section class="bg-white py-16 md:py-20">
    <div class="container mx-auto px-4 text-center">
      <h2 class="font-display font-800 text-3xl md:text-4xl text-[var(--color-charcoal)] mb-4">
        Meet the Team That's Kept Tucson Cool for 65+ Years
      </h2>
      <p class="text-[var(--color-muted)] text-lg max-w-2xl mx-auto mb-8">
        Schedule service today and experience the D&H difference — the same honest, professional care that's defined this company since 1959.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/contact"
          class="inline-block bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-lg px-10 py-4 rounded-xl transition-colors"
        >
          Schedule Service Today
        </a>
        <a
          href="tel:5204082665"
          class="inline-block border-2 border-[var(--color-navy)] text-[var(--color-navy)] hover:bg-[var(--color-navy)] hover:text-white font-bold text-lg px-10 py-4 rounded-xl transition-colors"
        >
          (520) 408-2665
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
