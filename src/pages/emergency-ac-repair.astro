---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBadges from '../components/TrustBadges.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

const title = "Emergency AC Repair Tucson | Available Right Now 24/7 | D&H AC";
const description = "AC down in Tucson heat? D&H is available 24/7 — even holidays. Trucks on the road now. Average response 2–4 hours. Call (520) 664-3699.";
const canonical = "https://dandhac.com/emergency-ac-repair";

const faqItems = [
  { question: "How fast can you get here?", answer: "Most emergency calls within 2–4 hours. We have trucks stationed throughout Tucson and surrounding areas — we route the closest available tech to you." },
  { question: "Do you charge extra for after-hours?", answer: "We offer transparent, upfront pricing. Our technician will give you a clear quote before any work begins, so there are never surprises on the bill." },
  { question: "What if my AC is beyond repair?", answer: "We'll give you an honest assessment. If replacement is needed, we can often install a new system the same day or next day with 0% financing available." },
  { question: "Do you work on all AC brands?", answer: "Yes — Carrier, Trane, Lennox, Daikin, Rheem, York, Goodman, and 20+ more brands. Our techs carry common parts for all major systems." },
  { question: "Is emergency service available on holidays?", answer: "Absolutely. 365 days a year, 24 hours a day. Christmas, Thanksgiving, New Year's — we don't take holidays off. Tucson summers don't either." },
  { question: "What should I do while waiting for the tech?", answer: "Turn off the AC to avoid further damage. Open windows in the evening if it cools down. Use fans to circulate air. Stay hydrated, especially if you have elderly or young family members in the home." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": { "@type": "Answer", "text": item.answer }
  }))
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Emergency AC Repair",
  "provider": {
    "@type": "HVACBusiness",
    "name": "D&H Air Conditioning & Heating & Plumbing",
    "telephone": "(520) 664-3699",
    "url": "https://dandhac.com"
  },
  "areaServed": "Tucson, AZ",
  "description": "24/7 emergency air conditioning repair service in Tucson, AZ. Average response time 2–4 hours, all brands, all makes and models.",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dandhac.com" },
    { "@type": "ListItem", "position": 2, "name": "Emergency AC Repair", "item": "https://dandhac.com/emergency-ac-repair" }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} schema={[faqSchema, serviceSchema, breadcrumbSchema]}>

  <!-- ── Hero ─────────────────────────────────────────────────── -->
  <section class="emergency-gradient relative overflow-hidden">
    <div class="absolute inset-0 hero-pattern opacity-30 pointer-events-none"></div>
    <!-- PLACEHOLDER: Replace with real D&H emergency truck or technician arriving at night photography -->
    <div class="absolute inset-0 opacity-15 pointer-events-none">
      <img
        src="https://images.unsplash.com/photo-1504701954957-2010ec3bcec1?auto=format&fit=crop&w=1400&q=60"
        alt="" aria-hidden="true" width="1400" height="900" loading="eager"
        class="w-full h-full object-cover"
      />
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 relative">
      <div class="text-center">
        <!-- Live indicator -->
        <div class="inline-flex items-center gap-2.5 bg-white/15 border border-white/25 text-white text-sm font-bold px-5 py-2.5 rounded-full mb-7 uppercase tracking-wider">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-white"></span>
          </span>
          Trucks On The Road Right Now · 24/7
        </div>

        <h1 class="font-display font-extrabold text-4xl md:text-5xl lg:text-6xl text-white leading-[1.05] mb-5">
          Emergency AC Repair<br class="hidden md:block" /> in Tucson —
          <span class="text-yellow-300">Available Right Now</span>
        </h1>

        <p class="text-orange-100 text-xl md:text-2xl leading-relaxed mb-10 max-w-2xl mx-auto">
          Trucks on the road. Techs on call. We answer 24/7,<br class="hidden md:block" /> even on holidays. Average response: 2–4 hours.
        </p>

        <!-- Giant call button -->
        <a
          href="tel:5206643699"
          class="block sm:inline-flex items-center justify-center gap-4 bg-white text-red-700 hover:bg-yellow-50 font-extrabold text-2xl md:text-3xl px-10 py-6 rounded-2xl transition-colors shadow-2xl mb-6 w-full sm:w-auto"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          CALL (520) 664-3699 NOW
        </a>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 text-orange-200 text-sm">
          <span class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Avg response: 2–4 hours
          </span>
          <span class="hidden sm:block text-orange-500">|</span>
          <span class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            All makes &amp; models
          </span>
          <span class="hidden sm:block text-orange-500">|</span>
          <a href="/contact" class="underline hover:text-white transition-colors">Or schedule online →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 3-Step Process ─────────────────────────────────────── -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2 class="font-display font-extrabold text-3xl md:text-4xl text-[var(--color-charcoal)] mb-3">What happens when you call</h2>
        <p class="text-[var(--color-muted)] text-lg">Simple. Fast. No runaround.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6 relative">
        <!-- Connector lines on desktop -->
        <div class="hidden md:block absolute top-10 left-1/3 right-1/3 h-0.5 bg-gradient-to-r from-red-200 via-orange-200 to-green-200 z-0"></div>

        {[
          { num: '1', title: 'You call', sub: 'We dispatch within minutes', desc: 'A real person answers — not a voicemail, not a call center. We take your address and get a tech rolling immediately.', color: 'bg-red-600', border: 'border-red-100 hover:border-red-300' },
          { num: '2', title: 'We dispatch', sub: 'Nearest truck en route', desc: 'We route the closest available technician to your home. You\'ll get a call when they\'re on the way with an ETA.', color: 'bg-[var(--color-orange)]', border: 'border-orange-100 hover:border-orange-300' },
          { num: '3', title: 'AC fixed', sub: 'Same visit in most cases', desc: 'Our trucks are stocked with common parts. Most repairs are diagnosed and completed in a single visit, same day.', color: 'bg-[var(--color-success)]', border: 'border-green-100 hover:border-green-300' },
        ].map(step => (
          <div class={`reveal bg-white rounded-2xl p-7 border-2 ${step.border} transition-all card-lift relative z-10`}>
            <div class={`w-14 h-14 ${step.color} text-white font-extrabold text-2xl rounded-full flex items-center justify-center mb-5 shadow-lg`}>{step.num}</div>
            <h3 class="font-display font-extrabold text-xl text-[var(--color-charcoal)] mb-1">{step.title}</h3>
            <p class="text-[var(--color-orange)] font-semibold text-sm mb-3">{step.sub}</p>
            <p class="text-[var(--color-muted)] text-sm leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Trust Badges ──────────────────────────────────────────── -->
  <TrustBadges />

  <!-- ── Why D&H for emergencies ──────────────────────────────── -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-14 items-center">
        <div class="reveal">
          <p class="font-display font-extrabold text-[9rem] md:text-[12rem] leading-none text-[var(--color-cloud)] select-none -mb-6">1959</p>
          <p class="text-[var(--color-muted)] text-sm font-semibold uppercase tracking-wide">Serving Tucson for</p>
          <p class="font-display font-extrabold text-5xl text-[var(--color-navy)]">65+ years</p>
        </div>
        <div class="reveal">
          <h2 class="font-display font-extrabold text-2xl md:text-3xl text-[var(--color-charcoal)] mb-5">
            Tucson's most experienced emergency AC team
          </h2>
          <p class="text-[var(--color-muted)] leading-relaxed mb-5">
            We've handled thousands of emergency AC calls in Tucson's brutal summers. Record heat years, nights when every AC in town seemed to fail — we've seen it all, and we've been showing up for over 65 years.
          </p>
          <p class="text-[var(--color-muted)] leading-relaxed mb-7">
            Arthur Duhamel and Harry Hawk founded D&H in 1959 with one promise: show up, do it right, treat people fairly. Today, founder's grandson <strong class="text-[var(--color-charcoal)]">Brett Wright</strong> leads our team with the same commitment on every call.
          </p>
          <div class="grid grid-cols-3 gap-3">
            {[
              { v: '4.8★', l: 'Google rating', s: '4,000+ reviews' },
              { v: 'NATE', l: 'Certified techs', s: 'Industry gold standard' },
              { v: '24/7', l: 'Emergency service', s: '365 days a year' },
            ].map(s => (
              <div class="bg-[var(--color-cloud)] rounded-xl p-4 text-center">
                <p class="font-display font-extrabold text-xl text-[var(--color-navy)]">{s.v}</p>
                <p class="text-xs font-semibold text-[var(--color-charcoal)] mt-0.5">{s.l}</p>
                <p class="text-xs text-[var(--color-muted)]">{s.s}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── What we fix ───────────────────────────────────────────── -->
  <section class="py-16 bg-[var(--color-cloud)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 reveal">
        <h2 class="font-display font-extrabold text-2xl md:text-3xl text-[var(--color-charcoal)] mb-3">We fix everything AC-related</h2>
        <p class="text-[var(--color-muted)]">All makes, all models, all problems.</p>
      </div>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-3">
        {[
          'AC blowing warm air', 'AC won\'t turn on', 'Frozen refrigerant lines',
          'Capacitor failure', 'Compressor issues', 'Refrigerant leaks',
          'Thermostat problems', 'Electrical failures', 'Strange noises or smells',
          'Short cycling', 'No airflow', 'High energy bills',
        ].map(symptom => (
          <div class="reveal flex items-center gap-3 bg-white rounded-xl px-4 py-3.5 border border-[var(--color-border)]">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="text-sm font-medium text-[var(--color-charcoal)]">{symptom}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FAQ ───────────────────────────────────────────────────── -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2 class="font-display font-extrabold text-3xl text-[var(--color-charcoal)] mb-3">Questions about emergency AC repair</h2>
        <p class="text-[var(--color-muted)]">Answered honestly, the way we've always done things.</p>
      </div>
      <FAQAccordion items={faqItems} id="emergency-faq" />
    </div>
  </section>

  <!-- ── Final CTA ─────────────────────────────────────────────── -->
  <section class="bg-[var(--color-navy)] py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-extrabold text-3xl md:text-4xl text-white mb-4">
        Don't suffer through another hour without AC.
      </h2>
      <p class="text-blue-200 text-xl mb-8">Call now. Our team is standing by.</p>
      <a
        href="tel:5206643699"
        class="block sm:inline-flex items-center justify-center gap-3 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-extrabold text-2xl px-10 py-5 rounded-2xl transition-colors shadow-xl mb-5 w-full sm:w-auto cta-pulse"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        CALL (520) 664-3699
      </a>
      <p class="text-blue-300 text-sm">or <a href="/contact" class="underline hover:text-white transition-colors">schedule online →</a></p>
    </div>
  </section>

</BaseLayout>
