---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const title = "AC Repair in Marana, AZ — D&H Air Conditioning";
const description = "AC repair, installation & maintenance in Marana, AZ. D&H Air Conditioning serves Marana with NATE-certified technicians and same-day service. Call (520) 408-2665.";
const canonical = "https://dandhac.com/service-areas/marana/";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dandhac.com/" },
    { "@type": "ListItem", "position": 2, "name": "Service Areas", "item": "https://dandhac.com/service-areas/" },
    { "@type": "ListItem", "position": 3, "name": "Marana", "item": canonical }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "AC Repair in Marana, AZ",
  "provider": {
    "@type": "HVACBusiness",
    "name": "D&H Air Conditioning & Heating & Plumbing",
    "telephone": "(520) 408-2665",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "3990 S Evans Blvd",
      "addressLocality": "Tucson",
      "addressRegion": "AZ",
      "postalCode": "85714",
      "addressCountry": "US"
    }
  },
  "areaServed": { "@type": "City", "name": "Marana", "addressRegion": "AZ" },
  "description": "Full HVAC services including AC repair, emergency repair, installation, maintenance, heating, and plumbing in Marana, AZ."
};

const faqItems = [
  {
    question: "Do you install new AC systems in Marana's newer homes?",
    answer: "Yes — and this is one of our most common requests in Marana. Many newer homes were built with builder-grade systems that are reaching the end of their useful life or weren't sized correctly for the home. We offer free equipment assessments and right-sized installations with 0% financing options. Call (520) 408-2665 to get started."
  },
  {
    question: "Can you service my AC warranty in Marana?",
    answer: "We service all major brands and can perform manufacturer-required maintenance to keep your warranty valid. If you have a newer system under warranty, our NATE-certified technicians follow proper protocols and document the service correctly. We're an authorized Daikin dealer and can service most other major brands as well."
  },
  {
    question: "Do you offer emergency service in Marana on weekends and holidays?",
    answer: "Yes — our emergency line is active 24/7, 365 days a year including all holidays. Marana is approximately 25 minutes from our Evans Blvd base, and we have trucks running in the northwest corridor regularly. Call our emergency line at (520) 664-3699 for after-hours situations."
  }
];

const services = [
  "AC Repair", "Emergency AC Repair", "AC Installation", "AC Maintenance",
  "Heating Repair", "Furnace Repair", "Plumbing"
];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={[breadcrumbSchema, serviceSchema]}>

  <section class="bg-[var(--color-cloud)] border-b border-[var(--color-border)] py-14 md:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-[var(--color-muted)] mb-6">
        <a href="/" class="hover:text-[var(--color-navy)]">Home</a>
        <span class="mx-2">/</span>
        <a href="/service-areas/" class="hover:text-[var(--color-navy)]">Service Areas</a>
        <span class="mx-2">/</span>
        <span class="text-[var(--color-charcoal)] font-medium">Marana</span>
      </nav>
      <h1 class="font-display font-extrabold text-4xl md:text-5xl text-[var(--color-charcoal)] leading-tight mb-4">
        AC Repair in Marana, AZ —<br class="hidden md:block" /> D&H Air Conditioning
      </h1>
      <p class="text-[var(--color-muted)] text-lg md:text-xl max-w-2xl mb-8">
        Marana is one of the fastest-growing communities in Arizona — and D&H has been here for the entire ride. New homes, new systems, same desert heat. We've got you covered.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-base px-6 py-4 rounded-xl transition-colors shadow-md">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          Schedule Service
        </a>
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 border-2 border-[var(--color-navy)] text-[var(--color-navy)] hover:bg-[var(--color-navy)] hover:text-white font-bold text-base px-6 py-4 rounded-xl transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call (520) 408-2665
        </a>
      </div>
    </div>
  </section>

  <section class="py-14 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">Serving Marana's Growing Communities</h2>
      <p class="text-[var(--color-muted)] leading-relaxed text-lg max-w-3xl">
        Marana's explosive growth has brought thousands of new homes and businesses to the northwest side of greater Tucson. D&H has been part of that growth — installing systems in new construction, maintaining equipment across Dove Mountain, Continental Ranch, and Gladden Farms, and responding to emergencies across the entire Marana area. As the population has grown, so has our team and our commitment to fast response times throughout the northwest corridor.
      </p>
    </div>
  </section>

  <section class="py-14 bg-[var(--color-cloud)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-6">Services We Offer in Marana</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        {services.map(service => (
          <div class="flex items-center gap-3 bg-white rounded-xl px-5 py-4 border border-[var(--color-border)] shadow-sm">
            <svg class="shrink-0 text-[var(--color-success)]" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="font-semibold text-[var(--color-charcoal)]">{service}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">How Close Are We?</h2>
      <div class="bg-[var(--color-cloud)] rounded-2xl p-6 border border-[var(--color-border)] max-w-lg">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-[var(--color-navy)] flex items-center justify-center shrink-0">
            <svg class="text-white" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <p class="font-bold text-[var(--color-charcoal)] text-lg">~18 miles · approximately 25 minutes</p>
            <p class="text-[var(--color-muted)] text-sm mt-1">From our Evans Blvd headquarters, we head northwest on I-10 or Thornydale Road to reach Marana neighborhoods in approximately 25 minutes. We run service routes through the northwest corridor daily, so same-day and emergency response is a regular part of our Marana operations.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 bg-[var(--color-cloud)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">Marana's Climate — Newer Doesn't Mean Problem-Free</h2>
      <p class="text-[var(--color-muted)] leading-relaxed text-lg max-w-3xl">
        Marana's rapid growth means many systems are just 5–10 years old — but even newer systems need maintenance in desert heat. Arizona's UV-intense sun degrades outdoor unit components faster than anywhere else in the country. Dust and debris from Marana's still-developing landscape can clog filters and coils quickly. And many builder-grade systems installed during the construction boom were sized for minimum code compliance, not optimal comfort. D&H can assess your system's true condition and keep it running efficiently for the long term.
      </p>
    </div>
  </section>

  <section class="py-10 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- PLACEHOLDER: Add local Marana Google Reviews here -->
      <div class="bg-[var(--color-cloud)] border-2 border-dashed border-[var(--color-border)] rounded-2xl p-8 text-center text-[var(--color-muted)]">
        <p class="font-semibold mb-1">Local Reviews — Marana</p>
        <p class="text-sm">Google Reviews widget or manual review cards go here.</p>
      </div>
    </div>
  </section>

  <TrustBadges />

  <section class="py-14 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-6">Frequently Asked Questions — Marana</h2>
      <FAQAccordion items={faqItems} id="faq-marana" />
    </div>
  </section>

  <section class="bg-[var(--color-orange)] py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-extrabold text-3xl text-white mb-4">Call our Marana team at (520) 408-2665</h2>
      <p class="text-orange-100 mb-7">Same-day service available · 24/7 emergency response · NATE-certified technicians</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 bg-white text-[var(--color-orange)] hover:bg-orange-50 font-bold text-lg px-8 py-4 rounded-xl transition-colors shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          (520) 408-2665
        </a>
        <a href="/contact" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white hover:bg-white hover:text-[var(--color-orange)] font-bold text-lg px-8 py-4 rounded-xl transition-colors">
          Book Online
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
