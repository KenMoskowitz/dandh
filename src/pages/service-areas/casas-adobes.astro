---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const title = "AC Repair in Casas Adobes, AZ — D&H Air Conditioning";
const description = "AC repair, installation & maintenance in Casas Adobes, AZ. D&H Air Conditioning serves Casas Adobes with NATE-certified technicians. Call (520) 408-2665.";
const canonical = "https://dandhac.com/service-areas/casas-adobes/";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dandhac.com/" },
    { "@type": "ListItem", "position": 2, "name": "Service Areas", "item": "https://dandhac.com/service-areas/" },
    { "@type": "ListItem", "position": 3, "name": "Casas Adobes", "item": canonical }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "AC Repair in Casas Adobes, AZ",
  "provider": {
    "@type": "HVACBusiness",
    "name": "D&H Air Conditioning & Heating & Plumbing",
    "telephone": "(520) 408-2665"
  },
  "areaServed": { "@type": "City", "name": "Casas Adobes", "addressRegion": "AZ" }
};

const faqItems = [
  {
    question: "How fast can you get to Casas Adobes for an emergency repair?",
    answer: "Casas Adobes is one of our highest-volume service areas — we're there regularly. For emergency calls, we aim for a 2–3 hour response. We have trucks running Oracle Road and the northwest Tucson corridor daily, which often puts us much closer than our Evans Blvd headquarters alone would suggest. For 24/7 emergencies, call (520) 664-3699."
  },
  {
    question: "Do you service older HVAC systems in Casas Adobes homes?",
    answer: "Absolutely. Casas Adobes has a mix of homes from the 1970s through the 2000s, many with aging systems. Our technicians are experienced with older R-22 refrigerant systems, older carrier and Lennox equipment, and original ductwork that may need sealing or replacement. We give you honest options — repair vs. replace — with no pressure."
  },
  {
    question: "Can I get a new AC system installed in one day in Casas Adobes?",
    answer: "In most cases, yes. Standard single-system replacements on existing ductwork can be completed in one day. Our installers arrive fully equipped and stocked. We'll confirm the timeline at your free estimate appointment. Call (520) 408-2665 to schedule."
  }
];

const services = [
  "AC Repair", "Emergency AC Repair", "AC Installation", "AC Maintenance",
  "Heating Repair", "Furnace Repair", "Plumbing"
];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={[breadcrumbSchema, serviceSchema]}>

  <section class="bg-gradient-to-br from-[var(--color-navy)] to-[var(--color-navy-dark)] hero-pattern py-14 md:py-20 relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-1.5 text-xs text-blue-400 mb-6">
        <a href="/" class="hover:text-blue-200 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/service-areas/" class="hover:text-blue-200 transition-colors">Service Areas</a>
        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-blue-200 font-medium">Casas Adobes</span>
      </nav>
      <h1 class="font-display font-extrabold text-4xl md:text-5xl text-white leading-[1.05] mb-4">
        AC Repair in Casas Adobes, AZ —<br class="hidden md:block" /> D&H Air Conditioning
      </h1>
      <p class="text-blue-200 text-lg md:text-xl max-w-2xl mb-8">
        Casas Adobes is one of Tucson's most established residential communities — and one of D&H's most active service areas. When your AC goes down, we're never far away.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-base px-6 py-4 rounded-xl transition-colors shadow-md">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          Schedule Service
        </a>
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 border-2 border-white/30 text-white hover:bg-white/10 font-bold text-base px-6 py-4 rounded-xl transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call (520) 408-2665
        </a>
      </div>
    </div>
  </section>

  <section class="py-14 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">Serving Casas Adobes for Decades</h2>
      <p class="text-[var(--color-muted)] leading-relaxed text-lg max-w-3xl">
        Casas Adobes has been a mainstay of D&H's service territory since the neighborhood was established. We've maintained systems in the original mid-century homes, replaced aging equipment in 1980s ranch houses, and installed brand-new systems in the larger homes near the Foothills Mall corridor. Our technicians know the neighborhoods, know the common equipment installed by Tucson builders through the decades, and deliver consistent, reliable service every visit.
      </p>
    </div>
  </section>

  <section class="py-14 bg-[var(--color-cloud)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-6">Services We Offer in Casas Adobes</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        {services.map(service => (
          <div class="flex items-center gap-3 bg-white rounded-xl px-5 py-4 border border-[var(--color-border)] shadow-sm">
            <svg class="shrink-0 text-[var(--color-success)]" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="font-semibold text-[var(--color-charcoal)]">{service}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">How Close Are We?</h2>
      <div class="bg-[var(--color-cloud)] rounded-2xl p-6 border border-[var(--color-border)] max-w-lg">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-[var(--color-navy)] flex items-center justify-center shrink-0">
            <svg class="text-white" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <p class="font-bold text-[var(--color-charcoal)] text-lg">~12 miles · approximately 20 minutes</p>
            <p class="text-[var(--color-muted)] text-sm mt-1">Casas Adobes is one of the closest communities to our Evans Blvd headquarters. A straight shot up Oracle Road or I-10/Ina Road gets us there in about 20 minutes under normal traffic. This short distance means faster same-day and emergency response times for Casas Adobes customers.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 bg-[var(--color-cloud)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">Casas Adobes — Where AC Reliability Is Non-Negotiable</h2>
      <p class="text-[var(--color-muted)] leading-relaxed text-lg max-w-3xl">
        Casas Adobes is a densely populated residential area where AC reliability is non-negotiable during summer. Families, seniors, and young children live in close proximity, and when the temperature climbs past 105°F, a broken AC isn't an inconvenience — it's a health risk. The area's mix of home ages means equipment ranges from brand new to 25+ years old, and our technicians are equipped to handle the full spectrum. We also see more older ductwork here than in newer developments — leaky ducts can account for up to 30% of cooling loss, and we test and seal them as part of our thorough service.
      </p>
    </div>
  </section>

  <section class="py-10 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- PLACEHOLDER: Add local Casas Adobes Google Reviews here -->
      <div class="bg-[var(--color-cloud)] border-2 border-dashed border-[var(--color-border)] rounded-2xl p-8 text-center text-[var(--color-muted)]">
        <p class="font-semibold mb-1">Local Reviews — Casas Adobes</p>
        <p class="text-sm">Google Reviews widget or manual review cards go here.</p>
      </div>
    </div>
  </section>

  <TrustBadges />

  <section class="py-14 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-6">Frequently Asked Questions — Casas Adobes</h2>
      <FAQAccordion items={faqItems} id="faq-casas-adobes" />
    </div>
  </section>

  <section class="bg-[var(--color-orange)] py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-extrabold text-3xl text-white mb-4">Call our Casas Adobes team at (520) 408-2665</h2>
      <p class="text-orange-100 mb-7">Same-day service available · 24/7 emergency response · NATE-certified technicians</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 bg-white text-[var(--color-orange)] hover:bg-orange-50 font-bold text-lg px-8 py-4 rounded-xl transition-colors shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          (520) 408-2665
        </a>
        <a href="/contact" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white hover:bg-white hover:text-[var(--color-orange)] font-bold text-lg px-8 py-4 rounded-xl transition-colors">
          Book Online
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
