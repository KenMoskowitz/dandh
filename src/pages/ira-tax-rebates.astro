---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBadges from '../components/TrustBadges.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

const title = "IRA HVAC Tax Credits 2025 | Up to $3,200 Back | D&H Tucson";
const description = "The Inflation Reduction Act offers up to $3,200 in federal tax credits for qualifying HVAC equipment. Heat pumps, central AC, and more. D&H installs qualifying systems in Tucson.";
const canonical = "https://dandhac.com/ira-tax-rebates";

const faqItems = [
  { question: "Do I qualify for the HVAC tax credit?", answer: "Most homeowners who install qualifying ENERGY STAR equipment in their primary residence qualify. The credit applies to heat pumps, high-efficiency central AC, gas furnaces, and heat pump water heaters installed in 2023–2032." },
  { question: "How much can I claim?", answer: "For heat pumps: up to 30% of the installed cost, capped at $2,000 per year. For other HVAC equipment: up to $600 per item, with a combined limit of $1,200. Total annual cap is $3,200 across all qualifying home improvements." },
  { question: "Does D&H install qualifying equipment?", answer: "Yes. As a Daikin Comfort Pro dealer, we install high-efficiency heat pumps and AC systems that meet IRA requirements. We can help you identify which systems qualify before you purchase." },
  { question: "How do I claim the credit?", answer: "You'll file IRS Form 5695 with your federal tax return. We provide all the documentation you need — equipment details, ENERGY STAR certification, and cost information." },
  { question: "Can I combine tax credits with financing?", answer: "Yes. You can finance the system today and still claim the tax credit when you file your return. The credit reduces your tax liability regardless of how you paid for the system." },
];

const credits = [
  { system: "Heat Pumps (Air-Source)", max: "$2,000/yr", pct: "30%", notes: "Must meet efficiency requirements. Covers purchase and installation." },
  { system: "Central AC Systems", max: "$600", pct: "Up to 30%", notes: "ENERGY STAR certified equipment required." },
  { system: "Gas/Propane Furnaces", max: "$600", pct: "Up to 30%", notes: "95%+ AFUE efficiency required for most regions." },
  { system: "Heat Pump Water Heaters", max: "$2,000/yr", pct: "30%", notes: "Combined with HVAC heat pump under the same annual cap." },
  { system: "Home Energy Audit", max: "$150", pct: "30%", notes: "Certified energy auditor required." },
];
---

<BaseLayout title={title} description={description} canonical={canonical}>

  <!-- ── Hero ─────────────────────────────────────────────────── -->
  <section class="bg-gradient-to-br from-[var(--color-navy)] to-[var(--color-navy-dark)] hero-pattern relative overflow-hidden">
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-green-500/8 rounded-full blur-3xl pointer-events-none"></div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 relative text-center">
      <div class="inline-flex items-center gap-2 bg-green-500/20 border border-green-400/30 text-green-300 text-xs font-bold px-3.5 py-1.5 rounded-full mb-5 uppercase tracking-wider">
        Federal Tax Credits · Inflation Reduction Act
      </div>
      <h1 class="font-display font-extrabold text-4xl md:text-5xl lg:text-6xl text-white leading-[1.05] mb-5">
        Get Up to
        <span class="text-green-300">$3,200 Back</span>
        on Your New HVAC System
      </h1>
      <p class="text-blue-200 text-lg md:text-xl leading-relaxed mb-8 max-w-2xl mx-auto">
        The Inflation Reduction Act makes qualifying heat pumps, AC systems, and furnaces eligible for significant federal tax credits. We install the systems that qualify.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-base px-7 py-4 rounded-xl transition-colors shadow-lg cta-pulse">
          Ask About Qualifying Systems
        </a>
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 border-2 border-white/30 text-white hover:bg-white/10 font-bold text-base px-7 py-4 rounded-xl transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call (520) 408-2665
        </a>
      </div>
    </div>
  </section>

  <!-- What qualifies -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2 class="font-display font-extrabold text-3xl md:text-4xl text-[var(--color-charcoal)] mb-3">What qualifies for the credit?</h2>
        <p class="text-[var(--color-muted)] text-lg">Credits apply to systems installed in your primary residence from 2023–2032.</p>
      </div>
      <div class="overflow-hidden rounded-2xl border border-[var(--color-border)] shadow-sm">
        <div class="grid grid-cols-4 bg-[var(--color-navy)] text-white text-sm font-bold">
          <div class="p-4">System</div>
          <div class="p-4 border-l border-blue-800">Max Credit</div>
          <div class="p-4 border-l border-blue-800">% of Cost</div>
          <div class="p-4 border-l border-blue-800 hidden md:block">Notes</div>
        </div>
        {credits.map((row, i) => (
          <div class={`grid grid-cols-4 border-b border-[var(--color-border)] text-sm ${i % 2 === 0 ? 'bg-white' : 'bg-[var(--color-cloud)]'}`}>
            <div class="p-4 font-semibold text-[var(--color-charcoal)]">{row.system}</div>
            <div class="p-4 border-l border-[var(--color-border)] font-bold text-green-600">{row.max}</div>
            <div class="p-4 border-l border-[var(--color-border)] text-[var(--color-charcoal)]">{row.pct}</div>
            <div class="p-4 border-l border-[var(--color-border)] text-[var(--color-muted)] text-xs hidden md:block">{row.notes}</div>
          </div>
        ))}
      </div>
      <p class="text-xs text-[var(--color-muted)] mt-4 text-center">Annual combined cap: $3,200. Consult a tax professional for your specific situation. Information current as of 2025.</p>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-16 bg-[var(--color-cloud)]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 reveal">
        <h2 class="font-display font-extrabold text-3xl text-[var(--color-charcoal)] mb-3">How to claim your credit</h2>
      </div>
      <div class="grid sm:grid-cols-2 gap-5">
        {[
          { num: '1', title: 'Install a qualifying system', desc: 'We help you choose qualifying equipment — heat pumps and high-efficiency systems from Daikin and other ENERGY STAR brands.' },
          { num: '2', title: 'Keep your documentation', desc: "We provide the manufacturer's certification statement and itemized invoice — everything you need for your tax filing." },
          { num: '3', title: 'File IRS Form 5695', desc: 'When you file your federal return, complete Form 5695 (Residential Energy Credits). The credit reduces your tax bill dollar-for-dollar.' },
          { num: '4', title: 'Collect your refund', desc: 'If the credit exceeds what you owe, it rolls forward to future tax years (2023–2032 window).' },
        ].map(step => (
          <div class="reveal bg-white rounded-2xl p-6 border border-[var(--color-border)] shadow-sm flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-green-100 text-green-700 font-extrabold text-lg flex items-center justify-center shrink-0">{step.num}</div>
            <div>
              <h3 class="font-display font-bold text-base text-[var(--color-charcoal)] mb-1.5">{step.title}</h3>
              <p class="text-[var(--color-muted)] text-sm leading-relaxed">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Combo callout -->
  <section class="py-14 bg-[var(--color-navy)]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-extrabold text-2xl md:text-3xl text-white mb-4">
        Combine IRA credits with 0% financing
      </h2>
      <p class="text-blue-200 text-lg mb-6 max-w-xl mx-auto">
        Finance today, claim the credit at tax time. Many Tucson homeowners are saving thousands by stacking these two programs.
      </p>
      <a href="/financing" class="inline-flex items-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-base px-7 py-4 rounded-xl transition-colors shadow-lg">
        See Financing Options →
      </a>
    </div>
  </section>

  <!-- Trust Badges -->
  <TrustBadges />

  <!-- FAQ -->
  <section class="py-16 bg-[var(--color-cloud)]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 reveal">
        <h2 class="font-display font-extrabold text-3xl text-[var(--color-charcoal)] mb-3">IRA tax credit questions</h2>
        <p class="text-[var(--color-muted)]">Common questions from Tucson homeowners considering qualifying HVAC upgrades.</p>
      </div>
      <FAQAccordion items={faqItems} id="ira-faq" />
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-[var(--color-navy)] py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-extrabold text-3xl text-white mb-4">Ready to save thousands?</h2>
      <p class="text-blue-200 text-lg mb-8">We'll help you pick the right qualifying system and handle all the documentation. Call or book a free estimate today.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-lg px-8 py-4 rounded-xl transition-colors shadow-lg">
          Get a Free Estimate
        </a>
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white hover:bg-white hover:text-[var(--color-navy)] font-bold text-lg px-8 py-4 rounded-xl transition-colors">
          Call (520) 408-2665
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
