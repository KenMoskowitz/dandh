---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const title = "AC Repair in Green Valley, AZ — D&H Air Conditioning";
const description = "Trusted AC repair, installation & maintenance in Green Valley, AZ. D&H has served Green Valley's retirement community for decades. Call (520) 408-2665.";
const canonical = "https://dandhac.com/service-areas/green-valley/";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dandhac.com/" },
    { "@type": "ListItem", "position": 2, "name": "Service Areas", "item": "https://dandhac.com/service-areas/" },
    { "@type": "ListItem", "position": 3, "name": "Green Valley", "item": canonical }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "AC Repair in Green Valley, AZ",
  "provider": {
    "@type": "HVACBusiness",
    "name": "D&H Air Conditioning & Heating & Plumbing",
    "telephone": "(520) 408-2665"
  },
  "areaServed": { "@type": "City", "name": "Green Valley", "addressRegion": "AZ" }
};

const faqItems = [
  {
    question: "Do you work on older HVAC systems common in Green Valley homes?",
    answer: "Yes — this is some of our most important work in Green Valley. Many homes here have systems that are 15–25 years old, and our technicians know how to evaluate them honestly. We'll tell you whether a repair makes economic sense or whether replacement is the smarter long-term investment — and we'll explain exactly why, without any pressure."
  },
  {
    question: "Can you help Green Valley homeowners with energy-efficient upgrades?",
    answer: "Absolutely. Replacing an older system with a modern high-efficiency unit can dramatically reduce utility bills — something that matters greatly to retirees on fixed incomes. We install Daikin systems rated up to 19+ SEER and can walk you through available federal tax credits and utility rebates that make the upgrade even more affordable. Call (520) 408-2665 for a no-obligation assessment."
  },
  {
    question: "Do you offer any priority service for Green Valley seniors?",
    answer: "Our Family Maintenance Plan provides priority dispatch for all members, which means Green Valley customers enrolled in the plan receive preferential scheduling during peak summer periods. We understand that seniors face greater health risks in extreme heat, and we treat Green Valley emergency calls with appropriate urgency. No AC in summer heat is always an emergency — call us at (520) 408-2665 or our emergency line at (520) 664-3699."
  }
];

const services = [
  "AC Repair", "Emergency AC Repair", "AC Installation", "AC Maintenance",
  "Heating Repair", "Furnace Repair", "Plumbing"
];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={[breadcrumbSchema, serviceSchema]}>

  <section class="bg-[var(--color-cloud)] border-b border-[var(--color-border)] py-14 md:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-[var(--color-muted)] mb-6">
        <a href="/" class="hover:text-[var(--color-navy)]">Home</a>
        <span class="mx-2">/</span>
        <a href="/service-areas/" class="hover:text-[var(--color-navy)]">Service Areas</a>
        <span class="mx-2">/</span>
        <span class="text-[var(--color-charcoal)] font-medium">Green Valley</span>
      </nav>
      <h1 class="font-display font-extrabold text-4xl md:text-5xl text-[var(--color-charcoal)] leading-tight mb-4">
        AC Repair in Green Valley, AZ —<br class="hidden md:block" /> D&H Air Conditioning
      </h1>
      <p class="text-[var(--color-muted)] text-lg md:text-xl max-w-2xl mb-8">
        Green Valley's residents deserve the same fast, professional HVAC service as anyone in Tucson. D&H has been making the I-19 run south for decades — and we'll be there when you need us.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-base px-6 py-4 rounded-xl transition-colors shadow-md">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          Schedule Service
        </a>
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 border-2 border-[var(--color-navy)] text-[var(--color-navy)] hover:bg-[var(--color-navy)] hover:text-white font-bold text-base px-6 py-4 rounded-xl transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call (520) 408-2665
        </a>
      </div>
    </div>
  </section>

  <section class="py-14 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">Serving Green Valley Since the 1970s</h2>
      <p class="text-[var(--color-muted)] leading-relaxed text-lg max-w-3xl">
        Green Valley developed as a master-planned retirement community starting in the 1960s, and D&H has been a regular presence there since the 1970s. We've maintained, repaired, and replaced HVAC systems across the many neighborhoods and HOA communities that make up Green Valley — from the original Continental Ranch sections to the newer developments. Our Green Valley customers often become long-term relationships, and we treat every service call with the respect and care that trust deserves.
      </p>
    </div>
  </section>

  <section class="py-14 bg-[var(--color-cloud)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-6">Services We Offer in Green Valley</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        {services.map(service => (
          <div class="flex items-center gap-3 bg-white rounded-xl px-5 py-4 border border-[var(--color-border)] shadow-sm">
            <svg class="shrink-0 text-[var(--color-success)]" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="font-semibold text-[var(--color-charcoal)]">{service}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">How Close Are We?</h2>
      <div class="bg-[var(--color-cloud)] rounded-2xl p-6 border border-[var(--color-border)] max-w-lg">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-[var(--color-navy)] flex items-center justify-center shrink-0">
            <svg class="text-white" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <p class="font-bold text-[var(--color-charcoal)] text-lg">~25 miles south on I-19 · approximately 30 minutes</p>
            <p class="text-[var(--color-muted)] text-sm mt-1">Green Valley is a straight shot south from our Evans Blvd headquarters on I-19. The freeway drive is fast and reliable, and we dispatch to Green Valley regularly throughout the week. For same-day service, calling before noon gives you the best chance of a same-day visit.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 bg-[var(--color-cloud)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">Green Valley's Climate — Expert Care for Aging Systems</h2>
      <p class="text-[var(--color-muted)] leading-relaxed text-lg max-w-3xl">
        Green Valley's retirement community means many long-standing systems that need expert care. Homes built in the 1970s and 1980s often have original ductwork that has never been inspected, aging units that are still running but far below their original efficiency, and refrigerant systems using R-22 that is no longer manufactured. Our technicians are experienced in assessing these older systems and giving homeowners honest, clear guidance — whether that means a targeted repair to extend life a few more years or a full replacement that will dramatically improve comfort and reduce utility costs.
      </p>
    </div>
  </section>

  <section class="py-10 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- PLACEHOLDER: Add local Green Valley Google Reviews here -->
      <div class="bg-[var(--color-cloud)] border-2 border-dashed border-[var(--color-border)] rounded-2xl p-8 text-center text-[var(--color-muted)]">
        <p class="font-semibold mb-1">Local Reviews — Green Valley</p>
        <p class="text-sm">Google Reviews widget or manual review cards go here.</p>
      </div>
    </div>
  </section>

  <TrustBadges />

  <section class="py-14 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-6">Frequently Asked Questions — Green Valley</h2>
      <FAQAccordion items={faqItems} id="faq-green-valley" />
    </div>
  </section>

  <section class="bg-[var(--color-orange)] py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-extrabold text-3xl text-white mb-4">Call our Green Valley team at (520) 408-2665</h2>
      <p class="text-orange-100 mb-7">Same-day service available · 24/7 emergency response · NATE-certified technicians</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 bg-white text-[var(--color-orange)] hover:bg-orange-50 font-bold text-lg px-8 py-4 rounded-xl transition-colors shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          (520) 408-2665
        </a>
        <a href="/contact" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white hover:bg-white hover:text-[var(--color-orange)] font-bold text-lg px-8 py-4 rounded-xl transition-colors">
          Book Online
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
