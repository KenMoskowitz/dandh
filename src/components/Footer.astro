---
const year = new Date().getFullYear();
---

<footer class="bg-[var(--color-navy)] text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Services -->
      <div>
        <h3 class="font-display font-700 text-base mb-4 text-white">Services</h3>
        <ul class="space-y-2 text-sm text-blue-200">
          <li><a href="/air-conditioning-repair" class="hover:text-white transition-colors">AC Repair</a></li>
          <li><a href="/emergency-ac-repair" class="hover:text-white transition-colors">Emergency AC Repair</a></li>
          <li><a href="/ac-installation" class="hover:text-white transition-colors">AC Installation</a></li>
          <li><a href="/ac-maintenance" class="hover:text-white transition-colors">AC Maintenance</a></li>
          <li><a href="/heating" class="hover:text-white transition-colors">Heating Repair</a></li>
          <li><a href="/furnace-repair" class="hover:text-white transition-colors">Furnace Repair</a></li>
          <li><a href="/plumbing" class="hover:text-white transition-colors">Plumbing</a></li>
          <li><a href="/family-maintenance-plan" class="hover:text-white transition-colors">Family Maintenance Plan</a></li>
        </ul>
      </div>

      <!-- Service Areas -->
      <div>
        <h3 class="font-display font-700 text-base mb-4 text-white">Service Areas</h3>
        <ul class="space-y-2 text-sm text-blue-200">
          <li><a href="/service-areas/tucson" class="hover:text-white transition-colors">Tucson</a></li>
          <li><a href="/service-areas/oro-valley" class="hover:text-white transition-colors">Oro Valley</a></li>
          <li><a href="/service-areas/marana" class="hover:text-white transition-colors">Marana</a></li>
          <li><a href="/service-areas/casas-adobes" class="hover:text-white transition-colors">Casas Adobes</a></li>
          <li><a href="/service-areas/catalina-foothills" class="hover:text-white transition-colors">Catalina Foothills</a></li>
          <li><a href="/service-areas/green-valley" class="hover:text-white transition-colors">Green Valley</a></li>
          <li><a href="/service-areas/saddlebrooke" class="hover:text-white transition-colors">Saddlebrooke</a></li>
          <li><a href="/service-areas/vail" class="hover:text-white transition-colors">Vail</a></li>
          <li><a href="/service-areas" class="hover:text-white transition-colors font-semibold">All Service Areas →</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="font-display font-700 text-base mb-4 text-white">Company</h3>
        <ul class="space-y-2 text-sm text-blue-200">
          <li><a href="/about" class="hover:text-white transition-colors">Our Story</a></li>
          <li><a href="/reviews" class="hover:text-white transition-colors">Reviews</a></li>
          <li><a href="/careers" class="hover:text-white transition-colors">Careers</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Contact</a></li>
          <li><a href="/blog" class="hover:text-white transition-colors">Blog</a></li>
        </ul>

        <!-- Social icons -->
        <div class="flex gap-3 mt-6">
          <!-- PLACEHOLDER: Replace hrefs with actual D&H social media URLs -->
          <a href="#" aria-label="Facebook" class="text-blue-200 hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="#" aria-label="Instagram" class="text-blue-200 hover:text-white transition-colors">
