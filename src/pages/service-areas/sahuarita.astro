---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const title = "AC Repair in Sahuarita, AZ — D&H Air Conditioning";
const description = "AC repair, installation & maintenance in Sahuarita, AZ. D&H Air Conditioning serves Sahuarita's growing communities with NATE-certified technicians. Call (520) 408-2665.";
const canonical = "https://dandhac.com/service-areas/sahuarita/";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dandhac.com/" },
    { "@type": "ListItem", "position": 2, "name": "Service Areas", "item": "https://dandhac.com/service-areas/" },
    { "@type": "ListItem", "position": 3, "name": "Sahuarita", "item": canonical }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "AC Repair in Sahuarita, AZ",
  "provider": {
    "@type": "HVACBusiness",
    "name": "D&H Air Conditioning & Heating & Plumbing",
    "telephone": "(520) 408-2665"
  },
  "areaServed": { "@type": "City", "name": "Sahuarita", "addressRegion": "AZ" }
};

const faqItems = [
  {
    question: "Do you serve the Rancho Sahuarita and Quail Creek areas?",
    answer: "Yes — we serve all of Sahuarita including Rancho Sahuarita, Quail Creek, and surrounding neighborhoods. These master-planned communities have a mix of newer construction and established homes, and our technicians are familiar with the systems commonly installed throughout the development. Call (520) 408-2665 to schedule in any Sahuarita neighborhood."
  },
  {
    question: "My Sahuarita home is only 5 years old — do I still need AC maintenance?",
    answer: "Absolutely. Desert conditions are uniquely harsh on HVAC equipment, regardless of age. Arizona's UV exposure, dust storms, and extreme heat cycles cause measurable wear on condenser coils, fan motors, and refrigerant lines even in newer systems. Annual tune-ups catch minor issues before they become emergency breakdowns in the middle of a July heat wave. New systems under warranty still need documented maintenance — skipping it can void the warranty."
  },
  {
    question: "Can you help me choose the right AC system for a new Sahuarita build?",
    answer: "Yes. We work with homeowners, builders, and contractors on new construction HVAC in Sahuarita. Proper equipment selection and installation from day one prevents the common issues we see with builder-grade systems — undersizing, poor duct layout, and missed efficiency opportunities. Call (520) 408-2665 to discuss your project, or visit our Daikin product pages to learn about the systems we install."
  }
];

const services = [
  "AC Repair", "Emergency AC Repair", "AC Installation", "AC Maintenance",
  "Heating Repair", "Furnace Repair", "Plumbing"
];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={[breadcrumbSchema, serviceSchema]}>

  <section class="bg-[var(--color-cloud)] border-b border-[var(--color-border)] py-14 md:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-[var(--color-muted)] mb-6">
        <a href="/" class="hover:text-[var(--color-navy)]">Home</a>
        <span class="mx-2">/</span>
        <a href="/service-areas/" class="hover:text-[var(--color-navy)]">Service Areas</a>
        <span class="mx-2">/</span>
        <span class="text-[var(--color-charcoal)] font-medium">Sahuarita</span>
      </nav>
      <h1 class="font-display font-extrabold text-4xl md:text-5xl text-[var(--color-charcoal)] leading-tight mb-4">
        AC Repair in Sahuarita, AZ —<br class="hidden md:block" /> D&H Air Conditioning
      </h1>
      <p class="text-[var(--color-muted)] text-lg md:text-xl max-w-2xl mb-8">
        Sahuarita is one of Arizona's fastest-growing communities, and D&H is already here. From new construction to maintenance on 10-year-old systems, we've got you covered south of Tucson.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-base px-6 py-4 rounded-xl transition-colors shadow-md">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          Schedule Service
        </a>
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 border-2 border-[var(--color-navy)] text-[var(--color-navy)] hover:bg-[var(--color-navy)] hover:text-white font-bold text-base px-6 py-4 rounded-xl transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call (520) 408-2665
        </a>
      </div>
    </div>
  </section>

  <section class="py-14 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">Serving Sahuarita's Growing Communities</h2>
      <p class="text-[var(--color-muted)] leading-relaxed text-lg max-w-3xl">
        Sahuarita has become one of the most desirable communities in southern Arizona, with Rancho Sahuarita, Quail Creek, and surrounding subdivisions attracting thousands of new families and retirees. D&H serves all of Sahuarita as a natural extension of our I-19 corridor route — the same route we run to Green Valley. New homeowners here often call us to assess the systems their home came with, while established residents rely on us for maintenance and emergency repairs when the desert heat peaks.
      </p>
    </div>
  </section>

  <section class="py-14 bg-[var(--color-cloud)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-6">Services We Offer in Sahuarita</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        {services.map(service => (
          <div class="flex items-center gap-3 bg-white rounded-xl px-5 py-4 border border-[var(--color-border)] shadow-sm">
            <svg class="shrink-0 text-[var(--color-success)]" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="font-semibold text-[var(--color-charcoal)]">{service}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">How Close Are We?</h2>
      <div class="bg-[var(--color-cloud)] rounded-2xl p-6 border border-[var(--color-border)] max-w-lg">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-[var(--color-navy)] flex items-center justify-center shrink-0">
            <svg class="text-white" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <p class="font-bold text-[var(--color-charcoal)] text-lg">~20 miles south · approximately 25 minutes</p>
            <p class="text-[var(--color-muted)] text-sm mt-1">Sahuarita is a quick, direct drive south from our Evans Blvd base — straight down I-19. It's on our regular south-corridor route, which means service vehicles are in the area frequently. Same-day scheduling is available for most Sahuarita calls, especially when booked before noon.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 bg-[var(--color-cloud)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">Sahuarita's Climate — Modern Homes, Desert Demands</h2>
      <p class="text-[var(--color-muted)] leading-relaxed text-lg max-w-3xl">
        Sahuarita's growing communities have many newer homes with modern HVAC systems that still need expert service. The desert environment is unforgiving — UV radiation degrades outdoor unit components, dust accumulates on evaporator coils, and the sheer number of operating hours during Tucson-area summers accelerates wear on every component. Even a 5-year-old system in Sahuarita may have seen the equivalent wear of a 10-year-old system in a milder climate. Annual maintenance isn't optional here — it's the difference between a system that runs efficiently for 15+ years and one that fails unexpectedly at year 8.
      </p>
    </div>
  </section>

  <section class="py-10 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- PLACEHOLDER: Add local Sahuarita Google Reviews here -->
      <div class="bg-[var(--color-cloud)] border-2 border-dashed border-[var(--color-border)] rounded-2xl p-8 text-center text-[var(--color-muted)]">
        <p class="font-semibold mb-1">Local Reviews — Sahuarita</p>
        <p class="text-sm">Google Reviews widget or manual review cards go here.</p>
      </div>
    </div>
  </section>

  <TrustBadges />

  <section class="py-14 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-6">Frequently Asked Questions — Sahuarita</h2>
      <FAQAccordion items={faqItems} id="faq-sahuarita" />
    </div>
  </section>

  <section class="bg-[var(--color-orange)] py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-extrabold text-3xl text-white mb-4">Call our Sahuarita team at (520) 408-2665</h2>
      <p class="text-orange-100 mb-7">Same-day service available · 24/7 emergency response · NATE-certified technicians</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 bg-white text-[var(--color-orange)] hover:bg-orange-50 font-bold text-lg px-8 py-4 rounded-xl transition-colors shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          (520) 408-2665
        </a>
        <a href="/contact" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white hover:bg-white hover:text-[var(--color-orange)] font-bold text-lg px-8 py-4 rounded-xl transition-colors">
          Book Online
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
