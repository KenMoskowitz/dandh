---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const title = "Daikin Air Conditioning Systems in Tucson | D&H Daikin Dealer";
const description = "D&H Air Conditioning is Tucson's authorized Daikin Comfort Pro dealer. 12-year parts warranty, advanced technology, and the best HVAC systems available. Call (520) 408-2665.";
const canonical = "https://dandhac.com/products/daikin/";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dandhac.com/" },
    { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://dandhac.com/products/" },
    { "@type": "ListItem", "position": 3, "name": "Daikin", "item": canonical }
  ]
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "HVACBusiness",
  "name": "D&H Air Conditioning & Heating & Plumbing",
  "url": "https://dandhac.com",
  "telephone": "(520) 408-2665",
  "description": "Authorized Daikin Comfort Pro dealer serving greater Tucson, AZ since 1959.",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Daikin HVAC Systems",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Daikin Central Air Conditioning" } },
      { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Daikin Heat Pumps" } },
      { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Daikin Mini-Split Systems" } },
      { "@type": "Offer", "itemOffered": { "@type": "Product", "name": "Daikin Gas Furnaces" } }
    ]
  }
};

const productLine = [
  {
    name: "Central Air Conditioning",
    href: "/air-conditioning-repair",
    description: "Whole-home central AC systems for Tucson's climate. Daikin's central AC lineup includes single-stage, two-stage, and variable-speed options from 13 to 20+ SEER.",
    highlight: "Up to 19+ SEER"
  },
  {
    name: "Heat Pumps",
    href: "/products/heat-pumps/",
    description: "One system for both heating and cooling. The Daikin DZ18VC variable-speed heat pump is our flagship whole-home comfort system — efficient, quiet, and backed by the industry's best warranty.",
    highlight: "Up to 19 SEER · Qualifies for IRA tax credit"
  },
  {
    name: "Mini-Split Systems",
    href: "/products/mini-splits/",
    description: "Ductless comfort for any space — room additions, garages, sunrooms, and whole-home zoning. Up to 26.1 SEER with heating capability down to -4°F.",
    highlight: "Up to 26.1 SEER · No ductwork needed"
  },
  {
    name: "Gas Furnaces",
    href: "/products/gas-furnaces/",
    description: "Reliable winter heating for Tucson homes. The Daikin DM96HS features 96% AFUE, two-stage operation, and a stainless steel heat exchanger for long-lasting performance.",
    highlight: "96% AFUE · Two-stage operation"
  },
];

const warrantyFeatures = [
  { title: "12-year parts warranty", detail: "On all Daikin equipment registered within 60 days of installation — the most comprehensive parts coverage in the HVAC industry." },
  { title: "12-year compressor warranty", detail: "The compressor is the heart of your system and the most expensive component to replace. Daikin's 12-year compressor coverage is industry-leading." },
  { title: "Daikin Comfort Pro installation required", detail: "These warranties only apply when the equipment is installed by an authorized Daikin Comfort Pro dealer. D&H is one — other contractors may not be." },
  { title: "No fine print surprises", detail: "Register your equipment online within 60 days and your warranty is locked in. We handle the registration process as part of every installation." },
];

const whyOnlyDaikin = [
  "We've installed and serviced every major HVAC brand over 65 years. Daikin consistently outperforms them on reliability, efficiency, and warranty support.",
  "Daikin manufactures its own components — compressors, motors, controls — rather than assembling parts from multiple suppliers. This means better quality control and genuine parts availability.",
  "The Daikin Comfort Pro program gives D&H direct access to Daikin technical support, genuine parts, and factory training — advantages that translate directly to better service for our customers.",
  "Daikin's 12-year parts and compressor warranty is the best in the business. No other manufacturer we've evaluated comes close. When something goes wrong after year 5, the difference matters enormously.",
  "We stand behind what we install. Offering a single brand means we know the product intimately, train our technicians specifically on it, and can make stronger guarantees about installation quality.",
];

const faqItems = [
  {
    question: "Is Daikin equipment better than other brands?",
    answer: "In our experience across 65+ years of installing and servicing HVAC equipment, yes — Daikin is the best combination of reliability, efficiency, and warranty coverage available today. Daikin manufactures its own compressors and key components, which gives them quality control advantages over brands that assemble from multiple suppliers. Their inverter technology is among the most advanced available, and their warranty program is the most comprehensive in the industry."
  },
  {
    question: "What does being a Daikin Comfort Pro dealer mean for me?",
    answer: "Daikin Comfort Pro dealers are authorized, vetted installers with direct access to factory training, technical support, and genuine Daikin parts. This authorization is required to provide the full 12-year parts warranty. When D&H installs your Daikin system, you get the complete warranty protection that a non-authorized installer cannot offer. You're also working with technicians who have been trained specifically on Daikin systems by Daikin."
  },
  {
    question: "Do you service other AC brands even though you install Daikin?",
    answer: "Yes — we repair and maintain all major HVAC brands including Carrier, Trane, Lennox, Rheem, York, Goodman, and 20+ others. Our policy of installing Daikin exclusively doesn't affect our service capabilities. If you have an existing system from another manufacturer, we'll maintain and repair it honestly and competently. When it's time for replacement, we'll recommend Daikin — because that's what we believe in."
  },
  {
    question: "How do I register my Daikin warranty after installation?",
    answer: "D&H handles the warranty registration as part of every installation. We submit your registration to Daikin within the required 60-day window. You'll receive a confirmation, and your 12-year coverage is then in effect. If you purchased a Daikin system from another installer and haven't registered it, call us at (520) 408-2665 — we may be able to help you navigate the registration process."
  }
];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={[breadcrumbSchema, organizationSchema]}>

  <!-- Hero -->
  <section class="bg-[var(--color-navy)] hero-pattern py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-blue-300 mb-6">
        <a href="/" class="hover:text-white">Home</a>
        <span class="mx-2">/</span>
        <a href="/products/" class="hover:text-white">Products</a>
        <span class="mx-2">/</span>
        <span class="text-blue-100">Daikin</span>
      </nav>
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 bg-blue-800/50 text-blue-200 text-xs font-semibold px-3 py-1.5 rounded-full mb-5">
          Authorized Daikin Comfort Pro Dealer · Tucson's Daikin Experts
        </div>
        <h1 class="font-display font-extrabold text-4xl md:text-5xl text-white leading-tight mb-5">
          Daikin — D&H's Exclusive<br class="hidden md:block" /> Brand Partner
        </h1>
        <p class="text-blue-200 text-lg md:text-xl leading-relaxed mb-8">
          After 65+ years of installing every major HVAC brand, we made a decision: Daikin is the best. We install Daikin exclusively — not because we have to, but because we believe in it.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-base px-6 py-4 rounded-xl transition-colors shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
            Get a Free Estimate
          </a>
          <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white hover:bg-white hover:text-[var(--color-navy)] font-bold text-base px-6 py-4 rounded-xl transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call (520) 408-2665
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why D&H Chose Daikin -->
  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <h2 class="font-display font-extrabold text-3xl text-[var(--color-charcoal)] mb-4">Why we chose Daikin</h2>
          <p class="text-[var(--color-muted)] leading-relaxed mb-4">
            D&H has been in the HVAC business since 1959. Over 65+ years, we've installed and serviced Carrier, Trane, Lennox, York, Goodman, Rheem, and two dozen other brands. We know what good looks like — and we know what problems show up at year 8, 10, and 12 for every major manufacturer.
          </p>
          <p class="text-[var(--color-muted)] leading-relaxed mb-4">
            Daikin is different. As the world's largest HVAC manufacturer, Daikin produces its own compressors, motors, and control boards — giving them quality control that assembled-from-parts brands can't match. Their inverter technology leads the industry. Their warranty coverage is the most comprehensive available. And in the years since we became a Daikin Comfort Pro dealer, we've seen the difference in reliability and customer satisfaction firsthand.
          </p>
          <p class="text-[var(--color-muted)] leading-relaxed">
            Installing one brand exclusively also makes us better at it. Our technicians are trained specifically on Daikin. Our trucks carry Daikin parts. When something needs attention, we know the system inside and out. That depth of knowledge translates to better installations, better service, and better outcomes for every customer we serve.
          </p>
        </div>
        <div class="space-y-4">
          <div class="bg-[var(--color-cloud)] rounded-2xl p-5 border border-[var(--color-border)]">
            <p class="font-display font-bold text-[var(--color-charcoal)] mb-1">World's largest HVAC manufacturer</p>
            <p class="text-sm text-[var(--color-muted)]">Daikin operates in 150+ countries and produces more HVAC equipment than any other company on earth. That scale drives R&D and quality control advantages that smaller manufacturers can't match.</p>
          </div>
          <div class="bg-[var(--color-cloud)] rounded-2xl p-5 border border-[var(--color-border)]">
            <p class="font-display font-bold text-[var(--color-charcoal)] mb-1">Manufactures its own key components</p>
            <p class="text-sm text-[var(--color-muted)]">Daikin makes its own inverter compressors, heat exchangers, and control systems — rather than sourcing from third-party suppliers. This vertical integration produces higher consistency and fewer failures.</p>
          </div>
          <div class="bg-[var(--color-cloud)] rounded-2xl p-5 border border-[var(--color-border)]">
            <p class="font-display font-bold text-[var(--color-charcoal)] mb-1">Inverter technology leadership</p>
            <p class="text-sm text-[var(--color-muted)]">Daikin pioneered inverter-driven compressors for residential HVAC. Their variable-speed technology delivers superior comfort, efficiency, and reliability compared to conventional on/off systems.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Warranty Section -->
  <section class="py-16 bg-[var(--color-cloud)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-display font-extrabold text-3xl text-[var(--color-charcoal)] mb-3">The best warranty in HVAC</h2>
        <p class="text-[var(--color-muted)] max-w-2xl mx-auto">Daikin's warranty program is the most comprehensive in the residential HVAC industry — and it's only available through authorized Daikin Comfort Pro dealers like D&H.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-5 mb-8">
        {warrantyFeatures.map(w => (
          <div class="bg-white rounded-2xl p-6 border border-[var(--color-border)] shadow-sm">
            <div class="flex items-start gap-3">
              <svg class="shrink-0 mt-0.5 text-[var(--color-success)]" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <div>
                <p class="font-display font-bold text-[var(--color-charcoal)] mb-1">{w.title}</p>
                <p class="text-sm text-[var(--color-muted)] leading-relaxed">{w.detail}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="bg-[var(--color-navy)] text-white rounded-2xl p-6 text-center">
        <p class="font-display font-bold text-lg mb-2">Important: Warranty only applies with authorized installation</p>
        <p class="text-blue-200 text-sm max-w-2xl mx-auto">Daikin's 12-year warranty requires installation by an authorized Daikin Comfort Pro dealer. If you buy Daikin equipment from an unauthorized installer, you receive the standard 5-year warranty — not 12 years. D&H is Tucson's authorized Daikin Comfort Pro dealer.</p>
      </div>
    </div>
  </section>

  <!-- Product Lineup -->
  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-display font-extrabold text-3xl text-[var(--color-charcoal)] mb-3">The Daikin product lineup at D&H</h2>
        <p class="text-[var(--color-muted)] max-w-xl mx-auto">One brand, four system types — covering every Tucson home's comfort needs, from a room addition to a full whole-home replacement.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-5">
        {productLine.map(product => (
          <a href={product.href} class="group bg-[var(--color-cloud)] rounded-2xl p-6 border border-[var(--color-border)] hover:border-[var(--color-sky)] hover:shadow-md transition-all">
            <div class="flex items-start justify-between mb-3">
              <div class="w-10 h-10 rounded-xl bg-[var(--color-navy)] flex items-center justify-center">
                <svg class="text-white" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
              </div>
              <span class="text-xs font-bold text-[var(--color-sky)] bg-white px-2 py-1 rounded-full border border-[var(--color-border)]">{product.highlight}</span>
            </div>
            <h3 class="font-display font-bold text-[var(--color-charcoal)] text-lg mb-2 group-hover:text-[var(--color-navy)] transition-colors">{product.name}</h3>
            <p class="text-sm text-[var(--color-muted)] leading-relaxed mb-3">{product.description}</p>
            <p class="text-sm font-semibold text-[var(--color-sky)] group-hover:text-[var(--color-navy)] transition-colors">Learn more →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Only Daikin Manifesto -->
  <section class="py-16 bg-[var(--color-navy)]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-display font-extrabold text-3xl text-white mb-3">Why we only install Daikin</h2>
        <p class="text-blue-200 max-w-xl mx-auto">This isn't a marketing position. It's a conclusion we reached after 65 years in this business.</p>
      </div>
      <ul class="space-y-5">
        {whyOnlyDaikin.map((reason, i) => (
          <li class="flex items-start gap-4">
            <div class="w-8 h-8 rounded-full bg-[var(--color-orange)] text-white font-bold text-sm flex items-center justify-center shrink-0 mt-0.5">{i + 1}</div>
            <p class="text-blue-100 leading-relaxed">{reason}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Trust Badges -->
  <TrustBadges />

  <!-- FAQ -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-extrabold text-3xl text-[var(--color-charcoal)] mb-8 text-center">Daikin & D&H FAQs</h2>
      <FAQAccordion items={faqItems} id="faq-daikin" />
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-[var(--color-orange)] py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-extrabold text-3xl text-white mb-4">Ready to experience the Daikin difference?</h2>
      <p class="text-orange-100 mb-7">Call D&H at (520) 408-2665 for a free system assessment. We'll recommend the right Daikin system for your home, your budget, and your comfort goals — with no pressure and no surprises on the bill.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 bg-white text-[var(--color-orange)] hover:bg-orange-50 font-bold text-lg px-8 py-4 rounded-xl transition-colors shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          (520) 408-2665
        </a>
        <a href="/contact" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white hover:bg-white hover:text-[var(--color-orange)] font-bold text-lg px-8 py-4 rounded-xl transition-colors">
          Get a Free Estimate Online
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
