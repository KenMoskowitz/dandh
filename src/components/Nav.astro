---
const navItems = [
  {
    label: 'Cooling',
    href: '/air-conditioning-repair',
    children: [
      { label: 'AC Repair', href: '/air-conditioning-repair' },
      { label: 'Emergency AC Repair', href: '/emergency-ac-repair' },
      { label: 'AC Installation', href: '/ac-installation' },
      { label: 'AC Maintenance', href: '/ac-maintenance' },
      { label: 'Mini-Splits', href: '/products/mini-splits' },
    ],
  },
  {
    label: 'Heating',
    href: '/heating',
    children: [
      { label: 'Heating Repair', href: '/heating' },
      { label: 'Furnace Repair', href: '/furnace-repair' },
      { label: 'Gas Furnaces', href: '/products/gas-furnaces' },
      { label: 'Heat Pumps', href: '/products/heat-pumps' },
    ],
  },
  {
    label: 'Plumbing',
    href: '/plumbing',
    children: [],
  },
  {
    label: 'Specials',
    href: '/family-maintenance-plan',
    children: [
      { label: 'Family Maintenance Plan', href: '/family-maintenance-plan' },
      { label: 'Financing', href: '/ac-installation#financing' },
    ],
  },
  {
    label: 'About',
    href: '/about',
    children: [
      { label: 'Our Story', href: '/about' },
      { label: 'Reviews', href: '/reviews' },
      { label: 'Service Areas', href: '/service-areas' },
      { label: 'Careers', href: '/careers' },
      { label: 'Contact', href: '/contact' },
    ],
  },
];
---

<header
  class="sticky top-0 z-50 bg-white border-b border-[var(--color-border)] shadow-sm"
  x-data="{ mobileOpen: false }"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 shrink-0">
        <!-- PLACEHOLDER: Replace this text logo with real D&H SVG logo -->
        <div class="flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-sky)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12a5 5 0 0 0 5 5 8 8 0 0 1 5 2 8 8 0 0 1 5-2 5 5 0 0 0 5-5V7h-5a8 8 0 0 0-5 2 8 8 0 0 0-5-2H2Z"/><path d="M6 11c1.5 0 3 .5 3 2-2 0-3 0-3-2Z"/><path d="M18 11c-1.5 0-3 .5-3 2 2 0 3 0 3-2Z"/></svg>
          <span class="font-display font-800 text-xl text-[var(--color-navy)] leading-none">D&amp;H</span>
          <span class="hidden sm:inline text-sm font-medium text-[var(--color-muted)] leading-none">Air Conditioning</span>
        </div>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-1">
        {navItems.map(item => (
          <div class="relative group">
            <a
              href={item.href}
              class="flex items-center gap-0.5 px-3 py-2 text-sm font-medium text-[var(--color-charcoal)] hover:text-[var(--color-navy)] rounded-md transition-colors"
            >
              {item.label}
              {item.children.length > 0 && (
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              )}
            </a>
            {item.children.length > 0 && (
              <div class="absolute top-full left-0 pt-1 hidden group-hover:block">
                <div class="bg-white border border-[var(--color-border)] rounded-xl shadow-lg py-2 min-w-[200px]">
                  {item.children.map(child => (
                    <a
                      href={child.href}
                      class="block px-4 py-2 text-sm text-[var(--color-charcoal)] hover:bg-[var(--color-cloud)] hover:text-[var(--color-navy)] transition-colors"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
      </nav>

      <!-- Desktop right: phone + CTA -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href="tel:5204082665"
          class="flex items-center gap-1.5 font-bold text-[var(--color-navy)] text-sm hover:text-[var(--color-sky)] transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          (520) 408-2665
        </a>
        <a
          href="/contact"
          class="bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-sm px-4 py-2 rounded-lg transition-colors"
        >
          Book Now
        </a>
      </div>

      <!-- Mobile hamburger -->
      <button
        @click="mobileOpen = !mobileOpen"
        class="md:hidden p-2 rounded-md text-[var(--color-charcoal)] hover:bg-[var(--color-cloud)]"
        aria-label="Toggle menu"
      >
        <svg x-show="!mobileOpen" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        <svg x-show="mobileOpen" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    x-show="mobileOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-2"
    class="md:hidden bg-white border-t border-[var(--color-border)] pb-4 pb-safe"
  >
    {navItems.map(item => (
      <div x-data="{ open: false }">
        <button
          @click="open = !open"
          class="w-full flex items-center justify-between px-6 py-3 text-sm font-semibold text-[var(--color-charcoal)] hover:bg-[var(--color-cloud)]"
        >
          <span>{item.label}</span>
          {item.children.length > 0 && (
            <svg :class="open ? 'rotate-180' : ''" class="transition-transform" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          )}
        </button>
        {item.children.length > 0 && (
          <div x-show="open" class="bg-[var(--color-cloud)]">
            {item.children.map(child => (
              <a
                href={child.href}
                class="block px-10 py-2.5 text-sm text-[var(--color-charcoal)] hover:text-[var(--color-navy)]"
              >
                {child.label}
              </a>
            ))}
          </div>
        )}
        {item.children.length === 0 && (
          <a href={item.href} class="block px-6 py-3 text-sm text-[var(--color-charcoal)] hover:bg-[var(--color-cloud)]" />
        )}
      </div>
    ))}
    <div class="px-6 pt-3 border-t border-[var(--color-border)] mt-2">
      <a href="tel:5204082665" class="flex items-center gap-2 font-bold text-[var(--color-navy)] text-sm mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        (520) 408-2665
      </a>
    </div>
  </div>
</header>
