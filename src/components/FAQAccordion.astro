---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
  id?: string;
}

const { items, id = 'faq' } = Astro.props;
---

<div id={id} class="divide-y divide-[var(--color-border)]">
  {items.map((item, i) => (
    <div x-data="{ open: false }" class="py-4">
      <button
        @click="open = !open"
        class="w-full flex items-start justify-between gap-4 text-left group"
        aria-expanded="false"
        :aria-expanded="open.toString()"
      >
        <span class="font-display font-600 text-[var(--color-charcoal)] text-base group-hover:text-[var(--color-navy)] transition-colors">
          {item.question}
        </span>
        <svg
          :class="open ? 'rotate-180' : ''"
          class="shrink-0 mt-0.5 text-[var(--color-muted)] transition-transform duration-200"
          xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        >
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </button>
      <div
        x-show="open"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 -translate-y-1"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100 translate-y-0"
        x-transition:leave-end="opacity-0 -translate-y-1"
        class="mt-3 text-[var(--color-muted)] text-sm leading-relaxed pr-8"
      >
        {item.answer}
      </div>
    </div>
  ))}
</div>
