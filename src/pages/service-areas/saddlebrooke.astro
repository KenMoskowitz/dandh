---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const title = "AC Repair in SaddleBrooke, AZ — D&H Air Conditioning";
const description = "AC repair & HVAC service for SaddleBrooke Ranch. D&H understands the unique demands of SaddleBrooke's elevation and heat pump systems. Call (520) 408-2665.";
const canonical = "https://dandhac.com/service-areas/saddlebrooke/";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dandhac.com/" },
    { "@type": "ListItem", "position": 2, "name": "Service Areas", "item": "https://dandhac.com/service-areas/" },
    { "@type": "ListItem", "position": 3, "name": "SaddleBrooke", "item": canonical }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "AC Repair in SaddleBrooke, AZ",
  "provider": {
    "@type": "HVACBusiness",
    "name": "D&H Air Conditioning & Heating & Plumbing",
    "telephone": "(520) 408-2665"
  },
  "areaServed": { "@type": "City", "name": "SaddleBrooke", "addressRegion": "AZ" }
};

const faqItems = [
  {
    question: "Why does my heat pump in SaddleBrooke behave differently than my old system in Phoenix?",
    answer: "Elevation makes a real difference. SaddleBrooke sits at 3,000+ feet, which means colder winter temperatures and thinner air that affects heat pump efficiency. A heat pump that was perfectly sized for a Phoenix home may struggle in SaddleBrooke's winter conditions. Our technicians evaluate your system's performance in the context of your elevation and can recommend adjustments, supplemental heat, or a more appropriate system if needed."
  },
  {
    question: "Can D&H service my system at SaddleBrooke Ranch specifically?",
    answer: "Yes. We serve SaddleBrooke Ranch, SaddleBrooke TWO, and the broader SaddleBrooke community. Our technicians are familiar with the HOA-compliant equipment standards and the types of systems commonly installed in the development. We also understand the community's seasonal occupancy patterns and offer flexible scheduling for snowbird residents."
  },
  {
    question: "What's the best way to maintain my HVAC system at SaddleBrooke given the distance from Tucson?",
    answer: "The Family Maintenance Plan is the ideal solution for SaddleBrooke homeowners. Two scheduled tune-ups per year mean we're proactively checking your system before summer and winter, catching issues before they become emergencies. Priority dispatch means that if something does go wrong, you're at the top of the list. Call (520) 408-2665 to enroll and save on all future service."
  }
];

const services = [
  "AC Repair", "Emergency AC Repair", "AC Installation", "AC Maintenance",
  "Heating Repair", "Furnace Repair", "Plumbing"
];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={[breadcrumbSchema, serviceSchema]}>

  <section class="bg-gradient-to-br from-[var(--color-navy)] to-[var(--color-navy-dark)] hero-pattern py-14 md:py-20 relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-1.5 text-xs text-blue-400 mb-6">
        <a href="/" class="hover:text-blue-200 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/service-areas/" class="hover:text-blue-200 transition-colors">Service Areas</a>
        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-blue-200 font-medium">SaddleBrooke</span>
      </nav>
      <h1 class="font-display font-extrabold text-4xl md:text-5xl text-white leading-[1.05] mb-4">
        AC Repair in SaddleBrooke, AZ —<br class="hidden md:block" /> D&H Air Conditioning
      </h1>
      <p class="text-blue-200 text-lg md:text-xl max-w-2xl mb-8">
        SaddleBrooke's elevation and retirement community deserve HVAC service that understands both. D&H brings the expertise — and the drive — to keep your home comfortable year-round.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-base px-6 py-4 rounded-xl transition-colors shadow-md">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          Schedule Service
        </a>
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 border-2 border-white/30 text-white hover:bg-white/10 font-bold text-base px-6 py-4 rounded-xl transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call (520) 408-2665
        </a>
      </div>
    </div>
  </section>

  <section class="py-14 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">Serving SaddleBrooke's Active Adult Community</h2>
      <p class="text-[var(--color-muted)] leading-relaxed text-lg max-w-3xl">
        SaddleBrooke Ranch and the broader SaddleBrooke community represent some of Arizona's most thoughtfully designed retirement living. The homes are well-built, the community is tightly managed, and the expectations for service providers are high. D&H meets those expectations — with NATE-certified technicians who arrive on time, explain everything clearly, and leave your home as clean as they found it. We've served this community for years and understand the specific equipment, HOA requirements, and service preferences that SaddleBrooke residents expect.
      </p>
    </div>
  </section>

  <section class="py-14 bg-[var(--color-cloud)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-6">Services We Offer in SaddleBrooke</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        {services.map(service => (
          <div class="flex items-center gap-3 bg-white rounded-xl px-5 py-4 border border-[var(--color-border)] shadow-sm">
            <svg class="shrink-0 text-[var(--color-success)]" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="font-semibold text-[var(--color-charcoal)]">{service}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">How Close Are We?</h2>
      <div class="bg-[var(--color-cloud)] rounded-2xl p-6 border border-[var(--color-border)] max-w-lg">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-[var(--color-navy)] flex items-center justify-center shrink-0">
            <svg class="text-white" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <p class="font-bold text-[var(--color-charcoal)] text-lg">~30 miles north · approximately 40 minutes</p>
            <p class="text-[var(--color-muted)] text-sm mt-1">SaddleBrooke is our furthest-north service area, approximately 40 minutes up Oracle Road from Evans Blvd. We make this run regularly and consider SaddleBrooke well within our service territory. Enrolled Family Maintenance Plan members receive priority dispatch, which can substantially reduce wait times for this location.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 bg-[var(--color-cloud)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">SaddleBrooke's Elevation — A Different Kind of HVAC Challenge</h2>
      <p class="text-[var(--color-muted)] leading-relaxed text-lg max-w-3xl">
        SaddleBrooke's higher elevation means your heat pump operates differently than systems in central Tucson — our technicians understand the difference. At this altitude, winter heating loads are significantly heavier, and heat pumps must work harder to extract heat from colder outdoor air. Systems that were properly sized for lower elevations may be undersized here. We evaluate your system's actual performance data, not just the nameplate specifications, to determine whether your equipment is truly meeting your home's needs at SaddleBrooke's elevation.
      </p>
    </div>
  </section>

  <section class="py-10 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- PLACEHOLDER: Add local SaddleBrooke Google Reviews here -->
      <div class="bg-[var(--color-cloud)] border-2 border-dashed border-[var(--color-border)] rounded-2xl p-8 text-center text-[var(--color-muted)]">
        <p class="font-semibold mb-1">Local Reviews — SaddleBrooke</p>
        <p class="text-sm">Google Reviews widget or manual review cards go here.</p>
      </div>
    </div>
  </section>

  <TrustBadges />

  <section class="py-14 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-6">Frequently Asked Questions — SaddleBrooke</h2>
      <FAQAccordion items={faqItems} id="faq-saddlebrooke" />
    </div>
  </section>

  <section class="bg-[var(--color-orange)] py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-extrabold text-3xl text-white mb-4">Call our SaddleBrooke team at (520) 408-2665</h2>
      <p class="text-orange-100 mb-7">Service available 7 days a week · 24/7 emergency response · NATE-certified technicians</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 bg-white text-[var(--color-orange)] hover:bg-orange-50 font-bold text-lg px-8 py-4 rounded-xl transition-colors shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          (520) 408-2665
        </a>
        <a href="/contact" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white hover:bg-white hover:text-[var(--color-orange)] font-bold text-lg px-8 py-4 rounded-xl transition-colors">
          Book Online
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
