---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const city = "Oro Valley";
const title = "AC Repair in Oro Valley, AZ — D&H Air Conditioning";
const description = "Expert AC repair, installation & maintenance in Oro Valley, AZ. D&H serves Oro Valley from our Tucson headquarters — NATE-certified technicians, same-day service. Call (520) 408-2665.";
const canonical = "https://dandhac.com/service-areas/oro-valley/";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dandhac.com/" },
    { "@type": "ListItem", "position": 2, "name": "Service Areas", "item": "https://dandhac.com/service-areas/" },
    { "@type": "ListItem", "position": 3, "name": "Oro Valley", "item": canonical }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "AC Repair in Oro Valley, AZ",
  "provider": {
    "@type": "HVACBusiness",
    "name": "D&H Air Conditioning & Heating & Plumbing",
    "telephone": "(520) 408-2665",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "3990 S Evans Blvd",
      "addressLocality": "Tucson",
      "addressRegion": "AZ",
      "postalCode": "85714",
      "addressCountry": "US"
    }
  },
  "areaServed": { "@type": "City", "name": "Oro Valley", "addressRegion": "AZ" },
  "description": "Full HVAC services including AC repair, emergency repair, installation, maintenance, heating, and plumbing in Oro Valley, AZ."
};

const faqItems = [
  {
    question: "Do you service heat pumps in Oro Valley?",
    answer: "Absolutely. Heat pumps are common in Oro Valley due to the area's milder winter temperatures compared to central Tucson. Our technicians are trained on all major heat pump brands and understand the demands of Oro Valley's elevation. We handle repairs, maintenance, and full system replacements."
  },
  {
    question: "How quickly can you respond to an AC emergency in Oro Valley?",
    answer: "From our Evans Blvd headquarters, Oro Valley is approximately 25 minutes away. For emergency calls, we aim to have a tech on-site within 2–4 hours. We maintain trucks in the north Tucson corridor, which often means faster response times than our baseline estimate."
  },
  {
    question: "Do you offer seasonal AC tune-ups in Oro Valley?",
    answer: "Yes — and we strongly recommend them, especially before summer. Our Family Maintenance Plan covers two tune-ups per year, priority dispatch, 10% off repairs, and no after-hours surcharges. Oro Valley homes at higher elevation can develop unique wear patterns that a trained eye catches early. Call (520) 408-2665 to enroll."
  }
];

const services = [
  "AC Repair", "Emergency AC Repair", "AC Installation", "AC Maintenance",
  "Heating Repair", "Furnace Repair", "Plumbing"
];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={[breadcrumbSchema, serviceSchema]}>

  <!-- Hero -->
  <section class="bg-[var(--color-cloud)] border-b border-[var(--color-border)] py-14 md:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-[var(--color-muted)] mb-6">
        <a href="/" class="hover:text-[var(--color-navy)]">Home</a>
        <span class="mx-2">/</span>
        <a href="/service-areas/" class="hover:text-[var(--color-navy)]">Service Areas</a>
        <span class="mx-2">/</span>
        <span class="text-[var(--color-charcoal)] font-medium">Oro Valley</span>
      </nav>
      <h1 class="font-display font-extrabold text-4xl md:text-5xl text-[var(--color-charcoal)] leading-tight mb-4">
        AC Repair in Oro Valley, AZ —<br class="hidden md:block" /> D&H Air Conditioning
      </h1>
      <p class="text-[var(--color-muted)] text-lg md:text-xl max-w-2xl mb-8">
        Oro Valley homeowners trust D&H for everything HVAC — from routine maintenance to emergency same-day repairs. We've been serving northern Tucson communities since the 1970s, and we know exactly what your system faces here.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-base px-6 py-4 rounded-xl transition-colors shadow-md">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          Schedule Service
        </a>
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 border-2 border-[var(--color-navy)] text-[var(--color-navy)] hover:bg-[var(--color-navy)] hover:text-white font-bold text-base px-6 py-4 rounded-xl transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call (520) 408-2665
        </a>
      </div>
    </div>
  </section>

  <!-- Serving Since -->
  <section class="py-14 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">Serving Oro Valley Since the 1970s</h2>
      <p class="text-[var(--color-muted)] leading-relaxed text-lg max-w-3xl">
        As Oro Valley grew from a small community north of Tucson into one of Arizona's most desirable planned towns, D&H grew with it. We've maintained, repaired, and installed HVAC systems in Oro Valley neighborhoods for decades — from the older homes near Oracle Road to the newer developments along Tangerine and Moore. Our technicians know the area, know the common equipment installed in local homes, and know what problems show up most often at Oro Valley's elevation.
      </p>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-14 bg-[var(--color-cloud)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-6">Services We Offer in Oro Valley</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        {services.map(service => (
          <div class="flex items-center gap-3 bg-white rounded-xl px-5 py-4 border border-[var(--color-border)] shadow-sm">
            <svg class="shrink-0 text-[var(--color-success)]" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="font-semibold text-[var(--color-charcoal)]">{service}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How Close Are We -->
  <section class="py-14 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">How Close Are We?</h2>
      <div class="bg-[var(--color-cloud)] rounded-2xl p-6 border border-[var(--color-border)] max-w-lg">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-[var(--color-navy)] flex items-center justify-center shrink-0">
            <svg class="text-white" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <p class="font-bold text-[var(--color-charcoal)] text-lg">~15 miles · approximately 25 minutes</p>
            <p class="text-[var(--color-muted)] text-sm mt-1">From our Evans Blvd headquarters to central Oro Valley is a straightforward 25-minute drive north on Oracle Road. We have service vehicles that regularly run this corridor, so emergency response times are often faster than our quoted estimate.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Climate Note -->
  <section class="py-14 bg-[var(--color-cloud)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">Oro Valley's Climate — What Makes It Different</h2>
      <p class="text-[var(--color-muted)] leading-relaxed text-lg max-w-3xl">
        Oro Valley sits at a slightly higher elevation than central Tucson, with nighttime temperatures that can stress heat pumps in winter — especially during cold snaps that push below freezing for extended periods. While summer cooling demands are similar to Tucson, the winter heating cycle is more pronounced here, and heat pumps that aren't properly maintained can struggle to keep up when outdoor temps drop into the 20s. Our technicians understand the full-year HVAC demands of Oro Valley homes and can optimize your system for both extremes.
      </p>
    </div>
  </section>

  <!-- Reviews Placeholder -->
  <section class="py-10 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- PLACEHOLDER: Add local Oro Valley Google Reviews here -->
      <div class="bg-[var(--color-cloud)] border-2 border-dashed border-[var(--color-border)] rounded-2xl p-8 text-center text-[var(--color-muted)]">
        <p class="font-semibold mb-1">Local Reviews — Oro Valley</p>
        <p class="text-sm">Google Reviews widget or manual review cards go here.</p>
      </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <TrustBadges />

  <!-- FAQ -->
  <section class="py-14 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-6">Frequently Asked Questions — Oro Valley</h2>
      <FAQAccordion items={faqItems} id="faq-oro-valley" />
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-[var(--color-orange)] py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-extrabold text-3xl text-white mb-4">Call our Oro Valley team at (520) 408-2665</h2>
      <p class="text-orange-100 mb-7">Same-day service available · 24/7 emergency response · NATE-certified technicians</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 bg-white text-[var(--color-orange)] hover:bg-orange-50 font-bold text-lg px-8 py-4 rounded-xl transition-colors shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          (520) 408-2665
        </a>
        <a href="/contact" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white hover:bg-white hover:text-[var(--color-orange)] font-bold text-lg px-8 py-4 rounded-xl transition-colors">
          Book Online
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
