---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBadges from '../components/TrustBadges.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

const title = "New AC Installation in Tucson, AZ | D&H Air Conditioning";
const description = "New AC installation in Tucson by D&H. Right-sized systems, permit-ready, 0% financing available. NATE-certified. Call (520) 408-2665.";
const canonical = "https://dandhac.com/ac-installation";

const faqItems = [
  { question: "How long does installation take?", answer: "Most installations are completed in one day. Larger systems or complex setups may require two days." },
  { question: "What size AC do I need?", answer: "Size depends on your home's square footage, insulation, windows, and orientation. We perform a Manual J load calculation to get it exactly right." },
  { question: "Do you pull permits?", answer: "Yes. We handle all required permits for your peace of mind and to protect your home's value." },
  { question: "What brands do you install?", answer: "We are a Daikin Comfort Pro dealer but also install other leading brands. We'll recommend the best fit for your home and budget." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": { "@type": "Answer", "text": item.answer }
  }))
};

const products = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>`,
    name: "Central AC",
    desc: "The standard for most Tucson homes. Ducted system delivers whole-house cooling through your existing ductwork.",
    badge: "Most Popular",
    href: "/ac-installation"
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M9 21V9"/></svg>`,
    name: "Mini-Split",
    desc: "Ductless, zoned cooling without requiring ductwork. Perfect for additions, garages, or homes without ducts.",
    badge: "No Ductwork Needed",
    href: "/ac-installation"
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>`,
    name: "Heat Pump",
    desc: "One efficient system for both heating and cooling. Ideal for year-round Tucson comfort with lower energy costs.",
    badge: "Heating + Cooling",
    href: "/heating"
  },
];

const installSteps = [
  { num: '1', label: 'Free estimate', desc: 'We assess your home and give you an honest, no-pressure quote.' },
  { num: '2', label: 'Load calculation', desc: 'Our techs perform a Manual J calculation to right-size your system.' },
  { num: '3', label: 'System selection', desc: 'We help you choose the best system for your home and budget.' },
  { num: '4', label: 'Professional installation', desc: 'Permitted, inspected, installed by NATE-certified technicians.' },
  { num: '5', label: 'Post-install inspection', desc: 'We test everything before we leave and walk you through your new system.' },
];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={faqSchema}>

  <!-- Hero -->
  <section class="bg-[var(--color-cloud)] border-b border-[var(--color-border)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 bg-white text-[var(--color-navy)] text-xs font-bold px-4 py-2 rounded-full mb-5 uppercase tracking-wider border border-[var(--color-border)] shadow-sm">
          Daikin Comfort Pro Dealer · Permitted & Inspected · 0% Financing
        </div>
        <h1 class="font-display font-extrabold text-4xl md:text-5xl lg:text-6xl text-[var(--color-navy)] leading-tight mb-5">
          New AC Installation<br class="hidden md:block" /> in Tucson
        </h1>
        <p class="text-[var(--color-muted)] text-xl leading-relaxed mb-8">
          Get the right system sized for your home. We calculate the load, match your budget, and handle everything from permits to startup.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-base px-7 py-4 rounded-xl transition-colors shadow-lg">
            Get a Free Estimate
          </a>
          <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 border-2 border-[var(--color-navy)] text-[var(--color-navy)] hover:bg-[var(--color-navy)] hover:text-white font-bold text-base px-7 py-4 rounded-xl transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call (520) 408-2665
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Financing section -->
  <section class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="reveal bg-gradient-to-r from-orange-50 to-orange-100 border-2 border-[var(--color-orange)] rounded-2xl p-8 md:p-10 text-center">
        <div class="inline-flex items-center gap-2 bg-[var(--color-orange)] text-white text-xs font-bold px-4 py-2 rounded-full mb-5 uppercase tracking-wider">
          Financing Available
        </div>
        <h2 class="font-display font-extrabold text-3xl md:text-4xl text-[var(--color-charcoal)] mb-3">
          0% financing available on approved credit
        </h2>
        <p class="text-[var(--color-muted)] text-lg mb-2">Don't let cost stand between you and a cool home.</p>
        <p class="font-display font-bold text-2xl text-[var(--color-orange)] mb-8">Monthly payments as low as $79/mo</p>
        <a href="/contact" class="inline-flex items-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-lg px-8 py-4 rounded-xl transition-colors shadow-lg">
          Explore Financing Options →
        </a>
      </div>
    </div>
  </section>

  <!-- Products section -->
  <section class="py-16 md:py-24 bg-[var(--color-cloud)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2 class="font-display font-extrabold text-3xl md:text-4xl text-[var(--color-charcoal)] mb-3">Which system is right for you?</h2>
        <p class="text-[var(--color-muted)] text-lg">We'll help you choose — no pressure, just honest advice.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {products.map(p => (
          <div class="reveal bg-white rounded-2xl p-7 border border-[var(--color-border)] shadow-sm hover:shadow-md transition-shadow flex flex-col">
            <div class="text-[var(--color-navy)] mb-5" set:html={p.icon} />
            <div class="inline-flex mb-3">
              <span class="bg-blue-50 text-[var(--color-navy)] text-xs font-bold px-3 py-1 rounded-full border border-blue-100">{p.badge}</span>
            </div>
            <h3 class="font-display font-bold text-xl text-[var(--color-charcoal)] mb-3">{p.name}</h3>
            <p class="text-[var(--color-muted)] text-sm leading-relaxed mb-5 flex-1">{p.desc}</p>
            <a href={p.href} class="text-[var(--color-navy)] font-semibold hover:text-[var(--color-orange)] transition-colors text-sm">
              Learn more →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- IRA Tax Credits -->
  <section class="py-14 bg-[var(--color-navy)]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 bg-white/15 text-white text-xs font-bold px-4 py-2 rounded-full mb-5 uppercase tracking-wider">
        Federal Tax Incentive
      </div>
      <h2 class="font-display font-extrabold text-3xl md:text-4xl text-white mb-5">
        You may qualify for up to $3,200 in federal tax credits
      </h2>
      <p class="text-blue-200 text-lg leading-relaxed mb-8 max-w-2xl mx-auto">
        Under the Inflation Reduction Act, homeowners can claim tax credits for ENERGY STAR certified equipment — including qualifying heat pumps, central AC systems, and more. Ask us how.
      </p>
      <a href="/contact" class="inline-flex items-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-lg px-8 py-4 rounded-xl transition-colors shadow-xl">
        Ask About Tax Credits →
      </a>
    </div>
  </section>

  <!-- Installation process -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2 class="font-display font-extrabold text-3xl md:text-4xl text-[var(--color-charcoal)] mb-3">How installation works</h2>
        <p class="text-[var(--color-muted)] text-lg">From first call to cold air — here's exactly what to expect.</p>
      </div>
      <div class="relative">
        <div class="hidden md:block absolute top-7 left-[10%] right-[10%] h-0.5 bg-[var(--color-border)]"></div>
        <div class="grid sm:grid-cols-3 md:grid-cols-5 gap-6 relative">
          {installSteps.map(step => (
            <div class="reveal text-center">
              <div class="w-14 h-14 rounded-full bg-[var(--color-navy)] text-white font-extrabold text-xl flex items-center justify-center mx-auto mb-4 relative z-10">{step.num}</div>
              <h3 class="font-display font-bold text-base text-[var(--color-charcoal)] mb-2">{step.label}</h3>
              <p class="text-[var(--color-muted)] text-xs leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <TrustBadges />

  <!-- FAQ -->
  <section class="py-16 md:py-20 bg-[var(--color-cloud)]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 reveal">
        <h2 class="font-display font-extrabold text-3xl text-[var(--color-charcoal)] mb-3">Installation questions answered</h2>
        <p class="text-[var(--color-muted)]">Everything you need to know before saying yes.</p>
      </div>
      <FAQAccordion items={faqItems} id="install-faq" />
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-white py-14 border-t border-[var(--color-border)]">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <h2 class="font-display font-bold text-3xl text-[var(--color-charcoal)] mb-3">Ready for a new system?</h2>
      <p class="text-[var(--color-muted)] text-lg mb-8">Get a free estimate — no pressure, just honest sizing and pricing.</p>
      <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-lg px-8 py-4 rounded-xl transition-colors shadow-lg">
        Get My Free Estimate →
      </a>
    </div>
  </section>

</BaseLayout>
