---
interface Props {
  dark?: boolean;
  compact?: boolean;
}
const { dark = false, compact = false } = Astro.props;

const bg = dark ? 'bg-white/8 border-white/10' : 'bg-white border-[var(--color-border)]';
const label = dark ? 'text-white' : 'text-[var(--color-charcoal)]';
const sub = dark ? 'text-blue-300' : 'text-[var(--color-muted)]';
const wrapper = dark ? 'bg-[var(--color-navy-dark)]' : 'bg-[var(--color-cloud)]';
---

<div class={`${wrapper} border-y ${dark ? 'border-white/10' : 'border-[var(--color-border)]'}`}>
  <div class={`max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 ${compact ? 'py-4' : 'py-5'}`}>
    <div class="flex flex-wrap items-center justify-center gap-3 md:gap-2">

      <!-- Google 4.8★ -->
      <div class={`flex items-center gap-2.5 px-4 py-2.5 rounded-xl ${bg} border`}>
        <div class="flex gap-0.5">
          {Array(5).fill(null).map(() => (
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#FBBF24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          ))}
        </div>
        <div>
          <p class={`text-sm font-bold leading-none ${label}`}>4.8 Stars</p>
          <p class={`text-xs leading-none mt-0.5 ${sub}`}>4,000+ Google Reviews</p>
        </div>
      </div>

      <div class={`hidden sm:block w-px h-8 ${dark ? 'bg-white/15' : 'bg-[var(--color-border)]'}`}></div>

      <!-- NATE Certified -->
      <div class={`flex items-center gap-2.5 px-4 py-2.5 rounded-xl ${bg} border`}>
        <div class="w-9 h-9 rounded-lg bg-[var(--color-sky)] flex items-center justify-center shrink-0">
          <span class="text-white font-black text-xs leading-none">NATE</span>
        </div>
        <div>
          <p class={`text-sm font-bold leading-none ${label}`}>NATE Certified</p>
          <p class={`text-xs leading-none mt-0.5 ${sub}`}>All technicians</p>
        </div>
      </div>

      <div class={`hidden sm:block w-px h-8 ${dark ? 'bg-white/15' : 'bg-[var(--color-border)]'}`}></div>

      <!-- BBB A+ -->
      <div class={`flex items-center gap-2.5 px-4 py-2.5 rounded-xl ${bg} border`}>
        <div class="w-9 h-9 rounded-lg bg-[var(--color-success)] flex items-center justify-center shrink-0">
          <span class="text-white font-black text-sm leading-none">A+</span>
        </div>
        <div>
          <p class={`text-sm font-bold leading-none ${label}`}>BBB Accredited</p>
          <p class={`text-xs leading-none mt-0.5 ${sub}`}>A+ Rating</p>
        </div>
      </div>

      <div class={`hidden sm:block w-px h-8 ${dark ? 'bg-white/15' : 'bg-[var(--color-border)]'}`}></div>

      <!-- Since 1959 -->
      <div class={`flex items-center gap-2.5 px-4 py-2.5 rounded-xl ${bg} border`}>
        <div class="w-9 h-9 rounded-lg bg-[var(--color-navy)] flex items-center justify-center shrink-0">
          <span class="text-white font-black text-[10px] leading-none text-center">EST<br/>1959</span>
        </div>
        <div>
          <p class={`text-sm font-bold leading-none ${label}`}>Since 1959</p>
          <p class={`text-xs leading-none mt-0.5 ${sub}`}>Family-owned 65+ yrs</p>
        </div>
      </div>

      <div class={`hidden sm:block w-px h-8 ${dark ? 'bg-white/15' : 'bg-[var(--color-border)]'}`}></div>

      <!-- Pearl Contractor -->
      <div class={`flex items-center gap-2.5 px-4 py-2.5 rounded-xl ${bg} border`}>
        <div class="w-9 h-9 rounded-lg bg-purple-600 flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div>
          <p class={`text-sm font-bold leading-none ${label}`}>Pearl Certified</p>
          <p class={`text-xs leading-none mt-0.5 ${sub}`}>Energy efficiency</p>
        </div>
      </div>

      <div class={`hidden sm:block w-px h-8 ${dark ? 'bg-white/15' : 'bg-[var(--color-border)]'}`}></div>

      <!-- Angi Award -->
      <div class={`flex items-center gap-2.5 px-4 py-2.5 rounded-xl ${bg} border`}>
        <div class="w-9 h-9 rounded-lg bg-orange-500 flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="white"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </div>
        <div>
          <p class={`text-sm font-bold leading-none ${label}`}>Angi Award</p>
          <p class={`text-xs leading-none mt-0.5 ${sub}`}>Super Service 2024</p>
        </div>
      </div>

    </div>
  </div>
</div>
