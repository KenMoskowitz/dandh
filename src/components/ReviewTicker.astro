---
// PLACEHOLDER: Replace these with real Google review content pulled from the Google Maps API or manually entered.
const reviews = [
  { name: 'Sandra M.', excerpt: 'AC was fixed same day. Jacob was incredible — professional and fast.', stars: 5 },
  { name: 'Robert T.', excerpt: 'Best HVAC company in Tucson. Been using D&H for 15 years.', stars: 5 },
  { name: 'Maria G.', excerpt: 'They showed up at 10pm on a Sunday. Truly 24/7 service.', stars: 5 },
  { name: 'James K.', excerpt: 'Fair pricing, no upselling. The tech explained everything clearly.', stars: 5 },
  { name: 'Linda P.', excerpt: 'New unit installed in one day. Crew was clean and professional.', stars: 5 },
  { name: 'David R.', excerpt: 'Emergency call handled within 2 hours. AC running perfectly.', stars: 5 },
  { name: 'Carla F.', excerpt: "Family-run business that still cares. Tucson's best, period.", stars: 5 },
  { name: 'Tom W.', excerpt: 'On time, on budget. The Family Plan saved us $400 last year.', stars: 5 },
];
---

<div class="bg-[var(--color-navy)] py-4 overflow-hidden" aria-hidden="true">
  <div class="ticker-track">
    <!-- First set -->
    {reviews.map(r => (
      <div class="flex items-center gap-3 px-6 py-2 shrink-0">
        <div class="flex text-yellow-400">
          {Array(r.stars).fill(null).map(() => (
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          ))}
        </div>
        <p class="text-white text-sm">
          <span class="font-semibold">{r.name}:</span> "{r.excerpt}"
        </p>
        <span class="text-blue-400 text-xs ml-1">Google Review</span>
        <span class="w-px h-4 bg-blue-700 ml-4"></span>
      </div>
    ))}
    <!-- Duplicate set for seamless loop -->
    {reviews.map(r => (
      <div class="flex items-center gap-3 px-6 py-2 shrink-0">
        <div class="flex text-yellow-400">
          {Array(r.stars).fill(null).map(() => (
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          ))}
        </div>
        <p class="text-white text-sm">
          <span class="font-semibold">{r.name}:</span> "{r.excerpt}"
        </p>
        <span class="text-blue-400 text-xs ml-1">Google Review</span>
        <span class="w-px h-4 bg-blue-700 ml-4"></span>
      </div>
    ))}
  </div>
</div>
