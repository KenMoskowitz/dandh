---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBadges from '../components/TrustBadges.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

const title = "Furnace Repair in Tucson, AZ | D&H Air Conditioning";
const description = "Gas furnace repair in Tucson by NATE-certified techs. All brands, all makes. Same-day service available. Call D&H at (520) 408-2665.";
const canonical = "https://dandhac.com/furnace-repair";

const faqItems = [
  { question: "Is a cracked heat exchanger dangerous?", answer: "Yes. A cracked heat exchanger can allow carbon monoxide to enter your home. If suspected, evacuate and call us immediately." },
  { question: "How long do furnaces last?", answer: "Gas furnaces typically last 15–20 years with proper maintenance. We'll give you an honest assessment on repair vs. replacement." },
  { question: "Do you repair all furnace brands?", answer: "Yes — all major brands including Daikin, Carrier, Trane, Lennox, Rheem, York, and more." },
  { question: "Can you repair my furnace today?", answer: "In most cases, yes. We stock common furnace parts on our trucks." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": { "@type": "Answer", "text": item.answer }
  }))
};

const symptoms = [
  {
    title: "Ignition failure",
    desc: "Furnace starts then shuts off, or won't light at all.",
    urgent: false
  },
  {
    title: "Inducer faults",
    desc: "Unusual noises from the inducer motor before startup.",
    urgent: false
  },
  {
    title: "Burner issues",
    desc: "Yellow or flickering flame instead of a steady blue flame.",
    urgent: false
  },
  {
    title: "Cracked heat exchangers",
    desc: "Dangerous — CO can leak into living space. Requires immediate inspection.",
    urgent: true
  },
  {
    title: "Limit-switch trips",
    desc: "System shuts down repeatedly to protect against overheating.",
    urgent: false
  },
  {
    title: "Gas-valve faults",
    desc: "Gas isn't reaching the burner properly — system runs but doesn't heat.",
    urgent: false
  },
  {
    title: "Blower failures",
    desc: "Motor runs but no air moves through the vents.",
    urgent: false
  },
];

const processSteps = [
  { num: '1', label: 'Diagnosis', desc: 'Full system evaluation — we find the root cause, not just the symptom.' },
  { num: '2', label: 'Safety inspection', desc: 'Every repair visit includes a CO check and heat exchanger inspection.' },
  { num: '3', label: 'Repair quote', desc: 'Clear, upfront pricing before any work begins. You decide.' },
  { num: '4', label: 'Repair or replacement recommendation', desc: 'Honest advice: we\'ll tell you if repair makes more sense than replacement — and vice versa.' },
];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={faqSchema}>

  <!-- Hero -->
  <section class="bg-[var(--color-cloud)] border-b border-[var(--color-border)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 bg-white text-[var(--color-navy)] text-xs font-bold px-4 py-2 rounded-full mb-5 uppercase tracking-wider border border-[var(--color-border)] shadow-sm">
          NATE-Certified · All Furnace Brands · CO Safety Check Included
        </div>
        <h1 class="font-display font-extrabold text-4xl md:text-5xl lg:text-6xl text-[var(--color-navy)] leading-tight mb-5">
          Furnace Repair in Tucson —<br class="hidden md:block" /> We Find It, Fix It, Fast
        </h1>
        <p class="text-[var(--color-muted)] text-xl leading-relaxed mb-8">
          Gas furnace acting up? Our NATE-certified technicians diagnose and repair all furnace makes and models.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-base px-7 py-4 rounded-xl transition-colors shadow-lg">
            Schedule Furnace Repair
          </a>
          <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 border-2 border-[var(--color-navy)] text-[var(--color-navy)] hover:bg-[var(--color-navy)] hover:text-white font-bold text-base px-7 py-4 rounded-xl transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call (520) 408-2665
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Symptoms section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2 class="font-display font-extrabold text-3xl md:text-4xl text-[var(--color-charcoal)] mb-3">What's wrong with your furnace?</h2>
        <p class="text-[var(--color-muted)] text-lg">We diagnose and repair all of these — and everything in between.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        {symptoms.map(s => (
          <div class={`reveal rounded-2xl p-6 border shadow-sm ${s.urgent ? 'bg-red-50 border-red-300' : 'bg-[var(--color-cloud)] border-[var(--color-border)]'}`}>
            {s.urgent && (
              <div class="inline-flex items-center gap-1.5 bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full mb-3 uppercase tracking-wider">
                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                Safety Issue
              </div>
            )}
            <h3 class={`font-display font-bold text-base mb-2 ${s.urgent ? 'text-red-700' : 'text-[var(--color-charcoal)]'}`}>{s.title}</h3>
            <p class="text-[var(--color-muted)] text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 text-center">
        <p class="text-[var(--color-muted)] mb-4">Seeing a yellow or flickering flame, or have a CO alarm going off? Don't wait.</p>
        <a href="tel:5204082665" class="inline-flex items-center gap-2 text-red-600 font-bold hover:text-red-700 transition-colors">
          Call us immediately: (520) 408-2665 →
        </a>
      </div>
    </div>
  </section>

  <!-- Process section -->
  <section class="py-16 md:py-20 bg-[var(--color-cloud)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2 class="font-display font-extrabold text-3xl md:text-4xl text-[var(--color-charcoal)] mb-3">How a furnace repair visit works</h2>
        <p class="text-[var(--color-muted)] text-lg">Safe, systematic, and always transparent about pricing.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {processSteps.map(step => (
          <div class="reveal bg-white rounded-2xl p-6 border border-[var(--color-border)] shadow-sm text-center">
            <div class="w-12 h-12 rounded-full bg-[var(--color-navy)] text-white font-extrabold text-lg flex items-center justify-center mx-auto mb-4">{step.num}</div>
            <h3 class="font-display font-bold text-base text-[var(--color-charcoal)] mb-2">{step.label}</h3>
            <p class="text-[var(--color-muted)] text-sm leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <TrustBadges />

  <!-- FAQ -->
  <section class="py-16 md:py-20 bg-[var(--color-cloud)]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 reveal">
        <h2 class="font-display font-extrabold text-3xl text-[var(--color-charcoal)] mb-3">Furnace repair questions answered</h2>
        <p class="text-[var(--color-muted)]">Straight answers — we've been repairing furnaces in Tucson since 1959.</p>
      </div>
      <FAQAccordion items={faqItems} id="furnace-faq" />
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-[var(--color-navy)] py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-extrabold text-3xl text-white mb-4">Furnace giving you trouble? We can fix it today.</h2>
      <p class="text-blue-200 text-lg mb-8">Same-day service in most cases. All brands. Upfront pricing before we start.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-lg px-8 py-4 rounded-xl transition-colors shadow-lg">
          Schedule Furnace Repair
        </a>
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white hover:bg-white hover:text-[var(--color-navy)] font-bold text-lg px-8 py-4 rounded-xl transition-colors">
          Call (520) 408-2665
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
