---
interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;
const textClass = dark ? 'text-blue-200' : 'text-[var(--color-muted)]';
const labelClass = dark ? 'text-white' : 'text-[var(--color-charcoal)]';
const borderClass = dark ? 'border-blue-800' : 'border-[var(--color-border)]';
---

<div class={`flex flex-wrap justify-center gap-6 md:gap-8 py-6 ${dark ? '' : 'bg-[var(--color-cloud)]'}`}>

  <!-- Google Stars -->
  <div class="flex items-center gap-2">
    <div class="flex text-yellow-400">
      {Array(5).fill(null).map(() => (
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      ))}
    </div>
    <div>
      <p class={`text-sm font-bold ${labelClass}`}>4.8 Stars</p>
      <p class={`text-xs ${textClass}`}>4,000+ Google Reviews</p>
    </div>
  </div>

  <div class={`w-px h-10 ${borderClass} hidden sm:block`}></div>

  <!-- NATE Certified -->
  <div class="flex items-center gap-2">
    <div class="w-10 h-10 rounded-full bg-[var(--color-sky)] flex items-center justify-center text-white font-black text-xs">NATE</div>
    <div>
      <p class={`text-sm font-bold ${labelClass}`}>NATE Certified</p>
      <p class={`text-xs ${textClass}`}>All technicians</p>
    </div>
  </div>

  <div class={`w-px h-10 ${borderClass} hidden sm:block`}></div>

  <!-- BBB A+ -->
  <div class="flex items-center gap-2">
    <div class="w-10 h-10 rounded-full bg-[var(--color-success)] flex items-center justify-center text-white font-black text-sm">A+</div>
    <div>
      <p class={`text-sm font-bold ${labelClass}`}>BBB Rated</p>
      <p class={`text-xs ${textClass}`}>A+ Rating</p>
    </div>
  </div>

  <div class={`w-px h-10 ${borderClass} hidden sm:block`}></div>

  <!-- Since 1959 -->
  <div class="flex items-center gap-2">
    <div class="w-10 h-10 rounded-full bg-[var(--color-navy)] flex items-center justify-center text-white font-black text-xs">1959</div>
    <div>
      <p class={`text-sm font-bold ${labelClass}`}>Since 1959</p>
      <p class={`text-xs ${textClass}`}>Family-owned 65+ years</p>
    </div>
  </div>

  <div class={`w-px h-10 ${borderClass} hidden sm:block`}></div>

  <!-- Pearl Contractor -->
  <div class="flex items-center gap-2">
    <div class="w-10 h-10 rounded-full bg-purple-600 flex items-center justify-center">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8zm4-8a4 4 0 1 1-4-4 4 4 0 0 1 4 4z"/></svg>
    </div>
    <div>
      <p class={`text-sm font-bold ${labelClass}`}>Pearl Certified</p>
      <p class={`text-xs ${textClass}`}>Energy efficiency partner</p>
    </div>
  </div>

  <div class={`w-px h-10 ${borderClass} hidden sm:block`}></div>

  <!-- Angi Award -->
  <div class="flex items-center gap-2">
    <div class="w-10 h-10 rounded-full bg-orange-500 flex items-center justify-center">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
    </div>
    <div>
      <p class={`text-sm font-bold ${labelClass}`}>Angi Award</p>
      <p class={`text-xs ${textClass}`}>Super Service 2024</p>
    </div>
  </div>

</div>
