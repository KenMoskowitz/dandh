---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBadges from '../components/TrustBadges.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

const title = "AC Repair Tucson | All Makes & Models | Same-Day | D&H Air Conditioning";
const description = "Fast, reliable AC repair in Tucson. NATE-certified technicians on all makes and models. Same-day service in most cases. Call (520) 408-2665.";
const canonical = "https://dandhac.com/air-conditioning-repair";

const faqItems = [
  { question: "Do you offer same-day AC repair?", answer: "Yes. In most cases, we can dispatch a NATE-certified technician the same day you call. Our trucks carry common parts so many repairs are completed in a single visit." },
  { question: "How much does AC repair cost in Tucson?", answer: "Repair costs vary by problem and system type. We provide upfront, transparent pricing before any work begins — no surprise charges after the fact." },
  { question: "What brands do you service?", answer: "All major brands: Carrier, Trane, Lennox, Daikin, Rheem, York, Goodman, American Standard, Bryant, and 20+ more." },
  { question: "Can you fix my AC on the weekend or at night?", answer: "Absolutely. Our emergency line (520) 664-3699 is available 24/7, 365 days a year. After-hours and weekend appointments are available." },
  { question: "How do I know if I need repair vs. replacement?", answer: "We'll give you an honest assessment. If your system is over 12–15 years old, requires frequent repairs, or the repair cost exceeds half the replacement cost, replacement often makes more financial sense. We'll walk you through the numbers." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": { "@type": "Answer", "text": item.answer }
  }))
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "AC Repair",
  "provider": { "@type": "HVACBusiness", "name": "D&H Air Conditioning & Heating & Plumbing", "telephone": "(520) 408-2665", "url": "https://dandhac.com" },
  "areaServed": "Tucson, AZ",
  "description": "Same-day AC repair in Tucson on all makes and models. NATE-certified technicians."
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dandhac.com" },
    { "@type": "ListItem", "position": 2, "name": "AC Repair", "item": canonical }
  ]
};

const symptoms = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"/></svg>`,
    title: "AC blowing warm air",
    desc: "Your system is running but the air isn't cold. Could be refrigerant, compressor, or airflow."
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/></svg>`,
    title: "AC won't turn on",
    desc: "Total failure. Could be electrical, thermostat, or a safety shutoff."
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>`,
    title: "Strange noises",
    desc: "Banging, squealing, or rattling usually means a mechanical issue that'll get worse."
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>`,
    title: "Water leaking",
    desc: "Dripping or pooling water signals a clogged drain line or refrigerant leak."
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>`,
    title: "Short cycling",
    desc: "System turns on and off every few minutes. Stresses components and wastes energy."
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
    title: "High energy bills",
    desc: "A system working too hard to cool is usually fighting a fixable problem."
  },
];

const brands = ["Carrier","Trane","Lennox","Daikin","Rheem","York","Goodman","American Standard","Bryant","Heil","Ruud","Amana","Frigidaire","Coleman","Day & Night","Payne"];

const steps = [
  { num: '1', label: 'Schedule', desc: 'Call or book online. Same-day slots available in most cases.' },
  { num: '2', label: 'Diagnosis', desc: 'NATE-certified tech arrives and performs a full system diagnosis.' },
  { num: '3', label: 'Repair quote', desc: 'Clear, upfront pricing before any work begins. No surprises.' },
  { num: '4', label: 'Fixed', desc: 'Most repairs completed in the same visit. Parts on the truck.' },
];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={[faqSchema, serviceSchema, breadcrumbSchema]}>

  <!-- ── Hero ─────────────────────────────────────────────────── -->
  <section class="bg-white border-b border-[var(--color-border)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <nav class="flex items-center gap-1.5 text-xs text-[var(--color-muted)] mb-6">
            <a href="/" class="hover:text-[var(--color-navy)] transition-colors">Home</a>
            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            <span class="text-[var(--color-charcoal)] font-medium">AC Repair</span>
          </nav>
          <div class="inline-flex items-center gap-2 bg-sky-50 border border-sky-200 text-sky-700 text-xs font-bold px-3 py-1.5 rounded-full mb-5 uppercase tracking-wider">
            All Makes &amp; Models · Same-Day Available
          </div>
          <h1 class="font-display font-extrabold text-4xl md:text-5xl lg:text-6xl text-[var(--color-charcoal)] leading-[1.05] mb-5">
            AC Repair in Tucson —
            <span class="text-[var(--color-sky)]">We Fix It Right</span>
          </h1>
          <p class="text-[var(--color-muted)] text-lg md:text-xl leading-relaxed mb-8 max-w-lg">
            If it blows warm air, makes weird noises, or just quits — we diagnose it fast and fix it right. Same-day service in most cases.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 mb-8">
            <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-base px-7 py-4 rounded-xl transition-colors shadow-lg">Schedule a Repair</a>
            <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 border-2 border-[var(--color-navy)] text-[var(--color-navy)] hover:bg-[var(--color-navy)] hover:text-white font-bold text-base px-7 py-4 rounded-xl transition-all">
              <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              (520) 408-2665
            </a>
          </div>
          <div class="flex flex-wrap gap-4 text-sm">
            {['NATE-certified techs', 'Upfront pricing', 'All brands', '24/7 emergency'].map(t => (
              <span class="flex items-center gap-1.5 text-[var(--color-muted)]">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                {t}
              </span>
            ))}
          </div>
        </div>

        <!-- PLACEHOLDER: Replace with real D&H technician on the job photography -->
        <div class="hidden lg:flex flex-col gap-5">
          <div class="rounded-2xl overflow-hidden shadow-xl aspect-[4/3] relative">
            <img
              src="https://images.unsplash.com/photo-1621905252507-b35492cc74b4?auto=format&fit=crop&w=700&q=80"
              alt="D&H NATE-certified technician diagnosing an air conditioning system in Tucson"
              width="700" height="525"
              loading="eager"
              class="w-full h-full object-cover"
            />
            <div class="absolute bottom-4 left-4 flex items-center gap-2 bg-[var(--color-success)]/90 text-white text-xs font-bold px-3 py-1.5 rounded-full">
              <span class="w-1.5 h-1.5 bg-white rounded-full animate-pulse"></span>
              Available Today
            </div>
          </div>
          <!-- Quick stats row -->
          <div class="grid grid-cols-3 gap-3">
            {[
              { v: 'Same Day', l: 'Service available' },
              { v: 'All Brands', l: '20+ brands serviced' },
              { v: '65+ Yrs', l: 'Tucson experience' },
            ].map(s => (
              <div class="bg-[var(--color-cloud)] rounded-xl p-3 text-center border border-[var(--color-border)]">
                <p class="font-display font-extrabold text-base text-[var(--color-navy)]">{s.v}</p>
                <p class="text-xs text-[var(--color-muted)] mt-0.5">{s.l}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Symptoms section -->
  <section class="py-16 md:py-24 bg-[var(--color-cloud)]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2 class="font-display font-extrabold text-3xl md:text-4xl text-[var(--color-charcoal)] mb-3">Sound familiar?</h2>
        <p class="text-[var(--color-muted)] text-lg">These are the problems we fix every single day in Tucson.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {symptoms.map(s => (
          <div class="reveal bg-white rounded-2xl p-6 border border-[var(--color-border)] shadow-sm hover:shadow-md transition-shadow">
            <div class="text-[var(--color-navy)] mb-4" set:html={s.icon} />
            <h3 class="font-display font-bold text-lg text-[var(--color-charcoal)] mb-2">{s.title}</h3>
            <p class="text-[var(--color-muted)] text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
      <div class="text-center mt-10">
        <p class="text-[var(--color-muted)] mb-4">Not seeing your problem? We fix those too.</p>
        <a href="tel:5204082665" class="inline-flex items-center gap-2 text-[var(--color-navy)] font-bold hover:text-[var(--color-orange)] transition-colors">
          Call (520) 408-2665 — we'll diagnose it →
        </a>
      </div>
    </div>
  </section>

  <!-- Process section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2 class="font-display font-extrabold text-3xl md:text-4xl text-[var(--color-charcoal)] mb-3">How a repair visit works</h2>
        <p class="text-[var(--color-muted)] text-lg">No surprises. No confusion. Just a fixed AC.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {steps.map(step => (
          <div class="reveal text-center">
            <div class="w-14 h-14 rounded-full bg-[var(--color-navy)] text-white font-extrabold text-xl flex items-center justify-center mx-auto mb-4">{step.num}</div>
            <h3 class="font-display font-bold text-lg text-[var(--color-charcoal)] mb-2">{step.label}</h3>
            <p class="text-[var(--color-muted)] text-sm leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Brands section -->
  <section class="py-14 bg-[var(--color-cloud)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 reveal">
        <h2 class="font-display font-extrabold text-2xl md:text-3xl text-[var(--color-charcoal)] mb-2">We repair all major brands</h2>
        <p class="text-[var(--color-muted)]">If it cools air, we can fix it.</p>
      </div>
      <div class="flex flex-wrap gap-3 justify-center">
        {brands.map(brand => (
          <span class="bg-white border border-[var(--color-border)] text-[var(--color-charcoal)] font-semibold text-sm px-4 py-2 rounded-full shadow-sm">{brand}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <TrustBadges />

  <!-- FAQ -->
  <section class="py-16 md:py-20 bg-[var(--color-cloud)]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 reveal">
        <h2 class="font-display font-extrabold text-3xl text-[var(--color-charcoal)] mb-3">AC repair questions answered</h2>
        <p class="text-[var(--color-muted)]">Straight talk from people who've been doing this since 1959.</p>
      </div>
      <FAQAccordion items={faqItems} id="repair-faq" />
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-[var(--color-navy)] py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-extrabold text-3xl text-white mb-4">AC giving you trouble? Let's fix it today.</h2>
      <p class="text-blue-200 text-lg mb-8">Same-day service available. NATE-certified techs. Upfront pricing.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-lg px-8 py-4 rounded-xl transition-colors shadow-lg">
          Schedule a Repair Today
        </a>
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white hover:bg-white hover:text-[var(--color-navy)] font-bold text-lg px-8 py-4 rounded-xl transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          (520) 408-2665
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
