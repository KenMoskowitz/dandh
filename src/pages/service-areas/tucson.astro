---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const city = "Tucson";
const title = "AC Repair in Tucson, AZ — D&H Air Conditioning";
const description = "Tucson's most trusted AC repair, installation & maintenance company since 1959. NATE-certified technicians, same-day service, 24/7 emergency response. Call (520) 408-2665.";
const canonical = "https://dandhac.com/service-areas/tucson/";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dandhac.com/" },
    { "@type": "ListItem", "position": 2, "name": "Service Areas", "item": "https://dandhac.com/service-areas/" },
    { "@type": "ListItem", "position": 3, "name": "Tucson", "item": canonical }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "AC Repair in Tucson, AZ",
  "provider": {
    "@type": "HVACBusiness",
    "name": "D&H Air Conditioning & Heating & Plumbing",
    "telephone": "(520) 408-2665",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "3990 S Evans Blvd",
      "addressLocality": "Tucson",
      "addressRegion": "AZ",
      "postalCode": "85714",
      "addressCountry": "US"
    }
  },
  "areaServed": { "@type": "City", "name": "Tucson", "addressRegion": "AZ" },
  "description": "Full HVAC services including AC repair, emergency repair, installation, maintenance, heating, and plumbing in Tucson, AZ."
};

const faqItems = [
  {
    question: "Do you serve all Tucson zip codes?",
    answer: "Yes — we serve every zip code in the Tucson metro area, from the far south side near Rita Ranch to the northwest near Flowing Wells. If you have a Tucson address, we cover you. Call (520) 408-2665 to confirm and schedule same-day."
  },
  {
    question: "What's your fastest response time in Tucson?",
    answer: "For emergency calls within Tucson city limits, we typically have a truck on-site within 2–4 hours. Our service center is located at 3990 S Evans Blvd, which allows us to reach virtually any Tucson neighborhood quickly. During peak summer months we prioritize the most urgent calls — no AC in Tucson heat always qualifies."
  },
  {
    question: "Do you offer same-day AC repair in Tucson?",
    answer: "Yes. Same-day AC repair is available for most Tucson calls, especially when you call before noon. We have multiple fully-stocked trucks in rotation across the city at all times. Call (520) 408-2665 or book online and we'll do everything we can to get to you today."
  }
];

const services = [
  "AC Repair", "Emergency AC Repair", "AC Installation", "AC Maintenance",
  "Heating Repair", "Furnace Repair", "Plumbing"
];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={[breadcrumbSchema, serviceSchema]}>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-[var(--color-navy)] to-[var(--color-navy-dark)] hero-pattern py-14 md:py-20 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div>
      <nav class="flex items-center gap-1.5 text-xs text-blue-400 mb-6">
        <a href="/" class="hover:text-blue-200 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/service-areas/" class="hover:text-blue-200 transition-colors">Service Areas</a>
        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-blue-200 font-medium">Tucson</span>
      </nav>
      <h1 class="font-display font-extrabold text-4xl md:text-5xl text-white leading-[1.05] mb-4">
        AC Repair in Tucson, AZ —<br class="hidden md:block" /> D&H Air Conditioning
      </h1>
      <p class="text-blue-200 text-lg md:text-xl max-w-2xl mb-8">
        Tucson's hometown HVAC company since 1959. We're not just based here — we live here. When your AC fails in triple-digit heat, our trucks are already in your neighborhood.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-base px-6 py-4 rounded-xl transition-colors shadow-md">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          Schedule Service
        </a>
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 border-2 border-white/30 text-white hover:bg-white/10 font-bold text-base px-6 py-4 rounded-xl transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call (520) 408-2665
        </a>
      </div>
      </div>

      <!-- PLACEHOLDER: Replace with real Tucson landscape or D&H truck in front of Tucson home -->
      <div class="hidden lg:block rounded-2xl overflow-hidden shadow-xl aspect-[4/3]">
        <img
          src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=700&q=80"
          alt="Tucson, Arizona desert landscape — D&H Air Conditioning serves all of greater Tucson"
          width="700" height="525"
          loading="eager"
          class="w-full h-full object-cover"
        />
      </div>

      </div>
    </div>
  </section>

  <!-- Serving Since -->
  <section class="py-14 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">Serving Tucson Since 1959</h2>
      <p class="text-[var(--color-muted)] leading-relaxed text-lg max-w-3xl">
        D&H was founded in Tucson in January 1959 by Arthur Duhamel and Harry Hawk — local men who believed the desert deserved better HVAC service. More than 65 years later, the company is still family-owned, still based on Evans Blvd, and still the first call Tucsonans make when the heat hits. We've served three generations of Tucson families, and we take that history seriously in every service call we make today.
      </p>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-14 bg-[var(--color-cloud)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-6">Services We Offer in Tucson</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        {services.map(service => (
          <div class="flex items-center gap-3 bg-white rounded-xl px-5 py-4 border border-[var(--color-border)] shadow-sm">
            <svg class="shrink-0 text-[var(--color-success)]" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="font-semibold text-[var(--color-charcoal)]">{service}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How Close Are We -->
  <section class="py-14 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">How Close Are We?</h2>
      <div class="bg-[var(--color-cloud)] rounded-2xl p-6 border border-[var(--color-border)] max-w-lg">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-[var(--color-navy)] flex items-center justify-center shrink-0">
            <svg class="text-white" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <p class="font-bold text-[var(--color-charcoal)] text-lg">We're IN Tucson</p>
            <p class="text-[var(--color-muted)] text-sm mt-1">Our headquarters at 3990 S Evans Blvd is in the heart of Tucson. For most service calls within city limits, our average drive time is under 20 minutes. We're not driving from Phoenix — we're your neighbors.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Climate Note -->
  <section class="py-14 bg-[var(--color-cloud)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">Tucson's Climate — Why Your AC Works So Hard</h2>
      <p class="text-[var(--color-muted)] leading-relaxed text-lg max-w-3xl">
        Tucson's desert heat regularly exceeds 110°F in summer, putting extreme stress on AC systems that weren't designed with this climate in mind. Add monsoon humidity from July through September, and you have a two-season challenge: brutal dry heat followed by high-moisture air that can accelerate coil corrosion and mold growth in ductwork. Tucson AC systems run longer hours and harder cycles than virtually anywhere else in the country — which is exactly why regular maintenance and rapid repair matter so much here. Our technicians are trained specifically on desert HVAC conditions and know what to look for before a small problem becomes a full system failure in July.
      </p>
    </div>
  </section>

  <!-- Reviews Placeholder -->
  <section class="py-10 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- PLACEHOLDER: Add local Tucson Google Reviews here -->
      <div class="bg-[var(--color-cloud)] border-2 border-dashed border-[var(--color-border)] rounded-2xl p-8 text-center text-[var(--color-muted)]">
        <p class="font-semibold mb-1">Local Reviews — Tucson</p>
        <p class="text-sm">Google Reviews widget or manual review cards go here.</p>
      </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <TrustBadges />

  <!-- FAQ -->
  <section class="py-14 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-6">Frequently Asked Questions — Tucson</h2>
      <FAQAccordion items={faqItems} id="faq-tucson" />
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-[var(--color-orange)] py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-extrabold text-3xl text-white mb-4">Call our Tucson team at (520) 408-2665</h2>
      <p class="text-orange-100 mb-7">Same-day service available · 24/7 emergency response · NATE-certified technicians</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 bg-white text-[var(--color-orange)] hover:bg-orange-50 font-bold text-lg px-8 py-4 rounded-xl transition-colors shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          (520) 408-2665
        </a>
        <a href="/contact" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white hover:bg-white hover:text-[var(--color-orange)] font-bold text-lg px-8 py-4 rounded-xl transition-colors">
          Book Online
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
