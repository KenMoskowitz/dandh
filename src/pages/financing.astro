---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBadges from '../components/TrustBadges.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

const title = "HVAC Financing in Tucson | 0% Interest Available | D&H Air Conditioning";
const description = "Finance your new AC or heating system in Tucson with D&H. 0% interest on approved credit, payments as low as $79/month. Don't let cost stand in the way of comfort.";
const canonical = "https://dandhac.com/financing";

const faqItems = [
  { question: "What credit score do I need to qualify?", answer: "Financing is available on approved credit. Our financing partners work with a range of credit profiles. The best way to find out is to apply — approval takes just minutes." },
  { question: "How fast is the approval process?", answer: "Most approvals happen in minutes, often the same day you call. We can schedule your installation for the next available day once approved." },
  { question: "Can I finance a repair as well as an installation?", answer: "Financing is primarily available for system installations and replacements. For repair financing, please call us at (520) 408-2665 to discuss options." },
  { question: "Are there any prepayment penalties?", answer: "No. You can pay off your balance at any time with no prepayment penalties." },
];
---

<BaseLayout title={title} description={description} canonical={canonical}>

  <!-- ── Hero ─────────────────────────────────────────────────── -->
  <section class="bg-gradient-to-br from-[var(--color-navy)] to-[var(--color-navy-dark)] hero-pattern relative overflow-hidden">
    <div class="absolute top-0 right-0 w-96 h-96 bg-orange-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 relative text-center">
      <div class="inline-flex items-center gap-2 bg-white/10 border border-white/15 text-blue-200 text-xs font-bold px-3.5 py-1.5 rounded-full mb-5 uppercase tracking-wider">
        0% Financing · On Approved Credit
      </div>
      <h1 class="font-display font-extrabold text-4xl md:text-5xl lg:text-6xl text-white leading-[1.05] mb-5">
        Don't Let Cost Stand Between
        <span class="text-orange-300">You and Cool</span>
      </h1>
      <p class="text-blue-200 text-lg md:text-xl leading-relaxed mb-8 max-w-2xl mx-auto">
        0% financing on approved credit. Payments as low as $79/month. Get the system your home needs — without breaking the budget.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-base px-7 py-4 rounded-xl transition-colors shadow-lg cta-pulse">
          Apply for Financing
        </a>
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 border-2 border-white/30 text-white hover:bg-white/10 font-bold text-base px-7 py-4 rounded-xl transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call (520) 408-2665
        </a>
      </div>
    </div>
  </section>

  <!-- Financing options -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2 class="font-display font-extrabold text-3xl md:text-4xl text-[var(--color-charcoal)] mb-3">Financing Options</h2>
        <p class="text-[var(--color-muted)] text-lg">Simple, transparent options to fit your budget.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {[
          { title: '0% for 12 Months', desc: 'No interest for the first 12 months on approved credit. Pay at your pace — no penalties for early payoff.', badge: 'Most Popular' },
          { title: 'Low Monthly Payments', desc: 'Spread the cost over 24–60 months. Payments as low as $79/month depending on system size and terms.', badge: '' },
          { title: 'Same-Day Approval', desc: 'Apply and get a decision in minutes. We can often schedule installation the very next day after approval.', badge: 'Fast' },
        ].map(opt => (
          <div class="reveal bg-[var(--color-cloud)] rounded-2xl p-7 border border-[var(--color-border)] card-lift">
            {opt.badge && (
              <div class="inline-flex mb-3">
                <span class="bg-[var(--color-orange)] text-white text-xs font-bold px-3 py-1 rounded-full">{opt.badge}</span>
              </div>
            )}
            <h3 class="font-display font-bold text-xl text-[var(--color-charcoal)] mb-3">{opt.title}</h3>
            <p class="text-[var(--color-muted)] text-sm leading-relaxed">{opt.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-16 bg-[var(--color-cloud)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2 class="font-display font-extrabold text-3xl text-[var(--color-charcoal)] mb-3">How it works</h2>
        <p class="text-[var(--color-muted)] text-lg">From call to cool air — here's the simple path.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { num: '1', label: 'Call or book online', desc: 'Tell us what you need — new AC, heat pump, or full replacement.' },
          { num: '2', label: 'Get your free estimate', desc: "We'll size your system and give you exact pricing before you decide." },
          { num: '3', label: 'Apply in minutes', desc: 'Quick online application — most decisions come back same day.' },
          { num: '4', label: 'Installation day', desc: 'Approved? We schedule your install and have you cooling in 24–48 hours.' },
        ].map(step => (
          <div class="reveal text-center">
            <div class="w-14 h-14 rounded-full bg-[var(--color-navy)] text-white font-extrabold text-xl flex items-center justify-center mx-auto mb-4">{step.num}</div>
            <h3 class="font-display font-bold text-base text-[var(--color-charcoal)] mb-2">{step.label}</h3>
            <p class="text-[var(--color-muted)] text-xs leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- IRA callout -->
  <section class="py-14 bg-[var(--color-navy)]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-extrabold text-2xl md:text-3xl text-white mb-4">
        Stack financing with IRA tax credits for maximum savings
      </h2>
      <p class="text-blue-200 text-lg mb-6 max-w-2xl mx-auto">
        Qualifying systems can combine 0% financing with up to $3,200 in federal Inflation Reduction Act tax credits. Ask us about which systems qualify.
      </p>
      <a href="/ira-tax-rebates" class="inline-flex items-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-base px-7 py-4 rounded-xl transition-colors shadow-lg">
        Learn About IRA Credits →
      </a>
    </div>
  </section>

  <!-- Trust Badges -->
  <TrustBadges />

  <!-- FAQ -->
  <section class="py-16 bg-[var(--color-cloud)]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 reveal">
        <h2 class="font-display font-extrabold text-3xl text-[var(--color-charcoal)] mb-3">Financing questions answered</h2>
      </div>
      <FAQAccordion items={faqItems} id="financing-faq" />
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-[var(--color-navy)] py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-extrabold text-3xl text-white mb-4">Ready to get started?</h2>
      <p class="text-blue-200 text-lg mb-8">A new system. Monthly payments. Comfort all summer.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-lg px-8 py-4 rounded-xl transition-colors shadow-lg">
          Get a Free Estimate
        </a>
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white hover:bg-white hover:text-[var(--color-navy)] font-bold text-lg px-8 py-4 rounded-xl transition-colors">
          Call (520) 408-2665
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
