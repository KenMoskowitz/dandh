---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBadges from '../components/TrustBadges.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

const title = "Heating Repair in Tucson, AZ | D&H Air Conditioning & Heating";
const description = "Heating repair and installation in Tucson, AZ. Heat pumps, gas furnaces, electric heat — all brands, NATE-certified. Call (520) 408-2665.";
const canonical = "https://dandhac.com/heating";

const faqItems = [
  { question: "When should I call for heating repair?", answer: "If your system isn't reaching the set temperature, makes unusual noises, or you suspect a gas leak — call immediately." },
  { question: "Do you work on heat pumps?", answer: "Yes. Heat pumps are our specialty — we install and service Daikin heat pump systems." },
  { question: "Is heating repair covered under a maintenance plan?", answer: "Family Maintenance Plan members get 10% off all repairs, including heating." },
  { question: "Can you detect carbon monoxide leaks?", answer: "Yes. We test for CO as part of every heating inspection." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": { "@type": "Answer", "text": item.answer }
  }))
};

const symptoms = [
  { title: "No heat at all", desc: "System runs but produces no warmth. Could be a failed heating element, heat exchanger, or gas supply issue.", urgent: false },
  { title: "Heating unevenly", desc: "Some rooms hot, some cold. Often a ductwork, zoning, or airflow problem.", urgent: false },
  { title: "Pilot light issues", desc: "Pilot won't stay lit or trips frequently — a common sign of thermocouple or gas valve failure.", urgent: false },
  { title: "Blower not working", desc: "Motor runs but no air moves through the vents. Indicates a blower motor or belt failure.", urgent: false },
  { title: "Carbon monoxide concerns", desc: "CO is odorless and deadly. If your detector sounds or you feel dizzy, evacuate immediately and call us.", urgent: true },
  { title: "High heating bills", desc: "A sudden spike in heating costs usually means your system is working too hard due to a fixable problem.", urgent: false },
];

const services = [
  { name: "Heat Pump Repair", desc: "We diagnose and repair all heat pump issues — reversing valves, refrigerant, compressors, and more.", href: "/heating" },
  { name: "Gas Furnace Repair", desc: "Ignition failures, heat exchanger cracks, limit switches, and beyond — we fix all furnace problems.", href: "/furnace-repair" },
  { name: "Electric Heating", desc: "Electric resistance heating, heat strips, and electric furnace repair and installation.", href: "/heating" },
  { name: "Heating Installation", desc: "New heat pumps, furnaces, or complete heating system replacement with proper load calculations.", href: "/heating" },
  { name: "Heating Maintenance", desc: "Annual inspection and tune-up before the cold season — part of our Family Maintenance Plan.", href: "/ac-maintenance" },
];

const brands = ["Carrier","Trane","Lennox","Daikin","Rheem","York","Goodman","American Standard","Bryant","Heil","Ruud","Amana","Frigidaire","Coleman","Day & Night","Payne"];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={faqSchema}>

  <!-- ── Hero ─────────────────────────────────────────────────── -->
  <section class="bg-gradient-to-br from-[var(--color-navy)] to-[var(--color-navy-dark)] hero-pattern relative overflow-hidden">
    <div class="absolute top-0 right-0 w-96 h-96 bg-orange-500/8 rounded-full blur-3xl pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 relative">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <nav class="flex items-center gap-1.5 text-xs text-blue-400 mb-6">
            <a href="/" class="hover:text-blue-200 transition-colors">Home</a>
            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            <span class="text-blue-200">Heating</span>
          </nav>
          <div class="inline-flex items-center gap-2 bg-white/10 border border-white/15 text-blue-200 text-xs font-bold px-3.5 py-1.5 rounded-full mb-5 uppercase tracking-wider">
            NATE-Certified · All Heating Systems · Same-Day Service
          </div>
          <h1 class="font-display font-extrabold text-4xl md:text-5xl lg:text-6xl text-white leading-[1.05] mb-5">
            Heating Repair in Tucson —
            <span class="text-orange-300">We Fix It Before the Cold Hits</span>
          </h1>
          <p class="text-blue-200 text-lg md:text-xl leading-relaxed mb-8 max-w-lg">
            When Tucson nights drop below 30°F, you need heat. Our NATE-certified techs handle all heating systems — heat pumps, gas furnaces, electric heat.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-base px-7 py-4 rounded-xl transition-colors shadow-lg">Schedule Heating Repair</a>
            <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 border-2 border-white/30 text-white hover:bg-white/10 font-bold text-base px-7 py-4 rounded-xl transition-all">
              <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              Call (520) 408-2665
            </a>
          </div>
        </div>
        <!-- CO warning callout -->
        <div class="flex flex-col gap-4">
          <div class="bg-red-900/40 border border-red-500/50 rounded-2xl p-6">
            <div class="flex items-start gap-3">
              <svg class="text-red-400 shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
              <div>
                <p class="text-red-300 font-bold text-sm mb-1">Carbon Monoxide Warning</p>
                <p class="text-red-200 text-sm leading-relaxed">If your CO detector sounds or anyone feels dizzy near a gas appliance — <strong>leave the home and call us immediately.</strong> Available 24/7.</p>
                <a href="tel:5206643699" class="mt-3 inline-flex items-center gap-1.5 text-red-300 hover:text-red-100 font-bold text-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                  Emergency: (520) 664-3699
                </a>
              </div>
            </div>
          </div>
          <div class="glass rounded-2xl p-6">
            <p class="text-blue-200 text-xs font-bold uppercase tracking-wider mb-4">Heating Systems We Service</p>
            <div class="space-y-2">
              {['Heat Pumps (all brands)', 'Gas Furnaces', 'Electric Furnaces', 'Mini-Split Heating', 'Dual Fuel Systems', 'Air Handlers'].map(s => (
                <div class="flex items-center gap-2 text-white text-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  {s}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Symptoms grid -->
  <section class="py-16 md:py-24 bg-[var(--color-cloud)]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2 class="font-display font-extrabold text-3xl md:text-4xl text-[var(--color-charcoal)] mb-3">Is your heating system telling you something?</h2>
        <p class="text-[var(--color-muted)] text-lg">Don't ignore the warning signs — Tucson winters get colder than most people expect.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {symptoms.map(s => (
          <div class={`reveal rounded-2xl p-6 border shadow-sm ${s.urgent ? 'bg-red-50 border-red-200' : 'bg-white border-[var(--color-border)]'}`}>
            {s.urgent && (
              <div class="inline-flex items-center gap-1.5 bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full mb-3 uppercase tracking-wider">
                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                Urgent
              </div>
            )}
            <h3 class={`font-display font-bold text-lg mb-2 ${s.urgent ? 'text-red-700' : 'text-[var(--color-charcoal)]'}`}>{s.title}</h3>
            <p class="text-[var(--color-muted)] text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services section -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2 class="font-display font-extrabold text-3xl md:text-4xl text-[var(--color-charcoal)] mb-3">Heating services we offer</h2>
        <p class="text-[var(--color-muted)] text-lg">Everything from emergency repair to full system installation.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {services.map(s => (
          <a href={s.href} class="reveal block bg-[var(--color-cloud)] rounded-2xl p-6 border border-[var(--color-border)] hover:border-[var(--color-navy)] hover:shadow-md transition-all group">
            <h3 class="font-display font-bold text-lg text-[var(--color-charcoal)] group-hover:text-[var(--color-navy)] mb-2 transition-colors">{s.name}</h3>
            <p class="text-[var(--color-muted)] text-sm leading-relaxed mb-3">{s.desc}</p>
            <span class="text-[var(--color-navy)] text-sm font-semibold group-hover:text-[var(--color-orange)] transition-colors">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Brands -->
  <section class="py-14 bg-[var(--color-cloud)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 reveal">
        <h2 class="font-display font-extrabold text-2xl md:text-3xl text-[var(--color-charcoal)] mb-2">We service all major heating brands</h2>
        <p class="text-[var(--color-muted)]">If it heats your home, we know how to fix it.</p>
      </div>
      <div class="flex flex-wrap gap-3 justify-center">
        {brands.map(brand => (
          <span class="bg-white border border-[var(--color-border)] text-[var(--color-charcoal)] font-semibold text-sm px-4 py-2 rounded-full shadow-sm">{brand}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <TrustBadges />

  <!-- FAQ -->
  <section class="py-16 md:py-20 bg-[var(--color-cloud)]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 reveal">
        <h2 class="font-display font-extrabold text-3xl text-[var(--color-charcoal)] mb-3">Heating repair questions answered</h2>
        <p class="text-[var(--color-muted)]">What Tucson homeowners ask us about heating every winter.</p>
      </div>
      <FAQAccordion items={faqItems} id="heating-faq" />
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-[var(--color-navy)] py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-extrabold text-3xl text-white mb-4">Don't wait for the first cold night.</h2>
      <p class="text-blue-200 text-lg mb-8">Book a heating inspection before temperatures drop. It's the smartest thing you can do for your home this fall.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-lg px-8 py-4 rounded-xl transition-colors shadow-lg">
          Book a Heating Inspection
        </a>
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white hover:bg-white hover:text-[var(--color-navy)] font-bold text-lg px-8 py-4 rounded-xl transition-colors">
          Call (520) 408-2665
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
