---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const title = "AC Repair in Catalina Foothills, AZ — D&H Air Conditioning";
const description = "Expert HVAC service for Catalina Foothills homes. D&H Air Conditioning handles complex multi-zone systems, larger homes, and premium brands. Call (520) 408-2665.";
const canonical = "https://dandhac.com/service-areas/catalina-foothills/";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dandhac.com/" },
    { "@type": "ListItem", "position": 2, "name": "Service Areas", "item": "https://dandhac.com/service-areas/" },
    { "@type": "ListItem", "position": 3, "name": "Catalina Foothills", "item": canonical }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "AC Repair in Catalina Foothills, AZ",
  "provider": {
    "@type": "HVACBusiness",
    "name": "D&H Air Conditioning & Heating & Plumbing",
    "telephone": "(520) 408-2665"
  },
  "areaServed": { "@type": "City", "name": "Catalina Foothills", "addressRegion": "AZ" }
};

const faqItems = [
  {
    question: "Can you handle multi-zone and multi-unit HVAC systems in Catalina Foothills?",
    answer: "Yes — this is a common requirement in Catalina Foothills, where larger homes often have two or more independent AC systems. Our senior technicians are trained on multi-zone setups, variable-speed systems, and premium brands commonly found in this area. We diagnose each zone independently and can repair, reconfigure, or replace individual units without disrupting the whole system."
  },
  {
    question: "Do you work on premium HVAC brands like Carrier, Trane, or Daikin in Catalina Foothills?",
    answer: "Absolutely. We service all major brands including Carrier, Trane, Lennox, Daikin (our exclusive install brand), Rheem, York, and more. Many Catalina Foothills homes were built or renovated with premium systems, and our technicians have the training and tools to service them properly. We're a Daikin Comfort Pro dealer and can access genuine parts quickly."
  },
  {
    question: "Do you offer whole-home HVAC assessments in Catalina Foothills?",
    answer: "Yes. For larger or more complex homes in Catalina Foothills, we offer thorough whole-home assessments that evaluate equipment condition, duct integrity, insulation, and airflow. This gives you a complete picture of your HVAC health and a prioritized plan for maintenance or replacement. Call (520) 408-2665 to schedule."
  }
];

const services = [
  "AC Repair", "Emergency AC Repair", "AC Installation", "AC Maintenance",
  "Heating Repair", "Furnace Repair", "Plumbing"
];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={[breadcrumbSchema, serviceSchema]}>

  <section class="bg-gradient-to-br from-[var(--color-navy)] to-[var(--color-navy-dark)] hero-pattern py-14 md:py-20 relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-1.5 text-xs text-blue-400 mb-6">
        <a href="/" class="hover:text-blue-200 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/service-areas/" class="hover:text-blue-200 transition-colors">Service Areas</a>
        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-blue-200 font-medium">Catalina Foothills</span>
      </nav>
      <h1 class="font-display font-extrabold text-4xl md:text-5xl text-white leading-[1.05] mb-4">
        AC Repair in Catalina Foothills, AZ —<br class="hidden md:block" /> D&H Air Conditioning
      </h1>
      <p class="text-blue-200 text-lg md:text-xl max-w-2xl mb-8">
        Larger homes, more complex systems, higher performance expectations. Catalina Foothills homeowners trust D&H because we have the expertise — and the experience — to get it right.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-base px-6 py-4 rounded-xl transition-colors shadow-md">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          Schedule Service
        </a>
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 border-2 border-white/30 text-white hover:bg-white/10 font-bold text-base px-6 py-4 rounded-xl transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call (520) 408-2665
        </a>
      </div>
    </div>
  </section>

  <section class="py-14 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">Serving Catalina Foothills — Where Expertise Matters Most</h2>
      <p class="text-[var(--color-muted)] leading-relaxed text-lg max-w-3xl">
        Catalina Foothills is home to some of the most architecturally distinctive residences in southern Arizona — sprawling hillside homes, mid-century modern designs, and contemporary custom builds. Many of these homes have complex HVAC configurations that require real expertise: multiple air handlers, zoned systems, radiant heat, and premium variable-speed equipment. D&H has been servicing Catalina Foothills for decades, and we bring senior technicians with the training these systems demand.
      </p>
    </div>
  </section>

  <section class="py-14 bg-[var(--color-cloud)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-6">Services We Offer in Catalina Foothills</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        {services.map(service => (
          <div class="flex items-center gap-3 bg-white rounded-xl px-5 py-4 border border-[var(--color-border)] shadow-sm">
            <svg class="shrink-0 text-[var(--color-success)]" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="font-semibold text-[var(--color-charcoal)]">{service}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">How Close Are We?</h2>
      <div class="bg-[var(--color-cloud)] rounded-2xl p-6 border border-[var(--color-border)] max-w-lg">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-[var(--color-navy)] flex items-center justify-center shrink-0">
            <svg class="text-white" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <p class="font-bold text-[var(--color-charcoal)] text-lg">~10 miles · approximately 20 minutes</p>
            <p class="text-[var(--color-muted)] text-sm mt-1">Catalina Foothills is a short drive northeast from our Evans Blvd base. The Foothills area is well within our core service territory, and we dispatch to this area multiple times per day during peak season. Emergency response times are typically 2–3 hours or faster.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 bg-[var(--color-cloud)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">Catalina Foothills — Complex Systems, High Stakes</h2>
      <p class="text-[var(--color-muted)] leading-relaxed text-lg max-w-3xl">
        Catalina Foothills' higher elevation and larger homes mean bigger, more complex HVAC systems — and higher stakes when something goes wrong. A home with 4,000+ square feet, vaulted ceilings, and a south-facing orientation can require two or three tons more cooling capacity than a comparable flat-lot home in central Tucson. Improper sizing, incorrect refrigerant charge, or neglected maintenance on these larger systems leads to dramatic efficiency loss and premature failure. Our technicians are trained to evaluate the full picture — not just the equipment, but the home's load requirements, duct layout, and insulation — before making any recommendations.
      </p>
    </div>
  </section>

  <section class="py-10 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- PLACEHOLDER: Add local Catalina Foothills Google Reviews here -->
      <div class="bg-[var(--color-cloud)] border-2 border-dashed border-[var(--color-border)] rounded-2xl p-8 text-center text-[var(--color-muted)]">
        <p class="font-semibold mb-1">Local Reviews — Catalina Foothills</p>
        <p class="text-sm">Google Reviews widget or manual review cards go here.</p>
      </div>
    </div>
  </section>

  <TrustBadges />

  <section class="py-14 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-6">Frequently Asked Questions — Catalina Foothills</h2>
      <FAQAccordion items={faqItems} id="faq-catalina-foothills" />
    </div>
  </section>

  <section class="bg-[var(--color-orange)] py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-extrabold text-3xl text-white mb-4">Call our Catalina Foothills team at (520) 408-2665</h2>
      <p class="text-orange-100 mb-7">Same-day service available · 24/7 emergency response · NATE-certified technicians</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 bg-white text-[var(--color-orange)] hover:bg-orange-50 font-bold text-lg px-8 py-4 rounded-xl transition-colors shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          (520) 408-2665
        </a>
        <a href="/contact" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white hover:bg-white hover:text-[var(--color-orange)] font-bold text-lg px-8 py-4 rounded-xl transition-colors">
          Book Online
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
