---
---

<div
  x-data="{
    units: 1,
    bill: 200,
    get annualSavings() {
      const repairSavings = this.units * 80;
      const energySavings = this.bill * 0.12 * 12;
      const emergencyAvoidance = this.units * 150;
      return Math.round(repairSavings + energySavings + emergencyAvoidance);
    },
    get planCost() { return this.units * 199; },
    get netSavings() { return this.annualSavings - this.planCost; }
  }"
  class="bg-white rounded-2xl border-2 border-[var(--color-border)] p-7 md:p-9 shadow-xl shadow-navy/6 relative overflow-hidden"
>
  <!-- Background accent -->
  <div class="absolute top-0 right-0 w-48 h-48 bg-gradient-to-bl from-sky-50 to-transparent rounded-bl-full pointer-events-none"></div>

  <div class="relative z-10">
    <div class="flex items-start gap-3 mb-6">
      <div class="w-11 h-11 rounded-xl bg-[var(--color-navy)] flex items-center justify-center shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="1" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
      </div>
      <div>
        <h3 class="font-display font-extrabold text-xl text-[var(--color-charcoal)]">Your Savings Calculator</h3>
        <p class="text-[var(--color-muted)] text-sm mt-0.5">See how much the Family Plan saves you annually.</p>
      </div>
    </div>

    <div class="space-y-6">
      <!-- AC Units -->
      <div>
        <label class="block text-sm font-semibold text-[var(--color-charcoal)] mb-3">
          How many AC units do you have?
        </label>
        <div class="flex items-center gap-4">
          <button
            @click="units = Math.max(1, units - 1)"
            class="w-11 h-11 rounded-xl border-2 border-[var(--color-border)] flex items-center justify-center text-[var(--color-charcoal)] hover:bg-[var(--color-cloud)] hover:border-[var(--color-sky)] transition-all font-bold text-lg"
          >−</button>
          <div class="text-center">
            <span class="text-3xl font-display font-extrabold text-[var(--color-navy)]" x-text="units"></span>
            <p class="text-xs text-[var(--color-muted)] mt-0.5">unit<span x-show="units > 1">s</span></p>
          </div>
          <button
            @click="units = Math.min(5, units + 1)"
            class="w-11 h-11 rounded-xl border-2 border-[var(--color-border)] flex items-center justify-center text-[var(--color-charcoal)] hover:bg-[var(--color-cloud)] hover:border-[var(--color-sky)] transition-all font-bold text-lg"
          >+</button>
          <div class="flex gap-1 ml-2">
            {[1,2,3,4,5].map(n => (
              <button
                @click={`units = ${n}`}
                class="w-8 h-8 rounded-lg text-xs font-bold transition-all"
                :class={`units === ${n} ? 'bg-[var(--color-navy)] text-white' : 'bg-[var(--color-cloud)] text-[var(--color-muted)] hover:bg-sky-100'`}
              >{n}</button>
            ))}
          </div>
        </div>
      </div>

      <!-- Monthly Bill -->
      <div>
        <label class="block text-sm font-semibold text-[var(--color-charcoal)] mb-3">
          Avg monthly energy bill:
          <span class="text-[var(--color-navy)] font-extrabold text-base ml-1">$<span x-text="bill"></span></span>
        </label>
        <input
          type="range"
          x-model="bill"
          min="100" max="600" step="25"
          class="w-full h-2 rounded-full cursor-pointer accent-[#1A3F6F]"
        />
        <div class="flex justify-between text-xs text-[var(--color-muted)] mt-1.5">
          <span>$100/mo</span>
          <span>$600/mo</span>
        </div>
      </div>

      <!-- Results card -->
      <div class="bg-gradient-to-br from-[var(--color-cloud)] to-sky-50 rounded-2xl p-5 border border-sky-100 space-y-3">
        <div class="flex justify-between items-center text-sm py-1">
          <span class="text-[var(--color-muted)] flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
            Family Plan cost/yr
          </span>
          <span class="font-bold text-[var(--color-charcoal)]">$<span x-text="planCost"></span></span>
        </div>
        <div class="flex justify-between items-center text-sm py-1">
          <span class="text-[var(--color-muted)] flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
            Estimated annual savings
          </span>
          <span class="font-bold text-[var(--color-success)]">$<span x-text="annualSavings"></span></span>
        </div>
        <div class="border-t-2 border-sky-200 pt-3 flex justify-between items-center">
          <div>
            <p class="font-display font-extrabold text-[var(--color-charcoal)] text-base">Your net savings</p>
            <p class="text-xs text-[var(--color-muted)]">Repairs, energy, emergencies avoided</p>
          </div>
          <div class="text-right">
            <p class="font-display font-extrabold text-3xl text-[var(--color-navy)]">$<span x-text="netSavings"></span></p>
            <p class="text-xs text-[var(--color-success)] font-semibold">per year</p>
          </div>
        </div>
      </div>

      <a
        href="/contact"
        class="block w-full text-center bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-extrabold text-base py-4 rounded-xl transition-colors shadow-lg shadow-orange-200/50 cta-pulse"
      >
        Join the Family Plan — Save $<span x-text="netSavings"></span>/yr
      </a>
      <p class="text-center text-xs text-[var(--color-muted)]">$<span x-text="planCost"></span>/year · Cancel anytime · No hidden fees</p>
    </div>
  </div>
</div>
