---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const title = "Heat Pump Installation & Repair in Tucson | D&H Air Conditioning";
const description = "Heat pump installation and repair in Tucson, AZ. One system for cooling AND heating. Daikin DZ18VC up to 19 SEER. IRA tax credit eligible. Call (520) 408-2665.";
const canonical = "https://dandhac.com/products/heat-pumps/";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dandhac.com/" },
    { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://dandhac.com/products/" },
    { "@type": "ListItem", "position": 3, "name": "Heat Pumps", "item": canonical }
  ]
};

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Daikin Heat Pump Systems",
  "brand": { "@type": "Brand", "name": "Daikin" },
  "description": "Heat pump systems providing both cooling and heating from a single unit. Daikin DZ18VC features up to 19 SEER efficiency and variable-speed operation.",
  "offers": {
    "@type": "Offer",
    "seller": { "@type": "HVACBusiness", "name": "D&H Air Conditioning & Heating & Plumbing", "telephone": "(520) 408-2665" },
    "areaServed": { "@type": "City", "name": "Tucson", "addressRegion": "AZ" }
  }
};

const benefits = [
  {
    title: "One system for all seasons",
    description: "A heat pump replaces your AC and your furnace with a single, electrically-powered system. In Tucson's mild winters, heat pumps are dramatically more efficient than gas heating."
  },
  {
    title: "Lower operating costs",
    description: "Heat pumps move heat rather than generate it, making them 200–300% efficient at heating. That means for every unit of electricity consumed, you get 2–3 units of heat — something no furnace can match."
  },
  {
    title: "IRA federal tax credits",
    description: "Qualifying heat pumps are eligible for the federal Energy Efficient Home Improvement Credit — up to 30% of the installed cost, capped at $2,000 per year. This can mean thousands of dollars back at tax time."
  },
  {
    title: "Arizona utility rebates",
    description: "Tucson Electric Power and other Arizona utilities offer rebates on qualifying high-efficiency heat pump installations. D&H can help you identify every available rebate for your specific situation."
  },
  {
    title: "Reduced environmental footprint",
    description: "By replacing fossil fuel heating with an electrically-powered system, and pairing with solar if desired, heat pumps offer a path to dramatically lower household carbon emissions."
  },
  {
    title: "Simplified maintenance",
    description: "One system, one annual tune-up, one set of filters. A heat pump simplifies your home mechanical systems without sacrificing comfort in any season."
  },
];

const faqItems = [
  {
    question: "Do heat pumps work in Tucson's cold winters?",
    answer: "Yes — and they're actually ideal for Tucson's climate. Modern heat pumps like the Daikin DZ18VC operate efficiently down to well below freezing. Tucson's winter temperatures rarely push below 28–30°F, and heat pumps handle this range without supplemental heat in most cases. If you're in a higher-elevation area like Catalina or SaddleBrooke with colder winters, we'll help you select a cold-climate rated model appropriate for your location."
  },
  {
    question: "What's the difference between a heat pump and a traditional AC + furnace setup?",
    answer: "A traditional setup uses two separate systems: an air conditioner for cooling and a gas furnace for heating. A heat pump handles both with a single system by reversing its refrigerant cycle — cooling in summer, heating in winter. This means one system to install, one to maintain, and one to pay to operate. For homes that currently use both a central AC and a gas furnace, switching to a heat pump typically reduces total HVAC operating costs."
  },
  {
    question: "What makes the Daikin DZ18VC stand out?",
    answer: "The Daikin DZ18VC is our flagship central heat pump for Tucson homes. It features variable-speed compressor technology — instead of running at full blast and cycling on and off, it modulates its output continuously to match your home's actual demand. This delivers superior comfort (fewer temperature swings), dramatic efficiency gains (up to 19 SEER), and significantly quieter operation. The variable-speed operation also reduces wear on components, extending system life."
  },
  {
    question: "Can I qualify for tax credits on a heat pump installed by D&H?",
    answer: "In most cases, yes. The Inflation Reduction Act's Energy Efficient Home Improvement Credit provides up to 30% of the installed cost back as a federal tax credit, capped at $2,000 per year for heat pumps. The equipment must meet efficiency thresholds — Daikin systems we install typically qualify. We'll confirm eligibility for your specific system at the time of estimate. Always consult a tax professional for your specific situation."
  }
];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={[breadcrumbSchema, productSchema]}>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-[var(--color-navy)] to-[var(--color-navy-dark)] hero-pattern py-16 md:py-24 relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-1.5 text-xs text-blue-400 mb-6">
        <a href="/" class="hover:text-blue-200 transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="/products/" class="hover:text-blue-200 transition-colors">Products</a>
        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="text-blue-100">Heat Pumps</span>
      </nav>
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 bg-blue-800/50 text-blue-200 text-xs font-semibold px-3 py-1.5 rounded-full mb-5">
          Daikin Comfort Pro Dealer · IRA Tax Credit Eligible
        </div>
        <h1 class="font-display font-extrabold text-4xl md:text-5xl text-white leading-tight mb-5">
          Heat Pumps — Cooling AND<br class="hidden md:block" /> Heating in One Efficient System
        </h1>
        <p class="text-blue-200 text-lg md:text-xl leading-relaxed mb-8">
          One system replaces your AC and your furnace — with lower operating costs, federal tax credits, and the most advanced comfort technology available. D&H installs Daikin heat pumps throughout Tucson.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/contact" class="inline-flex items-center justify-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-base px-6 py-4 rounded-xl transition-colors shadow-lg cta-pulse">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
            Get a Free Estimate
          </a>
          <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white hover:bg-white hover:text-[var(--color-navy)] font-bold text-base px-6 py-4 rounded-xl transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call (520) 408-2665
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- How Heat Pumps Work -->
  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <h2 class="font-display font-extrabold text-3xl text-[var(--color-charcoal)] mb-4">How a heat pump works</h2>
          <p class="text-[var(--color-muted)] leading-relaxed mb-4">
            A heat pump is a refrigerant-based system — like a traditional air conditioner — with one critical difference: it can run in reverse. In cooling mode, it moves heat from inside your home to the outdoors, exactly like a standard AC. In heating mode, it reverses the cycle, pulling heat energy from the outdoor air and delivering it inside.
          </p>
          <p class="text-[var(--color-muted)] leading-relaxed mb-4">
            Even when outdoor air feels cold, there is usable heat energy in it. Modern heat pumps extract this energy efficiently down to very low temperatures — Daikin's DZ18VC operates effectively down to -4°F, which is far colder than Tucson ever experiences.
          </p>
          <p class="text-[var(--color-muted)] leading-relaxed">
            Because a heat pump moves heat rather than generating it by burning fuel, it can deliver 2–3 units of heat energy for every 1 unit of electricity consumed — making it the most efficient heating technology available for Tucson's climate.
          </p>
        </div>
        <div class="space-y-4">
          <div class="bg-[var(--color-sky)] text-white rounded-2xl p-6">
            <p class="font-display font-bold text-lg mb-2">Summer Mode: Cooling</p>
            <p class="text-blue-100 text-sm leading-relaxed">Heat pump pulls heat from inside your home and rejects it outdoors — identical operation to a traditional central AC system. No change in your summer experience.</p>
          </div>
          <div class="bg-[var(--color-navy)] text-white rounded-2xl p-6">
            <p class="font-display font-bold text-lg mb-2">Winter Mode: Heating</p>
            <p class="text-blue-100 text-sm leading-relaxed">Heat pump extracts heat from outdoor air (even cold air contains heat energy) and delivers it inside. No gas, no combustion — just efficient electrical operation at 200–300% efficiency.</p>
          </div>
          <div class="bg-[var(--color-cloud)] rounded-2xl p-6 border border-[var(--color-border)]">
            <p class="font-display font-bold text-lg text-[var(--color-charcoal)] mb-2">Result: One system, all year</p>
            <p class="text-[var(--color-muted)] text-sm leading-relaxed">Replace your AC and furnace with a single heat pump. Simpler, more efficient, and eligible for federal tax credits and utility rebates.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits Grid -->
  <section class="py-16 bg-[var(--color-cloud)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-display font-extrabold text-3xl text-[var(--color-charcoal)] mb-3">Why heat pumps make sense in Tucson</h2>
        <p class="text-[var(--color-muted)] max-w-xl mx-auto">Tucson's climate is near-ideal for heat pump operation — mild winters, long cooling seasons, and high utility costs that reward efficiency.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {benefits.map(b => (
          <div class="bg-white rounded-2xl p-6 border border-[var(--color-border)] shadow-sm">
            <div class="w-10 h-10 rounded-xl bg-[var(--color-navy)] flex items-center justify-center mb-4">
              <svg class="text-white" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <h3 class="font-display font-bold text-[var(--color-charcoal)] mb-2">{b.title}</h3>
            <p class="text-sm text-[var(--color-muted)] leading-relaxed">{b.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Daikin DZ18VC Spotlight -->
  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-[var(--color-navy)] rounded-3xl p-8 md:p-12 text-white">
        <div class="grid md:grid-cols-2 gap-10 items-center">
          <div>
            <div class="inline-flex items-center gap-2 bg-white/10 text-blue-200 text-xs font-semibold px-3 py-1.5 rounded-full mb-4">
              Featured System
            </div>
            <h2 class="font-display font-extrabold text-3xl mb-4">Daikin DZ18VC</h2>
            <p class="text-blue-200 leading-relaxed mb-4">
              The DZ18VC is D&H's recommended central heat pump for most Tucson homes. Its variable-speed compressor continuously modulates between 30–100% capacity, matching your home's exact demand in real time — instead of the blunt on/off cycling of a traditional system.
            </p>
            <p class="text-blue-200 leading-relaxed">
              The result is more consistent temperatures, dramatically lower utility bills, and quieter operation than any conventional heat pump or AC system. The DZ18VC qualifies for the full range of federal tax credits and utility rebates available in Arizona.
            </p>
          </div>
          <div>
            <h3 class="font-display font-bold text-xl mb-4">DZ18VC specs</h3>
            <ul class="space-y-3">
              {[
                { label: "SEER rating", value: "Up to 19 SEER" },
                { label: "Compressor type", value: "Variable-speed" },
                { label: "Heating efficiency (HSPF)", value: "Up to 10 HSPF" },
                { label: "Refrigerant", value: "R-410A" },
                { label: "Sound level", value: "As low as 56 dB" },
                { label: "Warranty (D&H install)", value: "12-year parts, 12-year compressor" },
              ].map(item => (
                <li class="flex items-center justify-between border-b border-blue-800 pb-2 last:border-0 last:pb-0">
                  <span class="text-sm text-blue-300">{item.label}</span>
                  <span class="text-sm font-bold text-white">{item.value}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <TrustBadges />

  <!-- FAQ -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display font-extrabold text-3xl text-[var(--color-charcoal)] mb-8 text-center">Heat Pump FAQs</h2>
      <FAQAccordion items={faqItems} id="faq-heat-pumps" />
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-[var(--color-orange)] py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-extrabold text-3xl text-white mb-4">See how much a heat pump could save you</h2>
      <p class="text-orange-100 mb-7">Call D&H at (520) 408-2665. We'll assess your current system, calculate your potential savings, and walk you through every available rebate and tax credit.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="tel:5204082665" class="inline-flex items-center justify-center gap-2 bg-white text-[var(--color-orange)] hover:bg-orange-50 font-bold text-lg px-8 py-4 rounded-xl transition-colors shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          (520) 408-2665
        </a>
        <a href="/contact" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white hover:bg-white hover:text-[var(--color-orange)] font-bold text-lg px-8 py-4 rounded-xl transition-colors">
          Get a Free Estimate Online
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
