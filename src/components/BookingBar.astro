---
---

<!-- Floating booking bar — desktop: slides in from right; mobile: handled by BaseLayout tap-to-call bar -->
<div
  x-data="{
    visible: false,
    dismissed: false,
    init() {
      window.addEventListener('scroll', () => {
        if (!this.dismissed) this.visible = window.scrollY > 500;
      }, { passive: true });
    }
  }"
  x-show="visible && !dismissed"
  x-transition:enter="transition ease-out duration-300"
  x-transition:enter-start="opacity-0 translate-x-6"
  x-transition:enter-end="opacity-100 translate-x-0"
  x-transition:leave="transition ease-in duration-200"
  x-transition:leave-start="opacity-100 translate-x-0"
  x-transition:leave-end="opacity-0 translate-x-6"
  style="display:none"
  class="hidden md:block fixed right-5 bottom-8 z-40 w-68"
>
  <div class="bg-[var(--color-navy)] rounded-2xl shadow-2xl shadow-navy/30 overflow-hidden">
    <!-- Header strip -->
    <div class="bg-[var(--color-orange)] px-5 py-3 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-white"></span>
        </span>
        <p class="text-white font-bold text-sm">AC down? We're available now.</p>
      </div>
      <button
        @click="dismissed = true"
        class="text-orange-200 hover:text-white transition-colors ml-2"
        aria-label="Dismiss"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>

    <!-- Body -->
    <div class="px-5 py-4 space-y-2.5">
      <a
        href="tel:5204082665"
        class="flex items-center justify-center gap-2 bg-white text-[var(--color-navy)] hover:bg-blue-50 font-bold text-sm px-4 py-3 rounded-xl transition-colors w-full"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Call (520) 408-2665
      </a>
      <a
        href="/contact"
        class="flex items-center justify-center gap-2 bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-sm px-4 py-3 rounded-xl transition-colors w-full"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
        Schedule Online
      </a>
      <p class="text-center text-xs text-blue-400">Avg response: 2–4 hours</p>
    </div>
  </div>
</div>
