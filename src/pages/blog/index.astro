---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "HVAC Tips & Guides for Tucson Homeowners | D&H AC Blog";
const description = "Expert HVAC tips, seasonal guides, and money-saving advice from the team at D&H Air Conditioning — Tucson's most trusted HVAC company since 1959.";
const canonical = "https://dandhac.com/blog";

// PLACEHOLDER: Replace with real blog posts via your CMS (Contentful, Sanity, or Astro content collections).
// These are placeholder posts for layout and SEO purposes only.
const posts = [
  {
    slug: "#",
    title: "Why Your AC is Blowing Warm Air — And How to Fix It",
    date: "May 2025",
    dateISO: "2025-05-01",
    category: "Troubleshooting",
    excerpt: "The 5 most common reasons your AC is blowing warm air and what you can do right now — before you call a technician.",
    readTime: "5 min read",
  },
  {
    slug: "#",
    title: "How to Survive a Tucson Summer When Your AC Breaks",
    date: "April 2025",
    dateISO: "2025-04-01",
    category: "Emergency Tips",
    excerpt: "Emergency cooling tips, what to do while you wait for your technician, and how to stay safe when Tucson heat gets dangerous.",
    readTime: "4 min read",
  },
  {
    slug: "#",
    title: "Heat Pump vs. Central AC: Which Is Right for Tucson?",
    date: "March 2025",
    dateISO: "2025-03-01",
    category: "Buying Guide",
    excerpt: "Breaking down the pros, cons, and real cost differences between heat pumps and traditional central AC in the Sonoran Desert climate.",
    readTime: "7 min read",
  },
  {
    slug: "#",
    title: "The Real Cost of Skipping Your Annual AC Tune-Up",
    date: "February 2025",
    dateISO: "2025-02-01",
    category: "Maintenance",
    excerpt: "What deferred maintenance actually costs Tucson homeowners every year — in emergency repairs, lost efficiency, and shortened system life.",
    readTime: "5 min read",
  },
  {
    slug: "#",
    title: "IRA Tax Credits for HVAC: What You Can Claim in 2025",
    date: "January 2025",
    dateISO: "2025-01-01",
    category: "Savings & Incentives",
    excerpt: "The Inflation Reduction Act makes qualifying HVAC upgrades eligible for up to $3,200 back from the federal government. Here's what applies in Arizona.",
    readTime: "6 min read",
  },
  {
    slug: "#",
    title: "Daikin vs. Carrier: An Honest Comparison from a Daikin Dealer",
    date: "December 2024",
    dateISO: "2024-12-01",
    category: "Buying Guide",
    excerpt: "We install Daikin as our primary brand — but we'll give you an honest, no-spin side-by-side comparison with Carrier so you can decide for yourself.",
    readTime: "8 min read",
  },
];

const categoryColors: Record<string, string> = {
  "Troubleshooting": "bg-red-50 text-red-700",
  "Emergency Tips": "bg-orange-50 text-orange-700",
  "Buying Guide": "bg-blue-50 text-blue-700",
  "Maintenance": "bg-green-50 text-green-700",
  "Savings & Incentives": "bg-purple-50 text-purple-700",
};
---

<BaseLayout title={title} description={description} canonical={canonical}>

  <!-- ── Hero ─────────────────────────────────────────────────── -->
  <section class="bg-gradient-to-br from-[var(--color-navy)] to-[var(--color-navy-dark)] hero-pattern relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20 relative text-center">
      <div class="inline-flex items-center gap-2 bg-white/10 border border-white/15 text-blue-200 text-xs font-bold px-3.5 py-1.5 rounded-full mb-5 uppercase tracking-wider">
        Expert HVAC Advice — Free
      </div>
      <h1 class="font-display font-extrabold text-4xl md:text-5xl text-white leading-[1.05] mb-5">
        HVAC Tips for
        <span class="text-sky-300">Tucson Homeowners</span>
      </h1>
      <p class="text-blue-200 text-lg max-w-xl mx-auto">
        Real advice from the team that's been keeping Tucson comfortable since 1959. No fluff, no upselling — just useful information to help you make smart decisions about your home.
      </p>
    </div>
  </section>

  <!-- ======= BLOG GRID ======= -->
  <section class="bg-white py-16 md:py-24">
    <div class="container mx-auto px-4">

      <!-- PLACEHOLDER: Integrate with your CMS (Contentful, Sanity, Astro content collections, etc.) to pull real post data here. -->

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {posts.map(post => (
          <article class="bg-white rounded-2xl border border-[var(--color-border)] overflow-hidden shadow-sm hover:shadow-md transition-shadow group flex flex-col">

            <!-- Post image placeholder -->
            <div class="bg-[var(--color-cloud)] aspect-[16/9] flex items-center justify-center">
              <div class="text-center p-6">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--color-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-2"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                <p class="text-[var(--color-muted)] text-xs">Blog post featured image</p>
              </div>
            </div>

            <div class="p-6 flex flex-col flex-1">
              <!-- Meta -->
              <div class="flex items-center gap-3 mb-3">
                <span class={`text-xs font-semibold px-2.5 py-1 rounded-full ${categoryColors[post.category] || 'bg-gray-100 text-gray-600'}`}>
                  {post.category}
                </span>
                <time datetime={post.dateISO} class="text-xs text-[var(--color-muted)]">{post.date}</time>
                <span class="text-xs text-[var(--color-muted)]">&middot; {post.readTime}</span>
              </div>

              <!-- Title -->
              <h2 class="font-display font-700 text-[var(--color-charcoal)] text-lg leading-snug mb-3 group-hover:text-[var(--color-navy)] transition-colors">
                {post.title}
              </h2>

              <!-- Excerpt -->
              <p class="text-[var(--color-muted)] text-sm leading-relaxed flex-1 mb-5">
                {post.excerpt}
              </p>

              <!-- Read more -->
              <a
                href={post.slug}
                class="inline-flex items-center gap-2 text-[var(--color-navy)] font-semibold text-sm hover:text-[var(--color-sky)] transition-colors"
              >
                Read More
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" x2="19" y1="12" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Load more placeholder -->
      <div class="text-center mt-12">
        <p class="text-[var(--color-muted)] text-sm mb-4">More articles coming soon. Want to be notified when we publish?</p>
        <!-- PLACEHOLDER: Add newsletter signup or pagination here when CMS is connected -->
        <a
          href="/contact"
          class="inline-block border-2 border-[var(--color-navy)] text-[var(--color-navy)] hover:bg-[var(--color-navy)] hover:text-white font-bold px-8 py-3 rounded-xl transition-colors"
        >
          Get in Touch
        </a>
      </div>
    </div>
  </section>

  <!-- ======= CATEGORIES / POPULAR TOPICS ======= -->
  <section class="bg-[var(--color-cloud)] py-12">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="font-display font-700 text-xl text-[var(--color-charcoal)] mb-6">Browse by Topic</h2>
        <div class="flex flex-wrap gap-3 justify-center">
          {Object.keys(categoryColors).map(cat => (
            <span class={`px-4 py-2 rounded-full text-sm font-semibold cursor-default ${categoryColors[cat]}`}>{cat}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ======= BOTTOM CTA ======= -->
  <section class="bg-[var(--color-navy)] py-16 md:py-20">
    <div class="container mx-auto px-4 text-center">
      <h2 class="font-display font-800 text-3xl md:text-4xl text-white mb-4">
        Ready to Schedule Service?
      </h2>
      <p class="text-blue-200 text-lg max-w-xl mx-auto mb-8">
        Reading about HVAC is helpful. Having D&H handle it is better. Same-day appointments available — call or book online now.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/contact"
          class="inline-block bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold text-lg px-10 py-4 rounded-xl transition-colors"
        >
          Schedule Service
        </a>
        <a
          href="tel:5204082665"
          class="inline-block border-2 border-white/30 hover:border-white text-white font-bold text-lg px-10 py-4 rounded-xl transition-colors"
        >
          (520) 408-2665
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
