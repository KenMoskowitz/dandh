---
// Design Option A: "Desert Heritage"
// Warm, earthy, editorial — family-owned & community-rooted feel
// Palette: warm cream, terracotta, rust, amber, sand
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Design Option A: Desert Heritage | D&H";
const description = "Design concept A for DandHac.com";
---

<BaseLayout title={title} description={description}>
<style>
  :root {
    --dh-cream:      #FDFAF5;
    --dh-sand:       #F5ECD7;
    --dh-rust:       #C75C35;
    --dh-rust-dark:  #A8431B;
    --dh-amber:      #D4A056;
    --dh-bark:       #2C1A0E;
    --dh-bark-mid:   #5C3D20;
    --dh-warm-gray:  #7A726A;
    --dh-border:     #E8DCC8;
    --dh-success:    #3A7D44;
  }

  .dh-cream     { background-color: var(--dh-cream); }
  .dh-sand-bg   { background-color: var(--dh-sand); }
  .dh-rust-btn  { background-color: var(--dh-rust); color: white; }
  .dh-rust-btn:hover { background-color: var(--dh-rust-dark); }

  /* Desert texture overlay */
  .desert-texture {
    background-image:
      radial-gradient(ellipse 120% 80% at 60% 0%, rgba(212,160,86,0.18) 0%, transparent 60%),
      radial-gradient(ellipse 60% 50% at 0% 100%, rgba(199,92,53,0.12) 0%, transparent 50%);
  }

  /* Warm grain overlay */
  .grain::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    opacity: 0.4;
  }

  /* Warm divider */
  .warm-rule {
    border: none;
    height: 2px;
    background: linear-gradient(to right, transparent, var(--dh-amber), transparent);
    opacity: 0.5;
    margin: 0 auto;
    max-width: 120px;
  }

  /* Badge pill */
  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--dh-sand);
    border: 1px solid var(--dh-border);
    color: var(--dh-bark-mid);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 99px;
    letter-spacing: 0.04em;
  }

  /* Service row card */
  .svc-card {
    background: white;
    border: 1px solid var(--dh-border);
    border-radius: 16px;
    padding: 28px 24px;
    transition: box-shadow 0.2s, transform 0.2s, border-color 0.2s;
  }
  .svc-card:hover {
    box-shadow: 0 12px 40px rgba(44,26,14,0.10);
    transform: translateY(-3px);
    border-color: var(--dh-amber);
  }
  .svc-icon {
    width: 52px; height: 52px;
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    background: var(--dh-sand);
    color: var(--dh-rust);
    margin-bottom: 14px;
  }
  .svc-card.urgent .svc-icon {
    background: #FEF2ED;
    color: var(--dh-rust-dark);
  }

  /* Stats strip */
  .stat-item {
    text-align: center;
    padding: 24px 16px;
    border-right: 1px solid var(--dh-border);
  }
  .stat-item:last-child { border-right: none; }

  /* Review card */
  .review-card {
    background: white;
    border: 1px solid var(--dh-border);
    border-radius: 16px;
    padding: 28px;
    position: relative;
  }
  .review-card::before {
    content: '"';
    position: absolute;
    top: 16px; left: 24px;
    font-size: 72px;
    line-height: 1;
    color: var(--dh-sand);
    font-family: Georgia, serif;
  }

  /* CTA section */
  .cta-warm {
    background: linear-gradient(135deg, var(--dh-rust) 0%, #A8431B 100%);
  }

  /* Bottom label */
  .design-label {
    position: fixed;
    bottom: 16px;
    left: 16px;
    background: var(--dh-bark);
    color: white;
    font-size: 11px;
    font-weight: 700;
    padding: 6px 12px;
    border-radius: 6px;
    z-index: 9999;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
</style>

<div class="design-label">Option A — Desert Heritage</div>

<!-- ── NAV PREVIEW ──────────────────────────────────────────────── -->
<header style="background:var(--dh-cream); border-bottom:1px solid var(--dh-border); position:sticky; top:0; z-index:100;">
  <div style="max-width:1280px; margin:0 auto; padding:0 24px; height:68px; display:flex; align-items:center; justify-content:space-between;">
    <div style="display:flex; align-items:center; gap:10px;">
      <div style="width:36px; height:36px; background:var(--dh-rust); border-radius:8px; display:flex; align-items:center; justify-content:center; color:white; font-weight:900; font-size:13px; font-family:var(--font-display);">D&H</div>
      <span style="font-family:var(--font-display); font-weight:800; font-size:1rem; color:var(--dh-bark); letter-spacing:-0.02em;">D&amp;H Air Conditioning &amp; Heating</span>
    </div>
    <nav style="display:flex; align-items:center; gap:28px;">
      {['Cooling', 'Heating', 'Plumbing', 'Specials', 'About'].map(n => (
        <span style="font-size:0.875rem; font-weight:600; color:var(--dh-bark-mid); cursor:pointer;">{n}</span>
      ))}
      <a href="tel:5204082665" style="display:inline-flex; align-items:center; gap:6px; background:var(--dh-rust); color:white; font-weight:700; font-size:0.8125rem; padding:9px 18px; border-radius:8px; text-decoration:none;">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        (520) 408-2665
      </a>
    </nav>
  </div>
</header>

<!-- ── HERO ─────────────────────────────────────────────────────── -->
<section style="background:var(--dh-cream); position:relative; overflow:hidden;" class="desert-texture grain">
  <div style="max-width:1280px; margin:0 auto; padding:80px 24px 96px; display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:center;">

    <!-- Left: copy -->
    <div>
      <div class="badge-pill" style="margin-bottom:24px;">
        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="var(--dh-amber)"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        4.8 Stars · 4,000+ Google Reviews
      </div>

      <h1 style="font-family:var(--font-display); font-weight:800; font-size:clamp(2.5rem,4.5vw,4rem); line-height:1.08; color:var(--dh-bark); letter-spacing:-0.03em; margin-bottom:20px;">
        Tucson's Trusted<br/>
        <span style="color:var(--dh-rust);">AC &amp; Heating</span><br/>
        Neighbors Since 1959
      </h1>

      <hr class="warm-rule" style="margin:0 0 24px 0; max-width:80px;">

      <p style="color:var(--dh-warm-gray); font-size:1.125rem; line-height:1.7; margin-bottom:32px; max-width:460px;">
        Three generations of family service. NATE-certified technicians.
        Same-day scheduling. 24/7 emergency response.
        We've been your Tucson neighbors for over 65 years.
      </p>

      <div style="display:flex; gap:12px; margin-bottom:32px; flex-wrap:wrap;">
        <a href="/contact" style="display:inline-flex; align-items:center; gap:8px; background:var(--dh-rust); color:white; font-weight:700; font-size:0.9375rem; padding:14px 28px; border-radius:10px; text-decoration:none; box-shadow:0 4px 20px rgba(199,92,53,0.35);">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          Schedule Service
        </a>
        <a href="tel:5204082665" style="display:inline-flex; align-items:center; gap:8px; background:white; color:var(--dh-bark); border:2px solid var(--dh-border); font-weight:700; font-size:0.9375rem; padding:14px 28px; border-radius:10px; text-decoration:none;">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.42 2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call (520) 408-2665
        </a>
      </div>

      <!-- Mini trust bar -->
      <div style="display:flex; gap:20px; flex-wrap:wrap;">
        {['NATE Certified', 'BBB A+', 'Family-Owned', 'Same-Day Service'].map(b => (
          <span style="display:flex; align-items:center; gap:6px; font-size:0.8125rem; color:var(--dh-warm-gray); font-weight:600;">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="var(--dh-success)"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01" stroke="white" stroke-width="2" fill="none"/></svg>
            {b}
          </span>
        ))}
      </div>
    </div>

    <!-- Right: photo + warm card -->
    <div style="display:flex; flex-direction:column; gap:20px;">
      <!-- Photo frame -->
      <div style="border-radius:20px; overflow:hidden; position:relative; aspect-ratio:4/3; box-shadow:0 24px 64px rgba(44,26,14,0.18), 0 0 0 6px var(--dh-sand), 0 0 0 7px var(--dh-border);">
        <img
          src="https://images.unsplash.com/photo-1621905251189-08b45d6a269e?auto=format&fit=crop&w=700&q=80"
          alt="D&H technician"
          style="width:100%; height:100%; object-fit:cover;"
        />
        <!-- Warm overlay at bottom -->
        <div style="position:absolute; inset:0; background:linear-gradient(to top, rgba(44,26,14,0.65) 0%, transparent 50%);"></div>
        <div style="position:absolute; bottom:20px; left:20px; right:20px; display:flex; align-items:center; justify-content:space-between;">
          <div style="color:white;">
            <div style="display:flex; gap:2px; margin-bottom:3px;">
              {Array(5).fill(null).map(() => <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="#D4A056"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>)}
            </div>
            <p style="font-size:0.8125rem; font-weight:600;">NATE-Certified · Since 1959</p>
          </div>
          <div style="display:flex; align-items:center; gap:6px; background:var(--dh-success); color:white; font-size:0.75rem; font-weight:700; padding:7px 12px; border-radius:99px;">
            <span style="width:6px; height:6px; background:white; border-radius:50%;"></span>
            Available Now
          </div>
        </div>
      </div>

      <!-- Warm family card -->
      <div style="background:var(--dh-sand); border:1px solid var(--dh-border); border-radius:16px; padding:24px 28px; display:flex; gap:16px; align-items:flex-start;">
        <div style="width:48px; height:48px; background:var(--dh-rust); border-radius:12px; flex-shrink:0; display:flex; align-items:center; justify-content:center; color:white;">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </div>
        <div>
          <p style="font-family:var(--font-display); font-weight:700; font-size:0.9375rem; color:var(--dh-bark); margin-bottom:4px;">Family-owned for 65+ years</p>
          <p style="font-size:0.8125rem; color:var(--dh-warm-gray); line-height:1.55;">Arthur's grandson Brett Wright leads the team today — still fixing Tucson's AC like family.</p>
          <a href="/about" style="font-size:0.8125rem; font-weight:700; color:var(--dh-rust); text-decoration:none; display:inline-flex; align-items:center; gap:4px; margin-top:8px;">
            Our story →
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- ── TRUST STRIP ───────────────────────────────────────────────── -->
<div style="background:white; border-top:1px solid var(--dh-border); border-bottom:1px solid var(--dh-border);">
  <div style="max-width:1280px; margin:0 auto; display:grid; grid-template-columns:repeat(4,1fr);">
    {[
      { icon: '★', label: '4.8 Stars', sub: '4,000+ Google Reviews' },
      { icon: '✓', label: 'NATE Certified', sub: 'All technicians' },
      { icon: '⏱', label: 'Same-Day', sub: 'Service scheduling' },
      { icon: '🛡', label: 'BBB A+ Rated', sub: 'Accredited business' },
    ].map(s => (
      <div class="stat-item">
        <p style="font-family:var(--font-display); font-weight:800; font-size:1.5rem; color:var(--dh-rust); margin-bottom:2px;">{s.icon} {s.label}</p>
        <p style="font-size:0.8125rem; color:var(--dh-warm-gray);">{s.sub}</p>
      </div>
    ))}
  </div>
</div>

<!-- ── SERVICES ──────────────────────────────────────────────────── -->
<section style="background:var(--dh-cream); padding:80px 24px;">
  <div style="max-width:1280px; margin:0 auto;">
    <div style="text-align:center; margin-bottom:56px;">
      <p style="font-size:0.75rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--dh-rust); margin-bottom:10px;">Full-Service HVAC &amp; Plumbing</p>
      <h2 style="font-family:var(--font-display); font-weight:800; font-size:clamp(2rem,3.5vw,3rem); color:var(--dh-bark); letter-spacing:-0.025em; margin-bottom:14px;">What do you need today?</h2>
      <p style="color:var(--dh-warm-gray); font-size:1.0625rem; max-width:480px; margin:0 auto;">Whatever's broken — or whatever you want to prevent — we've got you covered.</p>
    </div>

    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:20px;">
      {[
        { title: 'AC Repair', desc: 'Fast diagnosis and same-day repair on all makes and models. NATE-certified techs on every call.', href: '/air-conditioning-repair', urgent: false },
        { title: 'Emergency AC', desc: 'Trucks on the road 24/7. We answer every call — nights, weekends, holidays.', href: '/emergency-ac-repair', urgent: true, tag: '24/7' },
        { title: 'AC Installation', desc: 'Right-sized systems, expert installation, 0% financing available. Permits to startup.', href: '/ac-installation', urgent: false },
        { title: 'Heating & Furnace', desc: 'Gas furnace repair, heat pump service, and complete heating system installation.', href: '/heating', urgent: false },
        { title: 'Plumbing', desc: 'The same D&H trust for your pipes. Water heaters, leaks, drains, and more.', href: '/plumbing', urgent: false },
        { title: 'Family Plan', desc: 'Two tune-ups/year, priority dispatch, 10% off repairs, no emergency surcharges.', href: '/family-maintenance-plan', urgent: false, tag: 'Best Value' },
      ].map(s => (
        <a href={s.href} class="svc-card" class:list={[s.urgent && 'urgent']} style={`display:block; text-decoration:none; background:white; border:1px solid var(--dh-border); border-radius:16px; padding:28px 24px; transition:box-shadow 0.2s, transform 0.2s, border-color 0.2s; position:relative;${s.urgent ? ' border-top:3px solid var(--dh-rust);' : ''}`}>
          {s.tag && (
            <span style={`position:absolute; top:16px; right:16px; font-size:0.6875rem; font-weight:700; letter-spacing:0.05em; text-transform:uppercase; padding:3px 9px; border-radius:99px; background:${s.urgent ? 'var(--dh-rust)' : 'var(--dh-amber)'}; color:white;`}>{s.tag}</span>
          )}
          <div style={`width:48px; height:48px; border-radius:12px; display:flex; align-items:center; justify-content:center; margin-bottom:14px; background:${s.urgent ? '#FEF2ED' : 'var(--dh-sand)'}; color:var(--dh-rust);`}>
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
          </div>
          <p style="font-family:var(--font-display); font-weight:700; font-size:1.0625rem; color:var(--dh-bark); margin-bottom:8px;">{s.title}</p>
          <p style="font-size:0.875rem; color:var(--dh-warm-gray); line-height:1.6; margin-bottom:16px;">{s.desc}</p>
          <span style="font-size:0.8125rem; font-weight:700; color:var(--dh-rust); display:inline-flex; align-items:center; gap:4px;">
            Learn more →
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ── HERITAGE STORY ─────────────────────────────────────────────── -->
<section style="background:var(--dh-bark); padding:80px 24px; position:relative; overflow:hidden;">
  <!-- Decorative year watermark -->
  <div style="position:absolute; right:-20px; top:50%; transform:translateY(-50%); font-family:var(--font-display); font-weight:900; font-size:clamp(200px,22vw,360px); color:rgba(255,255,255,0.04); line-height:1; user-select:none; pointer-events:none;">1959</div>

  <div style="max-width:1280px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:center; position:relative;">
    <!-- Left: Stats -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:2px;">
      {[
        { n: '65+', l: 'Years in Tucson', s: 'Three generations' },
        { n: '4.8★', l: 'Google Rating', s: '4,000+ reviews' },
        { n: 'NATE', l: 'Certified Techs', s: 'Gold standard' },
        { n: '24/7', l: 'Emergency Service', s: '365 days a year' },
      ].map(s => (
        <div style="background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.08); border-radius:12px; padding:24px; text-align:center;">
          <p style="font-family:var(--font-display); font-weight:800; font-size:2rem; color:var(--dh-amber); margin-bottom:4px;">{s.n}</p>
          <p style="font-weight:600; font-size:0.875rem; color:rgba(255,255,255,0.85); margin-bottom:2px;">{s.l}</p>
          <p style="font-size:0.75rem; color:rgba(255,255,255,0.4);">{s.s}</p>
        </div>
      ))}
    </div>

    <!-- Right: Story -->
    <div>
      <p style="font-size:0.75rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--dh-amber); margin-bottom:14px;">Our Heritage</p>
      <h2 style="font-family:var(--font-display); font-weight:800; font-size:2.25rem; color:white; letter-spacing:-0.025em; line-height:1.2; margin-bottom:20px;">The Family Behind<br/>the Brand</h2>
      <p style="color:rgba(255,255,255,0.65); font-size:1.0625rem; line-height:1.75; margin-bottom:24px;">
        D&H was founded in January 1959 by <strong style="color:white;">Arthur Duhamel</strong> and <strong style="color:white;">Harry Hawk</strong> —
        the first letters of their last names became the company's identity. Today, Arthur's grandson
        <strong style="color:white;">Brett Wright</strong> leads the team, carrying forward 65 years of family commitment
        to every home in Tucson.
      </p>
      <p style="color:rgba(255,255,255,0.45); font-size:0.9375rem; line-height:1.7; margin-bottom:28px;">
        We're not a franchise. We're your neighbors.
      </p>
      <a href="/about" style="display:inline-flex; align-items:center; gap:8px; color:var(--dh-amber); font-weight:700; text-decoration:none; font-size:0.9375rem;">
        Read our full story →
      </a>
    </div>
  </div>
</section>

<!-- ── REVIEWS ───────────────────────────────────────────────────── -->
<section style="background:var(--dh-sand); padding:80px 24px;">
  <div style="max-width:1280px; margin:0 auto;">
    <div style="text-align:center; margin-bottom:48px;">
      <p style="font-size:0.75rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--dh-rust); margin-bottom:10px;">Social Proof</p>
      <h2 style="font-family:var(--font-display); font-weight:800; font-size:2.5rem; color:var(--dh-bark); letter-spacing:-0.025em; margin-bottom:12px;">What Tucson says about us</h2>
      <div style="display:flex; align-items:center; justify-content:center; gap:6px;">
        <div style="display:flex; gap:2px;">
          {Array(5).fill(null).map(() => <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="var(--dh-amber)"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>)}
        </div>
        <strong style="color:var(--dh-bark);">4.8</strong>
        <span style="color:var(--dh-warm-gray); font-size:0.875rem;">· 4,000+ reviews on Google</span>
      </div>
    </div>

    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:20px;">
      {[
        { name: 'Sandra Martinez', loc: 'Tucson', initials: 'SM', quote: "My AC died at 9pm on a Friday. D&H had a tech at my door by midnight. Fixed by 1am. These guys are the real deal — I tell everyone I know about them." },
        { name: 'Robert Thompson', loc: 'Oro Valley', initials: 'RT', quote: "15 years with D&H. They've earned every bit of trust. Honest pricing, great technicians, always on time. Never once tried to upsell me something I didn't need." },
