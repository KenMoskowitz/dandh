---
---

<div
  x-data="{
    units: 1,
    bill: 200,
    get annualSavings() {
      const repairSavings = this.units * 80; // 10% repair discount avg
      const energySavings = this.bill * 0.12 * 12; // ~12% energy reduction from maintenance
      const emergencyAvoidance = this.units * 150; // avg emergency call avoided
      return Math.round(repairSavings + energySavings + emergencyAvoidance);
    },
    get planCost() {
      return this.units * 199;
    },
    get netSavings() {
      return this.annualSavings - this.planCost;
    }
  }"
  class="bg-white rounded-2xl border border-[var(--color-border)] p-6 md:p-8 shadow-sm"
>
  <h3 class="font-display font-700 text-xl text-[var(--color-charcoal)] mb-2">Calculate Your Savings</h3>
  <p class="text-[var(--color-muted)] text-sm mb-6">See how much the Family Maintenance Plan saves you each year.</p>

  <div class="space-y-6">
    <!-- AC Units -->
    <div>
      <label class="block text-sm font-semibold text-[var(--color-charcoal)] mb-2">
        How many AC units do you have?
      </label>
      <div class="flex items-center gap-4">
        <button
          @click="units = Math.max(1, units - 1)"
          class="w-10 h-10 rounded-lg border border-[var(--color-border)] flex items-center justify-center text-[var(--color-charcoal)] hover:bg-[var(--color-cloud)] transition-colors font-bold"
        >−</button>
        <span class="text-2xl font-display font-700 text-[var(--color-navy)] w-8 text-center" x-text="units"></span>
        <button
          @click="units = Math.min(5, units + 1)"
          class="w-10 h-10 rounded-lg border border-[var(--color-border)] flex items-center justify-center text-[var(--color-charcoal)] hover:bg-[var(--color-cloud)] transition-colors font-bold"
        >+</button>
        <span class="text-sm text-[var(--color-muted)]">unit<span x-show="units > 1">s</span></span>
      </div>
    </div>

    <!-- Monthly Bill -->
    <div>
      <label class="block text-sm font-semibold text-[var(--color-charcoal)] mb-2">
        Approximate monthly energy bill: <span class="text-[var(--color-navy)]">$<span x-text="bill"></span></span>
      </label>
      <input
        type="range"
        x-model="bill"
        min="100"
        max="600"
        step="25"
        class="w-full accent-[#1A3F6F] h-2 rounded-full cursor-pointer"
      />
      <div class="flex justify-between text-xs text-[var(--color-muted)] mt-1">
        <span>$100</span>
        <span>$600</span>
      </div>
    </div>

    <!-- Results -->
    <div class="bg-[var(--color-cloud)] rounded-xl p-5 space-y-3">
      <div class="flex justify-between items-center text-sm">
        <span class="text-[var(--color-muted)]">Plan cost per year</span>
        <span class="font-semibold text-[var(--color-charcoal)]">$<span x-text="planCost"></span></span>
      </div>
      <div class="flex justify-between items-center text-sm">
        <span class="text-[var(--color-muted)]">Estimated annual savings</span>
        <span class="font-semibold text-[var(--color-success)]">$<span x-text="annualSavings"></span></span>
      </div>
      <div class="border-t border-[var(--color-border)] pt-3 flex justify-between items-center">
        <span class="font-display font-700 text-[var(--color-charcoal)]">Net savings</span>
        <span class="font-display font-700 text-2xl text-[var(--color-navy)]">$<span x-text="netSavings"></span></span>
      </div>
    </div>

    <a
      href="/contact"
      class="block w-full text-center bg-[var(--color-orange)] hover:bg-[var(--color-orange-dark)] text-white font-bold py-3.5 rounded-xl transition-colors"
    >
      Join the Family Plan — $<span x-text="planCost"></span>/year
    </a>
  </div>
</div>
